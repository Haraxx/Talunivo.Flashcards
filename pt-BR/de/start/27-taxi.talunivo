      "expression": "trânsito",
      "translation": "Verkehr",
      "isVocabulary": true,
      "example": "O trânsito está lento.",
      "exampleTranslation": "Der Verkehr stockt.",
      "explanation": "O trânsito; der Akut gehört zur Schreibweise."
