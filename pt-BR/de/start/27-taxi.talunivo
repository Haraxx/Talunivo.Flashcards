      "topic": "Mit dem Taxi unterwegs",
      "expression": "hotel",
      "translation": "Hotel",
      "isVocabulary": true,
      "example": "Quero ir para o hotel.",
      "exampleTranslation": "Ich möchte zum Hotel fahren.",
      "explanation": "O hotel; para o hotel = zum Hotel."
    },
    {
