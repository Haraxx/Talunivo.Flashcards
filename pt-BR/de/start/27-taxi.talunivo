{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-27-taxi",
  "packageVersion": 4,
  "title": "27 · Mit dem Taxi unterwegs",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "endereço",
      "translation": "Adresse",
      "isVocabulary": true,
      "example": "Tenho o endereço aqui.",
      "exampleTranslation": "Ich habe die Adresse hier.",
      "explanation": "O endereço, Plural endereços, ist eine Adresse. Tenho … aqui heißt ich habe … hier. Der Buchstabe ç wird wie ein stimmloses s gesprochen. Im Übungssatz muss keine echte persönliche Adresse genannt werden."
    },
    {
      "id": "karte-02",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "hotel",
      "translation": "Hotel",
      "isVocabulary": true,
      "example": "Quero ir para o hotel.",
      "exampleTranslation": "Ich möchte zum Hotel fahren.",
      "explanation": "O hotel, Plural hotéis. Para o hotel bedeutet zum Hotel; quero ir heißt ich möchte gehen oder fahren. Im Taxikontext passt auf Deutsch fahren. Der Satz nennt noch kein bestimmtes Hotel."
    },
    {
      "id": "karte-03",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "corrida",
      "translation": "Fahrt (Taxi)",
      "isVocabulary": true,
      "example": "Quanto fica a corrida?",
      "exampleTranslation": "Wie viel kostet die Fahrt?",
      "explanation": "A corrida bezeichnet hier eine Taxifahrt. Quanto fica …? fragt nach dem entstehenden Preis; quanto custa …? kann ebenfalls nach einem Preis fragen. Außerhalb des Taxikontexts kann corrida Lauf oder Rennen bedeuten."
    },
    {
      "id": "karte-04",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "parar",
      "translation": "anhalten",
      "isVocabulary": true,
      "example": "Pode parar aqui, por favor?",
      "exampleTranslation": "Können Sie bitte hier anhalten?",
      "explanation": "Parar bedeutet hier anhalten. Pode parar aqui, por favor? ist im Taxigespräch eine höfliche Bitte um einen Halt; aqui heißt hier. Ohne Kontext kann pode auch eine Möglichkeit oder Erlaubnis ausdrücken."
    },
    {
      "id": "karte-05",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "descer",
      "translation": "aussteigen",
      "isVocabulary": true,
      "example": "Vou descer aqui.",
      "exampleTranslation": "Ich steige hier aus.",
      "explanation": "Descer bedeutet bei einem Verkehrsmittel hier aussteigen. Vou descer drückt den beabsichtigten nächsten Schritt aus. In anderen Situationen kann descer hinuntergehen bedeuten; hier geht es um die Fahrt."
    },
    {
      "id": "karte-06",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "trânsito",
      "translation": "Verkehr",
      "isVocabulary": true,
      "example": "O trânsito está lento.",
      "exampleTranslation": "Der Verkehr fließt langsam.",
      "explanation": "O trânsito bezeichnet hier den Straßenverkehr. Das â in trânsito trägt einen Zirkumflex, keinen Akut. Está lento heißt hier fließt langsam; ein zeitweiser Stillstand oder stockender Verkehr wird damit nicht ausdrücklich behauptet."
    },
    {
      "id": "karte-07",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "entrada",
      "translation": "Eingang",
      "isVocabulary": true,
      "example": "Estou esperando na entrada.",
      "exampleTranslation": "Ich warte am Eingang.",
      "explanation": "A entrada, Plural entradas, ist hier ein Eingang. Na entrada bedeutet am Eingang; estou esperando heißt ich warte gerade. Entrada kann in anderen Zusammenhängen etwa Eintritt oder Vorspeise bedeuten; hier ist ein Ort gemeint."
    },
    {
      "id": "karte-08",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "carro",
      "translation": "Auto",
      "isVocabulary": true,
      "example": "Este é o carro certo?",
      "exampleTranslation": "Ist das das richtige Auto?",
      "explanation": "O carro, Plural carros, ist ein Auto. Certo bedeutet hier richtig beziehungsweise das gesuchte. Este é …? greift das bekannte Vorstellungs- und Zeigemuster auf; die Frage identifiziert im Beispiel ein Fahrzeug."
    }
  ]
}
