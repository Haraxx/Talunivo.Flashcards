      "example": "Pode parar aqui.",
      "exampleTranslation": "Sie können hier anhalten.",
      "explanation": "Pode parar ist hier eine höfliche Aufforderung anzuhalten."
    },
    {
      "id": "karte-05",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "descer",
      "translation": "aussteigen",
      "isVocabulary": true,
      "example": "Vou descer aqui.",
      "exampleTranslation": "Ich steige hier aus.",
      "explanation": "Bei Verkehrsmitteln: descer = aussteigen."
    },
    {
