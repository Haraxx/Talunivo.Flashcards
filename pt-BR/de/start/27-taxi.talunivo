  "title": "27 \u00B7 Mit dem Taxi unterwegs",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "endere\u00E7o",
      "translation": "Adresse",
      "example": "Tenho o endere\u00E7o aqui.",
      "exampleTranslation": "Ich habe die Adresse hier.",
      "explanation": "O endere\u00E7o, Plural endere\u00E7os, ist eine Adresse. Tenho \u2026 aqui hei\u00DFt ich habe \u2026 hier. Der Buchstabe \u00E7 wird wie ein stimmloses s gesprochen. Im \u00DCbungssatz muss keine echte pers\u00F6nliche Adresse genannt werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "hotel",
      "translation": "Hotel",
      "example": "Quero ir para o hotel.",
      "exampleTranslation": "Ich m\u00F6chte zum Hotel fahren.",
      "explanation": "O hotel, Plural hot\u00E9is. Para o hotel bedeutet zum Hotel; quero ir hei\u00DFt ich m\u00F6chte gehen oder fahren. Im Taxikontext passt auf Deutsch fahren. Der Satz nennt noch kein bestimmtes Hotel.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "corrida",
      "translation": "Fahrt (Taxi)",
      "example": "Quanto fica a corrida?",
      "exampleTranslation": "Wie viel kostet die Fahrt?",
      "explanation": "A corrida bezeichnet hier eine Taxifahrt. Quanto fica \u2026? fragt nach dem entstehenden Preis; quanto custa \u2026? kann ebenfalls nach einem Preis fragen. Au\u00DFerhalb des Taxikontexts kann corrida Lauf oder Rennen bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "parar",
      "translation": "anhalten",
      "example": "Pode parar aqui, por favor?",
      "exampleTranslation": "K\u00F6nnen Sie bitte hier anhalten?",
      "explanation": "Parar bedeutet hier anhalten. Pode parar aqui, por favor? ist im Taxigespr\u00E4ch eine h\u00F6fliche Bitte um einen Halt; aqui hei\u00DFt hier. Ohne Kontext kann pode auch eine M\u00F6glichkeit oder Erlaubnis ausdr\u00FCcken.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "descer",
      "translation": "aussteigen",
      "example": "Vou descer aqui.",
      "exampleTranslation": "Ich steige hier aus.",
      "explanation": "Descer bedeutet bei einem Verkehrsmittel hier aussteigen. Vou descer dr\u00FCckt den beabsichtigten n\u00E4chsten Schritt aus. In anderen Situationen kann descer hinuntergehen bedeuten; hier geht es um die Fahrt.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "tr\u00E2nsito",
      "translation": "Verkehr",
      "example": "O tr\u00E2nsito est\u00E1 lento.",
      "exampleTranslation": "Der Verkehr flie\u00DFt langsam.",
      "explanation": "O tr\u00E2nsito bezeichnet hier den Stra\u00DFenverkehr. Das \u00E2 in tr\u00E2nsito tr\u00E4gt einen Zirkumflex, keinen Akut. Est\u00E1 lento hei\u00DFt hier flie\u00DFt langsam; ein zeitweiser Stillstand oder stockender Verkehr wird damit nicht ausdr\u00FCcklich behauptet.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "entrada",
      "translation": "Eingang",
      "example": "Estou esperando na entrada.",
      "exampleTranslation": "Ich warte am Eingang.",
      "explanation": "A entrada, Plural entradas, ist hier ein Eingang. Na entrada bedeutet am Eingang; estou esperando hei\u00DFt ich warte gerade. Entrada kann in anderen Zusammenh\u00E4ngen etwa Eintritt oder Vorspeise bedeuten; hier ist ein Ort gemeint.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Mit dem Taxi unterwegs",
      "expression": "carro",
      "translation": "Auto",
      "example": "Este \u00E9 o carro certo?",
      "exampleTranslation": "Ist das das richtige Auto?",
      "explanation": "O carro, Plural carros, ist ein Auto. Certo bedeutet hier richtig beziehungsweise das gesuchte. Este \u00E9 \u2026? greift das bekannte Vorstellungs- und Zeigemuster auf; die Frage identifiziert im Beispiel ein Fahrzeug.",
      "isVocabulary": true
    }
  ],
