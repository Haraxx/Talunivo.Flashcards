  "cards": [
    {
      "id": "karte-01",
      "topic": "Obst und Gem\u00FCse",
      "expression": "laranjas",
      "translation": "Orangen",
      "example": "Quero duas laranjas.",
      "exampleTranslation": "Ich m\u00F6chte zwei Orangen.",
      "explanation": "A laranja ist eine Orange; laranjas ist die Mehrzahl. Duas richtet sich nach dem weiblichen portugiesischen Nomen. Quero duas laranjas nennt hier genau zwei Orangen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Obst und Gem\u00FCse",
      "expression": "abacaxi",
      "translation": "Ananas",
      "example": "O abacaxi est\u00E1 maduro.",
      "exampleTranslation": "Die Ananas ist reif.",
      "explanation": "O abacaxi, Plural abacaxis, ist in Brasilien die \u00FCbliche Bezeichnung f\u00FCr Ananas. Maduro bedeutet hier reif und ist m\u00E4nnlich wegen abacaxi, obwohl Ananas im Deutschen weiblich ist.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Obst und Gem\u00FCse",
      "expression": "manga",
      "translation": "Mango",
      "example": "Gosto de manga.",
      "exampleTranslation": "Ich mag Mango.",
      "explanation": "A manga, Plural mangas, ist hier die Frucht Mango. Gosto de \u2026 bedeutet ich mag \u2026 In einem Kleidungskontext kann manga dagegen \u00C4rmel bedeuten; hier wird eine Vorliebe f\u00FCr Obst ausgedr\u00FCckt.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Obst und Gem\u00FCse",
      "expression": "tomates",
      "translation": "Tomaten",
      "example": "Estes tomates est\u00E3o bonitos.",
      "exampleTranslation": "Diese Tomaten sehen sch\u00F6n aus.",
      "explanation": "O tomate ist eine Tomate; tomates ist die Mehrzahl. Estes und bonitos sind m\u00E4nnliche Mehrzahlformen wegen tomates. Die Beschreibung betrifft hier das Aussehen, nicht automatisch Geschmack oder Qualit\u00E4t.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Obst und Gem\u00FCse",
      "expression": "batatas",
      "translation": "Kartoffeln",
      "example": "Preciso de batatas.",
      "exampleTranslation": "Ich brauche Kartoffeln.",
      "explanation": "A batata ist eine Kartoffel; batatas ist die Mehrzahl. Preciso de \u2026 hei\u00DFt ich brauche \u2026 Der Satz nennt Kartoffeln allgemein, aber noch keine bestimmte Anzahl oder Gewichtsmenge.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Obst und Gem\u00FCse",
      "expression": "cebola",
      "translation": "Zwiebel",
      "example": "Preciso de uma cebola.",
      "exampleTranslation": "Ich brauche eine Zwiebel.",
      "explanation": "A cebola, Plural cebolas. Uma cebola bezeichnet eine einzelne Zwiebel. Ohne Mengenwort kann cebola in einem Lebensmittelzusammenhang auch Zwiebeln allgemein meinen; hier legt uma die Einzelmenge fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-06-2",
      "topic": "Obst und Gem\u00FCse",
      "expression": "alho",
      "translation": "Knoblauch",
      "example": "Tem alho?",
      "exampleTranslation": "Gibt es Knoblauch?",
      "explanation": "O alho ist Knoblauch. Tem alho? fragt im Einkaufskontext nach der Verf\u00FCgbarkeit. Das Wort bezeichnet hier das Lebensmittel; eine bestimmte Anzahl an Knollen oder Zehen wird nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Obst und Gem\u00FCse",
      "expression": "alface",
      "translation": "Kopfsalat",
      "example": "Quero uma alface pequena.",
      "exampleTranslation": "Ich m\u00F6chte einen kleinen Kopfsalat.",
      "explanation": "A alface ist grammatisch weiblich; deshalb uma und pequena. Gemeint ist hier ein Kopfsalat als Pflanze. Salada aus Paket 19 bezeichnet dagegen einen Salat als Gericht.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Obst und Gem\u00FCse",
      "expression": "cenouras",
      "translation": "Karotten",
      "example": "Vou levar estas cenouras.",
      "exampleTranslation": "Ich nehme diese Karotten.",
      "explanation": "A cenoura ist eine Karotte; cenouras ist die Mehrzahl. Vou levar \u2026 bedeutet beim Einkaufen hier ich nehme \u2026 Estas passt zur weiblichen Mehrzahl. Die Aussage w\u00E4hlt die gezeigten Karotten aus.",
      "isVocabulary": true
    }
  ],
