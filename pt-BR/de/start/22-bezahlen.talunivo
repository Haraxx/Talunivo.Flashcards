  "title": "22 \u00B7 Geld und Bezahlen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Geld und Bezahlen",
      "expression": "tudo",
      "translation": "alles",
      "example": "Quanto custa tudo?",
      "exampleTranslation": "Wie viel kostet alles zusammen?",
      "explanation": "Tudo bedeutet alles und bezeichnet hier den gesamten Einkauf. Quanto custa tudo? fragt nach dem Gesamtbetrag, nicht nach dem Preis eines einzelnen Artikels. Dasselbe Wort steht in Tudo bem? in einem anderen Gespr\u00E4chsmuster.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Geld und Bezahlen",
      "expression": "dinheiro",
      "translation": "Bargeld; Geld",
      "example": "Posso pagar em dinheiro?",
      "exampleTranslation": "Kann ich bar bezahlen?",
      "explanation": "O dinheiro bedeutet Geld; bei einer Zahlungsart ist em dinheiro bar oder mit Bargeld. Posso pagar \u2026? fragt nach der M\u00F6glichkeit zu bezahlen. Die Frage selbst sagt noch nicht, ob diese Zahlungsart angenommen wird.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Geld und Bezahlen",
      "expression": "cart\u00E3o de d\u00E9bito",
      "translation": "Debitkarte",
      "example": "Aceita cart\u00E3o de d\u00E9bito?",
      "exampleTranslation": "Akzeptieren Sie eine Debitkarte?",
      "explanation": "O cart\u00E3o de d\u00E9bito ist eine Debitkarte; der Akut geh\u00F6rt zu d\u00E9bito. Aceita \u2026? fragt hier h\u00F6flich, ob die Zahlungsart angenommen wird. Eine Kreditkarte w\u00E4re cart\u00E3o de cr\u00E9dito und ist nicht dieselbe Bezeichnung.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Geld und Bezahlen",
      "expression": "Pix",
      "translation": "Pix (brasilianisches Bezahlsystem)",
      "example": "Vou pagar com Pix.",
      "exampleTranslation": "Ich werde mit Pix bezahlen.",
      "explanation": "Pix ist der Name eines brasilianischen Systems f\u00FCr sofortige Zahlungen. Vou pagar bedeutet ich werde bezahlen; com Pix benennt hier die Zahlungsart. Der Satz ist ein Sprachbeispiel und keine Angabe dar\u00FCber, welche Zahlungsarten dir vor Ort zur Verf\u00FCgung stehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Geld und Bezahlen",
      "expression": "troco",
      "translation": "Wechselgeld",
      "example": "Preciso de troco.",
      "exampleTranslation": "Ich brauche Wechselgeld.",
      "explanation": "O troco ist Wechselgeld. Preciso de \u2026 hei\u00DFt ich brauche \u2026 Der Satz nennt einen Bedarf, aber noch nicht den gezahlten Betrag oder die H\u00F6he des zur\u00FCckzugebenden Geldes.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Geld und Bezahlen",
      "expression": "reais",
      "translation": "Reais (Mehrzahl von Real)",
      "example": "Aqui est\u00E3o cinquenta reais.",
      "exampleTranslation": "Hier sind f\u00FCnfzig Reais.",
      "explanation": "O real ist die Einzahl der brasilianischen W\u00E4hrung; reais ist die Mehrzahl. Cinquenta reais sind f\u00FCnfzig Reais. Aqui est\u00E3o \u2026 hei\u00DFt hier sind \u2026 und steht passend zur Mehrzahl.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Geld und Bezahlen",
      "expression": "recibo",
      "translation": "Beleg",
      "example": "Pode me dar o recibo?",
      "exampleTranslation": "K\u00F6nnen Sie mir den Beleg geben?",
      "explanation": "O recibo, Plural recibos, bezeichnet hier einen Zahlungsbeleg. Pode me dar \u2026? ist eine h\u00F6fliche Bitte: K\u00F6nnen Sie mir \u2026 geben? Je nach Anrede kann auf Deutsch auch kannst du mir \u2026 passen.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Geld und Bezahlen",
      "expression": "valor",
      "translation": "Betrag",
      "example": "O valor est\u00E1 errado.",
      "exampleTranslation": "Der Betrag stimmt nicht.",
      "explanation": "O valor, Plural valores, ist hier der Betrag. Est\u00E1 errado bedeutet ist falsch oder stimmt nicht. In anderen Zusammenh\u00E4ngen kann valor Wert bedeuten; hier wird der angezeigte oder genannte Geldbetrag beanstandet.",
      "isVocabulary": true
    }
  ],
