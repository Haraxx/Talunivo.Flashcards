  "title": "22 · Geld und Bezahlen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Geld und Bezahlen",
      "expression": "tudo",
      "translation": "alles",
      "example": "Quanto custa tudo?",
      "exampleTranslation": "Wie viel kostet alles zusammen?",
      "explanation": "Tudo bedeutet alles und bezeichnet hier den gesamten Einkauf. Quanto custa tudo? fragt nach dem Gesamtbetrag, nicht nach dem Preis eines einzelnen Artikels. Dasselbe Wort steht in Tudo bem? in einem anderen Gesprächsmuster.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "TU-du",
        "ipa": "[ˈtudu]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-02",
      "topic": "Geld und Bezahlen",
      "expression": "dinheiro",
      "translation": "Bargeld; Geld",
      "example": "Posso pagar em dinheiro?",
      "exampleTranslation": "Kann ich bar bezahlen?",
      "explanation": "O dinheiro bedeutet Geld; bei einer Zahlungsart ist em dinheiro bar oder mit Bargeld. Posso pagar …? fragt nach der Möglichkeit zu bezahlen. Die Frage selbst sagt noch nicht, ob diese Zahlungsart angenommen wird.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Geld und Bezahlen",
      "expression": "cartão de débito",
      "translation": "Debitkarte",
      "example": "Aceita cartão de débito?",
      "exampleTranslation": "Akzeptieren Sie eine Debitkarte?",
      "explanation": "O cartão de débito ist eine Debitkarte; der Akut gehört zu débito. Aceita …? fragt hier höflich, ob die Zahlungsart angenommen wird. Eine Kreditkarte wäre cartão de crédito und ist nicht dieselbe Bezeichnung.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Geld und Bezahlen",
      "expression": "Pix",
      "translation": "Pix (brasilianisches Bezahlsystem)",
      "example": "Vou pagar com Pix.",
      "exampleTranslation": "Ich werde mit Pix bezahlen.",
      "explanation": "Pix ist der Name eines brasilianischen Systems für sofortige Zahlungen. Vou pagar bedeutet ich werde bezahlen; com Pix benennt hier die Zahlungsart. Der Satz ist ein Sprachbeispiel und keine Angabe darüber, welche Zahlungsarten dir vor Ort zur Verfügung stehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Geld und Bezahlen",
      "expression": "troco",
      "translation": "Wechselgeld",
      "example": "Preciso de troco.",
      "exampleTranslation": "Ich brauche Wechselgeld.",
      "explanation": "O troco ist Wechselgeld. Preciso de … heißt ich brauche … Der Satz nennt einen Bedarf, aber noch nicht den gezahlten Betrag oder die Höhe des zurückzugebenden Geldes.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Geld und Bezahlen",
      "expression": "reais",
      "translation": "Reais (Mehrzahl von Real)",
      "example": "Aqui estão cinquenta reais.",
      "exampleTranslation": "Hier sind fünfzig Reais.",
      "explanation": "O real ist die Einzahl der brasilianischen Währung; reais ist die Mehrzahl. Cinquenta reais sind fünfzig Reais. Aqui estão … heißt hier sind … und steht passend zur Mehrzahl.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Geld und Bezahlen",
      "expression": "recibo",
      "translation": "Beleg",
      "example": "Pode me dar o recibo?",
      "exampleTranslation": "Können Sie mir den Beleg geben?",
      "explanation": "O recibo, Plural recibos, bezeichnet hier einen Zahlungsbeleg. Pode me dar …? ist eine höfliche Bitte: Können Sie mir … geben? Je nach Anrede kann auf Deutsch auch kannst du mir … passen.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Geld und Bezahlen",
      "expression": "valor",
      "translation": "Betrag",
      "example": "O valor está errado.",
      "exampleTranslation": "Der Betrag stimmt nicht.",
      "explanation": "O valor, Plural valores, ist hier der Betrag. Está errado bedeutet ist falsch oder stimmt nicht. In anderen Zusammenhängen kann valor Wert bedeuten; hier wird der angezeigte oder genannte Geldbetrag beanstandet.",
      "isVocabulary": true
    }
  ],
