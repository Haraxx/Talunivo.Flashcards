      "id": "karte-01",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "onze",
      "translation": "elf",
      "isVocabulary": true,
      "example": "O suco custa onze reais.",
      "exampleTranslation": "Der Saft kostet elf Reais.",
      "explanation": "Onze steht für 11. Suco heißt Saft; custa onze reais bedeutet kostet elf Reais. Das Muster custa … reais kann mit weiteren Zahlen verwendet werden."
    },
    {
      "id": "karte-01-2",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "doze",
      "translation": "zwölf",
      "isVocabulary": true,
      "example": "A banana custa doze reais o quilo.",
      "exampleTranslation": "Die Bananen kosten zwölf Reais pro Kilo.",
      "explanation": "Doze steht für 12. Doze reais o quilo bedeutet zwölf Reais pro Kilo. A banana bezeichnet hier Bananen als Ware; der Preis bezieht sich auf das Kilo, nicht auf ein einzelnes Stück."
    },
    {
      "id": "karte-01-3",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "treze",
      "translation": "dreizehn",
      "isVocabulary": true,
      "example": "O sanduíche custa treze reais.",
      "exampleTranslation": "Das Sandwich kostet dreizehn Reais.",
      "explanation": "Treze steht für 13. Treze reais bedeutet dreizehn Reais; sanduíche heißt Sandwich. Unterscheide treze = dreizehn von três = drei."
    },
    {
      "id": "karte-02",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "quatorze",
      "translation": "vierzehn",
      "isVocabulary": true,
      "example": "A passagem custa quatorze reais.",
      "exampleTranslation": "Die Fahrkarte kostet vierzehn Reais.",
      "explanation": "Quatorze steht für 14; catorze ist ebenfalls eine korrekte Schreibweise. Passagem bezeichnet hier eine Fahrkarte. Beide Zahlformen benennen denselben Betrag."
    },
