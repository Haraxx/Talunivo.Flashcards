      "id": "karte-01",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "onze",
      "translation": "elf",
      "example": "O suco custa onze reais.",
      "exampleTranslation": "Der Saft kostet elf Reais.",
      "explanation": "Onze steht f\u00FCr 11. Suco hei\u00DFt Saft; custa onze reais bedeutet kostet elf Reais. Das Muster custa \u2026 reais kann mit weiteren Zahlen verwendet werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-01-2",
      "topic": "Zahlen und Preise bis hundert",
      "expression": "doze",
      "translation": "zw\u00F6lf",
      "example": "A banana custa doze reais o quilo.",
      "exampleTranslation": "Die Bananen kosten zw\u00F6lf Reais pro Kilo.",
      "explanation": "Doze steht f\u00FCr 12. Doze reais o quilo bedeutet zw\u00F6lf Reais pro Kilo. A banana bezeichnet hier Bananen als Ware; der Preis bezieht sich auf das Kilo, nicht auf ein einzelnes St\u00FCck.",
      "isVocabulary": true
    },
