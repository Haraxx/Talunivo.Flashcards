  "cards": [
    {
      "id": "karte-01",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "por favor",
      "translation": "bitte",
      "example": "Um caf\u00E9, por favor.",
      "exampleTranslation": "Einen Kaffee, bitte.",
      "explanation": "Por favor erg\u00E4nzt eine Bitte oder Bestellung: um caf\u00E9 = einen Kaffee. Hier bedeutet bitte eine h\u00F6fliche Bitte; als Antwort auf danke verwendet man zum Beispiel de nada.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigado",
      "translation": "danke (m\u00E4nnlicher Sprecher)",
      "example": "Muito obrigado!",
      "exampleTranslation": "Vielen Dank!",
      "explanation": "Obrigado ist die m\u00E4nnliche Standardform des Dankes, obrigada die weibliche. Die Form richtet sich nach der dankenden Person, nicht nach der Person, der gedankt wird. Muito verst\u00E4rkt den Dank: vielen Dank.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigada",
      "translation": "danke (weibliche Sprecherin)",
      "example": "Muito obrigada!",
      "exampleTranslation": "Vielen Dank!",
      "explanation": "Obrigada ist die weibliche Standardform des Dankes, obrigado die m\u00E4nnliche. Entscheidend ist die dankende Person. In muito obrigada bleibt muito unver\u00E4ndert; es verst\u00E4rkt hier den Dank.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "de nada",
      "translation": "gern geschehen",
      "example": "De nada!",
      "exampleTranslation": "Gern geschehen!",
      "explanation": "De nada ist eine Antwort auf einen Dank: gern geschehen oder bitte, gern. Es ist keine Bitte um etwas. F\u00FCr eine Bitte verwendet man por favor.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "com licen\u00E7a",
      "translation": "Entschuldigung (um Erlaubnis bitten)",
      "example": "Com licen\u00E7a, posso passar?",
      "exampleTranslation": "Entschuldigung, darf ich vorbei?",
      "explanation": "Com licen\u00E7a bittet hier h\u00F6flich um Platz, bevor man vorbeigeht. Posso passar? bedeutet darf ich vorbei? Die Wendung wird auch verwendet, bevor man jemanden unterbricht.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "desculpe",
      "translation": "Entschuldigung (um Verzeihung bitten)",
      "example": "Desculpe pelo atraso.",
      "exampleTranslation": "Entschuldige die Versp\u00E4tung.",
      "explanation": "Desculpe bittet um Entschuldigung. Pelo atraso bedeutet f\u00FCr die Versp\u00E4tung. Hier entschuldigt sich jemand f\u00FCr etwas Geschehenes; com licen\u00E7a wird im vorherigen Beispiel vor dem Vorbeigehen verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "problema",
      "translation": "Problem",
      "example": "N\u00E3o tem problema.",
      "exampleTranslation": "Das ist kein Problem.",
      "explanation": "O problema, Plural problemas, ist trotz der Endung -a m\u00E4nnlich. N\u00E3o tem problema ist im brasilianischen Alltag eine \u00FCbliche Reaktion: Das ist kein Problem oder kein Problem.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "repetir",
      "translation": "wiederholen",
      "example": "Pode repetir, por favor?",
      "exampleTranslation": "Kannst du das bitte wiederholen?",
      "explanation": "Repetir bedeutet wiederholen. Pode repetir, por favor? ist eine h\u00F6fliche Bitte, etwas noch einmal zu sagen. Die Wendung l\u00E4sst sich als Ganzes lernen und wird beim Nachfragen erneut gebraucht.",
      "isVocabulary": true
    }
  ],
