  "packageId": "start-ptbr-04-hoeflichkeit",
  "packageVersion": 4,
  "title": "04 · Bitte, danke, Entschuldigung",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "por favor",
      "translation": "bitte",
      "isVocabulary": true,
      "example": "Um café, por favor.",
      "exampleTranslation": "Einen Kaffee, bitte.",
      "explanation": "Por favor ergänzt eine Bitte oder Bestellung: um café = einen Kaffee. Hier bedeutet bitte eine höfliche Bitte; als Antwort auf danke verwendet man zum Beispiel de nada."
    },
    {
      "id": "karte-02",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigado",
      "translation": "danke (männlicher Sprecher)",
      "isVocabulary": true,
      "example": "Muito obrigado!",
      "exampleTranslation": "Vielen Dank!",
      "explanation": "Obrigado ist die männliche Standardform des Dankes, obrigada die weibliche. Die Form richtet sich nach der dankenden Person, nicht nach der Person, der gedankt wird. Muito verstärkt den Dank: vielen Dank."
    },
    {
      "id": "karte-03",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigada",
      "translation": "danke (weibliche Sprecherin)",
      "isVocabulary": true,
      "example": "Muito obrigada!",
      "exampleTranslation": "Vielen Dank!",
      "explanation": "Obrigada ist die weibliche Standardform des Dankes, obrigado die männliche. Entscheidend ist die dankende Person. In muito obrigada bleibt muito unverändert; es verstärkt hier den Dank."
    },
    {
      "id": "karte-04",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "de nada",
      "translation": "gern geschehen",
      "isVocabulary": true,
      "example": "De nada!",
      "exampleTranslation": "Gern geschehen!",
      "explanation": "De nada ist eine Antwort auf einen Dank: gern geschehen oder bitte, gern. Es ist keine Bitte um etwas. Für eine Bitte verwendet man por favor."
    },
    {
      "id": "karte-05",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "com licença",
      "translation": "Entschuldigung (um Erlaubnis bitten)",
      "isVocabulary": true,
      "example": "Com licença, posso passar?",
      "exampleTranslation": "Entschuldigung, darf ich vorbei?",
      "explanation": "Com licença bittet hier höflich um Platz, bevor man vorbeigeht. Posso passar? bedeutet darf ich vorbei? Die Wendung wird auch verwendet, bevor man jemanden unterbricht."
    },
    {
      "id": "karte-06",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "desculpe",
      "translation": "Entschuldigung (um Verzeihung bitten)",
      "isVocabulary": true,
      "example": "Desculpe pelo atraso.",
      "exampleTranslation": "Entschuldige die Verspätung.",
      "explanation": "Desculpe bittet um Entschuldigung. Pelo atraso bedeutet für die Verspätung. Hier entschuldigt sich jemand für etwas Geschehenes; com licença wird im vorherigen Beispiel vor dem Vorbeigehen verwendet."
    },
    {
      "id": "karte-07",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "problema",
      "translation": "Problem",
      "isVocabulary": true,
      "example": "Não tem problema.",
      "exampleTranslation": "Das ist kein Problem.",
      "explanation": "O problema, Plural problemas, ist trotz der Endung -a männlich. Não tem problema ist im brasilianischen Alltag eine übliche Reaktion: Das ist kein Problem oder kein Problem."
    },
    {
      "id": "karte-08",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "repetir",
      "translation": "wiederholen",
      "isVocabulary": true,
      "example": "Pode repetir, por favor?",
      "exampleTranslation": "Kannst du das bitte wiederholen?",
      "explanation": "Repetir bedeutet wiederholen. Pode repetir, por favor? ist eine höfliche Bitte, etwas noch einmal zu sagen. Die Wendung lässt sich als Ganzes lernen und wird beim Nachfragen erneut gebraucht."
    }
  ]
}
