      "id": "karte-01",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "por favor",
      "translation": "bitte",
      "isVocabulary": true,
      "example": "Por favor, entre e sente-se aqui.",
      "exampleTranslation": "Bitte komm herein und setz dich hierhin.",
      "explanation": "Höfliche Bitte, häufig am Satzende."
    },
    {
      "id": "karte-02",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigado",
      "translation": "danke (männlicher Sprecher)",
      "isVocabulary": true,
      "example": "Muito obrigado!",
      "exampleTranslation": "Vielen Dank!",
      "explanation": "Die Form richtet sich nach der dankenden Person."
    },
    {
      "id": "karte-03",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "obrigada",
      "translation": "danke (weibliche Sprecherin)",
      "isVocabulary": true,
      "example": "Muito obrigada pela ajuda.",
      "exampleTranslation": "Vielen Dank für die Hilfe.",
      "explanation": "Die Form richtet sich nach der dankenden Person."
    },
    {
      "id": "karte-04",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "de nada",
      "translation": "gern geschehen",
      "isVocabulary": true,
      "example": "De nada!",
      "exampleTranslation": "Gern geschehen!",
      "explanation": "Antwort auf einen Dank."
    },
    {
      "id": "karte-05",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "com licença",
      "translation": "Entschuldigung (um Erlaubnis bitten)",
      "isVocabulary": true,
      "example": "Com licença, posso passar?",
      "exampleTranslation": "Entschuldigung, darf ich vorbei?",
      "explanation": "Zum Vorbeigehen oder Unterbrechen um Erlaubnis bitten."
    },
    {
      "id": "karte-06",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "desculpe",
      "translation": "Entschuldigung (um Verzeihung bitten)",
      "isVocabulary": true,
      "example": "Desculpe pelo atraso.",
      "exampleTranslation": "Entschuldige die Verspätung.",
      "explanation": "Entschuldigung für einen Fehler oder eine Verspätung."
    },
    {
      "id": "karte-07",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "problema",
      "translation": "Problem",
      "isVocabulary": true,
      "example": "Não tem problema.",
      "exampleTranslation": "Das ist kein Problem.",
      "explanation": "O problema ist trotz der Endung -a männlich."
    },
    {
      "id": "karte-08",
      "topic": "Bitte, danke, Entschuldigung",
      "expression": "repetir",
      "translation": "wiederholen",
      "isVocabulary": true,
      "example": "Pode repetir, por favor?",
      "exampleTranslation": "Kannst du das bitte wiederholen?",
      "explanation": "Pode repetir? ist eine höfliche Bitte um Wiederholung."
    }
  ]
