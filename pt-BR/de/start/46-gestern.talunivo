  "cards": [
    {
      "id": "karte-01",
      "topic": "Von gestern erzählen",
      "expression": "ontem",
      "translation": "gestern",
      "isVocabulary": true,
      "example": "Ontem fui ao mercado e comprei pão.",
      "exampleTranslation": "Gestern bin ich auf den Markt gegangen und habe Brot gekauft.",
      "explanation": "Ontem bezeichnet den Tag vor heute."
    },
    {
      "id": "karte-02",
      "topic": "Von gestern erzählen",
      "expression": "amiga",
      "translation": "Freundin",
      "isVocabulary": true,
      "example": "Tomei café com uma amiga.",
      "exampleTranslation": "Ich habe mit einer Freundin Kaffee getrunken.",
      "explanation": "A amiga; hier eine Freundin, ohne Festlegung auf eine Partnerschaft."
    },
    {
      "id": "karte-03",
      "topic": "Von gestern erzählen",
      "expression": "comprar",
      "translation": "kaufen",
      "isVocabulary": true,
      "example": "Comprei pão e queijo.",
      "exampleTranslation": "Ich habe Brot und Käse gekauft.",
      "explanation": "Comprei ist Vergangenheit: ich habe gekauft."
    },
    {
      "id": "karte-04",
      "topic": "Von gestern erzählen",
      "expression": "minutos",
      "translation": "Minuten",
      "isVocabulary": true,
      "example": "Estudei português por dez minutos.",
      "exampleTranslation": "Ich habe zehn Minuten Portugiesisch gelernt.",
      "explanation": "Plural von o minuto; por dez minutos = zehn Minuten lang."
    },
    {
      "id": "karte-05",
      "topic": "Von gestern erzählen",
      "expression": "passeio",
      "translation": "Ausflug",
      "isVocabulary": true,
      "example": "Gostei muito do passeio.",
      "exampleTranslation": "Der Ausflug hat mir sehr gefallen.",
      "explanation": "O passeio; gostei do passeio = der Ausflug hat mir gefallen."
    },
    {
      "id": "karte-06",
      "topic": "Von gestern erzählen",
      "expression": "tarde",
      "translation": "spät",
      "isVocabulary": true,
      "example": "Cheguei tarde em casa.",
      "exampleTranslation": "Ich bin spät nach Hause gekommen.",
      "explanation": "Tarde bedeutet hier spät; a tarde als Nomen bedeutet der Nachmittag."
    },
    {
      "id": "karte-07",
      "topic": "Von gestern erzählen",
      "expression": "pergunta",
      "translation": "Frage",
      "isVocabulary": true,
      "example": "Não entendi a pergunta.",
      "exampleTranslation": "Ich habe die Frage nicht verstanden.",
      "explanation": "A pergunta; não entendi = ich habe nicht verstanden."
    },
    {
      "id": "karte-08",
      "topic": "Von gestern erzählen",
      "expression": "bom",
      "translation": "gut (männlich)",
      "isVocabulary": true,
      "example": "Foi um dia bom.",
      "exampleTranslation": "Es war ein guter Tag.",
      "explanation": "Männliche Form; weiblich boa."
    }
