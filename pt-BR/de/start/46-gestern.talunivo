  "title": "46 \u00B7 Von gestern erz\u00E4hlen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "ontem",
      "translation": "gestern",
      "example": "Ontem fui ao mercado.",
      "exampleTranslation": "Gestern bin ich auf den Markt gegangen.",
      "explanation": "Ontem hei\u00DFt gestern, also am Tag vor heute. Fui ist hier die Ich-Form von ir in der abgeschlossenen Vergangenheit. Ao verbindet a \u002B o; ao mercado nennt das Ziel. Der Satz allein legt kein Verkehrsmittel fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "amiga",
      "translation": "Freundin",
      "example": "Tomei caf\u00E9 com uma amiga.",
      "exampleTranslation": "Ich habe mit einer Freundin Kaffee getrunken.",
      "explanation": "A amiga, Plural amigas, hei\u00DFt Freundin. Tomei ist hier die Ich-Form von tomar in der Vergangenheit; tomar caf\u00E9 bedeutet Kaffee trinken. Com uma amiga hei\u00DFt mit einer Freundin und legt keine Partnerschaft fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "comprar",
      "translation": "kaufen",
      "example": "Comprei p\u00E3o e queijo.",
      "exampleTranslation": "Ich habe Brot und K\u00E4se gekauft.",
      "explanation": "Comprar hei\u00DFt kaufen; comprei ist die Ich-Form in der abgeschlossenen Vergangenheit. P\u00E3o e queijo bedeutet Brot und K\u00E4se. Dasselbe Verb wird in Paket 45 mit vamos comprar f\u00FCr einen gemeinsamen Plan verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "minutos",
      "translation": "Minuten",
      "example": "Estudei portugu\u00EAs por dez minutos.",
      "exampleTranslation": "Ich habe zehn Minuten Portugiesisch gelernt.",
      "explanation": "O minuto hei\u00DFt Minute, os minutos die Minuten. Por dez minutos nennt eine Dauer von zehn Minuten, keine Uhrzeit. Estudei ist die vergangene Ich-Form von estudar, gezielt lernen oder studieren.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "passeio",
      "translation": "Ausflug",
      "example": "Gostei muito do passeio.",
      "exampleTranslation": "Der Ausflug hat mir sehr gefallen.",
      "explanation": "O passeio, Plural passeios, hei\u00DFt hier Ausflug. Gostei ist die vergangene Ich-Form von gostar; do verbindet de \u002B o. Muito verst\u00E4rkt zu sehr. Passeio kann je nach Kontext auch Spaziergang bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "tarde",
      "translation": "sp\u00E4t",
      "example": "Cheguei tarde em casa.",
      "exampleTranslation": "Ich bin sp\u00E4t nach Hause gekommen.",
      "explanation": "Tarde bedeutet hier sp\u00E4t. A tarde ist dagegen das Nomen Nachmittag; \u00E0 tarde hei\u00DFt am Nachmittag. Cheguei ist die vergangene Ich-Form von chegar, ankommen. Em casa bezieht sich hier auf die Ankunft zu Hause.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "pergunta",
      "translation": "Frage",
      "example": "N\u00E3o entendi a pergunta.",
      "exampleTranslation": "Ich habe die Frage nicht verstanden.",
      "explanation": "A pergunta, Plural perguntas, hei\u00DFt Frage. N\u00E3o entendi ist die verneinte Ich-Form von entender in der Vergangenheit. Anders als Tenho uma pergunta aus Paket 42 geht es hier um das Verst\u00E4ndnis einer bereits gestellten Frage.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Von gestern erz\u00E4hlen",
      "expression": "bom",
      "translation": "gut (m\u00E4nnlich)",
      "example": "Foi um dia bom.",
      "exampleTranslation": "Es war ein guter Tag.",
      "explanation": "Bom ist die m\u00E4nnliche Form von gut, boa die weibliche. O dia ist trotz der Endung -a m\u00E4nnlich; deshalb hei\u00DFt es um dia bom. Foi ist hier die vergangene Form von ser, war. Die Form richtet sich nicht nach der erz\u00E4hlenden Person.",
      "isVocabulary": true
    }
  ],
