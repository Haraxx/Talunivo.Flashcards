  "title": "46 · Von gestern erzählen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Von gestern erzählen",
      "expression": "ontem",
      "translation": "gestern",
      "example": "Ontem fui ao mercado.",
      "exampleTranslation": "Gestern bin ich auf den Markt gegangen.",
      "explanation": "Ontem heißt gestern, also am Tag vor heute. Fui ist hier die Ich-Form von ir in der abgeschlossenen Vergangenheit. Ao verbindet a + o; ao mercado nennt das Ziel. Der Satz allein legt kein Verkehrsmittel fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Von gestern erzählen",
      "expression": "amiga",
      "translation": "Freundin",
      "example": "Tomei café com uma amiga.",
      "exampleTranslation": "Ich habe mit einer Freundin Kaffee getrunken.",
      "explanation": "A amiga, Plural amigas, heißt Freundin. Tomei ist hier die Ich-Form von tomar in der Vergangenheit; tomar café bedeutet Kaffee trinken. Com uma amiga heißt mit einer Freundin und legt keine Partnerschaft fest.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "a-MI-ga",
        "ipa": "[aˈmiɡɐ]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-03",
      "topic": "Von gestern erzählen",
      "expression": "comprar",
      "translation": "kaufen",
      "example": "Comprei pão e queijo.",
      "exampleTranslation": "Ich habe Brot und Käse gekauft.",
      "explanation": "Comprar heißt kaufen; comprei ist die Ich-Form in der abgeschlossenen Vergangenheit. Pão e queijo bedeutet Brot und Käse. Dasselbe Verb wird in Paket 45 mit vamos comprar für einen gemeinsamen Plan verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Von gestern erzählen",
      "expression": "minutos",
      "translation": "Minuten",
      "example": "Estudei português por dez minutos.",
      "exampleTranslation": "Ich habe zehn Minuten Portugiesisch gelernt.",
      "explanation": "O minuto heißt Minute, os minutos die Minuten. Por dez minutos nennt eine Dauer von zehn Minuten, keine Uhrzeit. Estudei ist die vergangene Ich-Form von estudar, gezielt lernen oder studieren.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Von gestern erzählen",
      "expression": "passeio",
      "translation": "Ausflug",
      "example": "Gostei muito do passeio.",
      "exampleTranslation": "Der Ausflug hat mir sehr gefallen.",
      "explanation": "O passeio, Plural passeios, heißt hier Ausflug. Gostei ist die vergangene Ich-Form von gostar; do verbindet de + o. Muito verstärkt zu sehr. Passeio kann je nach Kontext auch Spaziergang bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Von gestern erzählen",
      "expression": "tarde",
      "translation": "spät",
      "example": "Cheguei tarde em casa.",
      "exampleTranslation": "Ich bin spät nach Hause gekommen.",
      "explanation": "Tarde bedeutet hier spät. A tarde ist dagegen das Nomen Nachmittag; à tarde heißt am Nachmittag. Cheguei ist die vergangene Ich-Form von chegar, ankommen. Em casa bezieht sich hier auf die Ankunft zu Hause.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Von gestern erzählen",
      "expression": "pergunta",
      "translation": "Frage",
      "example": "Não entendi a pergunta.",
      "exampleTranslation": "Ich habe die Frage nicht verstanden.",
      "explanation": "A pergunta, Plural perguntas, heißt Frage. Não entendi ist die verneinte Ich-Form von entender in der Vergangenheit. Anders als Tenho uma pergunta aus Paket 42 geht es hier um das Verständnis einer bereits gestellten Frage.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Von gestern erzählen",
      "expression": "bom",
      "translation": "gut (männlich)",
      "example": "Foi um dia bom.",
      "exampleTranslation": "Es war ein guter Tag.",
      "explanation": "Bom ist die männliche Form von gut, boa die weibliche. O dia ist trotz der Endung -a männlich; deshalb heißt es um dia bom. Foi ist hier die vergangene Form von ser, war. Die Form richtet sich nicht nach der erzählenden Person.",
      "isVocabulary": true
    }
  ],
