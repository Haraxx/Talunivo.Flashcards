  "cards": [
    {
      "id": "karte-01",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "fome",
      "translation": "Hunger",
      "example": "Estou com fome.",
      "exampleTranslation": "Ich habe Hunger.",
      "explanation": "A fome bedeutet Hunger. Estou com fome hei\u00DFt ich habe Hunger; im Portugiesischen steht hier estar com \u002B Nomen. Der Satz nennt das Bed\u00FCrfnis, ohne bereits eine Speise zu bestellen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "sede",
      "translation": "Durst",
      "example": "Estou com sede.",
      "exampleTranslation": "Ich habe Durst.",
      "explanation": "A sede bedeutet hier Durst. Estou com sede verwendet dasselbe Muster wie estou com fome. Durst benennt ein Bed\u00FCrfnis; ein bestimmtes Getr\u00E4nk wird erst in einer weiteren Bitte genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "beber",
      "translation": "trinken",
      "example": "Preciso beber \u00E1gua.",
      "exampleTranslation": "Ich muss Wasser trinken.",
      "explanation": "Beber hei\u00DFt trinken. Preciso beber \u00E1gua bedeutet ich muss Wasser trinken: Nach preciso folgt hier der Infinitiv ohne de. Mit einem Nomen hei\u00DFt es dagegen preciso de \u00E1gua, ich brauche Wasser.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "descansar",
      "translation": "sich ausruhen",
      "example": "Quero descansar um pouco.",
      "exampleTranslation": "Ich m\u00F6chte mich ein bisschen ausruhen.",
      "explanation": "Descansar hei\u00DFt sich ausruhen; im portugiesischen Beispiel ist kein Reflexivpronomen n\u00F6tig. Quero \u002B Infinitiv dr\u00FCckt einen Wunsch aus, um pouco bedeutet ein bisschen. Der Satz enth\u00E4lt keine Empfehlung zur Behandlung.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "banheiro",
      "translation": "Toilette; Badezimmer",
      "example": "Preciso ir ao banheiro.",
      "exampleTranslation": "Ich muss auf die Toilette.",
      "explanation": "O banheiro, Plural banheiros, bezeichnet ein Badezimmer oder eine Toilette. Ir ao banheiro bedeutet hier auf die Toilette gehen; ao verbindet a \u002B o. Preciso ir nennt eine n\u00F6tige Handlung.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "sono",
      "translation": "Schl\u00E4frigkeit",
      "example": "Estou com sono.",
      "exampleTranslation": "Ich bin schl\u00E4frig.",
      "explanation": "O sono bedeutet Schlaf oder, im Muster estar com sono, Schl\u00E4frigkeit. Estou com sono hei\u00DFt ich bin schl\u00E4frig oder ich bin m\u00FCde im Sinn von schlafen wollen. Cansado/cansada bezeichnet dagegen eher M\u00FCdigkeit oder Ersch\u00F6pfung.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "ajuda",
      "translation": "Hilfe",
      "example": "Preciso de ajuda agora.",
      "exampleTranslation": "Ich brauche jetzt Hilfe.",
      "explanation": "A ajuda bedeutet Hilfe. Preciso de ajuda verwendet de vor dem Nomen; agora bedeutet jetzt. Das zugeh\u00F6rige Verb hei\u00DFt ajudar, helfen, und wird in Paket 40 als direkte Bitte verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Hunger, Durst und Bed\u00FCrfnisse",
      "expression": "sozinho",
      "translation": "allein (m\u00E4nnlich)",
      "example": "Quero ficar sozinho um momento.",
      "exampleTranslation": "Ich m\u00F6chte einen Moment allein sein.",
      "explanation": "Sozinho ist die m\u00E4nnliche Form von allein; die weibliche lautet sozinha. Quero ficar \u2026 um momento bedeutet ich m\u00F6chte einen Moment \u2026 sein. Beide Formen ergeben denselben deutschen Satz; die Auswahl nicht aus einem Avatar ableiten.",
      "isVocabulary": true
    }
  ],
