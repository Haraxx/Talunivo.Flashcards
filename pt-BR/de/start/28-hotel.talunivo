      "id": "karte-01",
      "topic": "Ankunft im Hotel",
      "expression": "reserva",
      "translation": "Reservierung",
      "isVocabulary": true,
      "example": "Tenho uma reserva para duas pessoas e três noites.",
      "exampleTranslation": "Ich habe eine Reservierung für zwei Personen und drei Nächte.",
      "explanation": "A reserva; para duas pessoas = für zwei Personen."
    },
    {
      "id": "karte-02",
      "topic": "Ankunft im Hotel",
      "expression": "quarto",
      "translation": "Zimmer",
      "isVocabulary": true,
      "example": "Quero um quarto para duas pessoas.",
      "exampleTranslation": "Ich möchte ein Zimmer für zwei Personen.",
      "explanation": "O quarto; hier ein Hotelzimmer."
    },
    {
      "id": "karte-03",
      "topic": "Ankunft im Hotel",
      "expression": "noites",
      "translation": "Nächte",
      "isVocabulary": true,
      "example": "Vou ficar três noites.",
      "exampleTranslation": "Ich werde drei Nächte bleiben.",
      "explanation": "Plural von a noite; ficar três noites = drei Nächte bleiben."
    },
    {
      "id": "karte-04",
      "topic": "Ankunft im Hotel",
      "expression": "incluído",
      "translation": "inbegriffen",
      "isVocabulary": true,
      "example": "O café da manhã está incluído?",
      "exampleTranslation": "Ist das Frühstück inbegriffen?",
      "explanation": "Männliche Form; weiblich incluída."
    },
    {
      "id": "karte-05",
      "topic": "Ankunft im Hotel",
      "expression": "saída",
      "translation": "Abreise; Ausgang",
      "isVocabulary": true,
      "example": "A que horas é a saída?",
      "exampleTranslation": "Um wie viel Uhr ist die Abreise?",
      "explanation": "A saída; hier die Abreise beziehungsweise der Check-out, sonst auch Ausgang."
    },
    {
      "id": "karte-06",
      "topic": "Ankunft im Hotel",
      "expression": "passaporte",
      "translation": "Reisepass",
      "isVocabulary": true,
      "example": "Aqui está meu passaporte.",
      "exampleTranslation": "Hier ist mein Reisepass.",
      "explanation": "O passaporte; Plural passaportes."
    },
    {
      "id": "karte-07",
      "topic": "Ankunft im Hotel",
      "expression": "chave",
      "translation": "Schlüssel",
      "isVocabulary": true,
      "example": "Pode me dar a chave do quarto?",
      "exampleTranslation": "Können Sie mir den Zimmerschlüssel geben?",
      "explanation": "A chave; chave do quarto = Zimmerschlüssel."
