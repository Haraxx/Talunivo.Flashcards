  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Familie und Menschen",
      "expression": "mãe",
      "translation": "Mutter",
      "example": "Esta é a minha mãe.",
      "exampleTranslation": "Das ist meine Mutter.",
      "explanation": "A mãe, Plural mães. Minha mãe heißt meine Mutter; esta é … bedeutet das ist … für den hier weiblichen Bezug. Der Satz ist ein Übungsmuster und setzt keine Angabe über deine Familie voraus.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Familie und Menschen",
      "expression": "pai",
      "translation": "Vater",
      "example": "Este é o meu pai.",
      "exampleTranslation": "Das ist mein Vater.",
      "explanation": "O pai, Plural pais. Meu pai heißt mein Vater. Este ist hier die männliche Form. Die Mehrzahl pais kann je nach Kontext Väter oder Eltern bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Familie und Menschen",
      "expression": "irmã",
      "translation": "Schwester",
      "example": "Tenho uma irmã.",
      "exampleTranslation": "Ich habe eine Schwester.",
      "explanation": "A irmã, Plural irmãs. Tenho uma irmã bedeutet ich habe eine Schwester. Uma richtet sich nach dem weiblichen Nomen irmã; die Tilde gehört zur Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Familie und Menschen",
      "expression": "irmão",
      "translation": "Bruder",
      "example": "Meu irmão se chama João.",
      "exampleTranslation": "Mein Bruder heißt João.",
      "explanation": "O irmão, Plural irmãos. Se chama bedeutet hier heißt und greift das Vorstellungsmodell auf. Irmãos kann Brüder oder eine gemischte Gruppe von Geschwistern bezeichnen; der Zusammenhang entscheidet.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "ir-MÃU",
        "ipa": "[iɾˈmɐ̃w̃]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-05",
      "topic": "Familie und Menschen",
      "expression": "pais",
      "translation": "Eltern",
      "example": "Meus pais moram aqui.",
      "exampleTranslation": "Meine Eltern wohnen hier.",
      "explanation": "Os pais bedeutet hier die Eltern. Meus pais heißt meine Eltern; moram aqui bedeutet wohnen hier und steht in der Mehrzahl. Pais kann in einem anderen Zusammenhang auch Väter bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Familie und Menschen",
      "expression": "avó",
      "translation": "Großmutter",
      "example": "Minha avó mora perto.",
      "exampleTranslation": "Meine Großmutter wohnt in der Nähe.",
      "explanation": "A avó mit Akut bedeutet Großmutter. Mora perto heißt wohnt in der Nähe. Vergleiche avó mit avô = Großvater; die verschiedenen Akzente unterscheiden hier die Wörter.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Familie und Menschen",
      "expression": "avô",
      "translation": "Großvater",
      "example": "Meu avô mora aqui.",
      "exampleTranslation": "Mein Großvater wohnt hier.",
      "explanation": "O avô mit Zirkumflex bedeutet Großvater. Meu avô heißt mein Großvater; mora aqui bedeutet wohnt hier. Avó mit Akut bezeichnet dagegen die Großmutter.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Familie und Menschen",
      "expression": "filhos",
      "translation": "Kinder",
      "example": "Você tem filhos?",
      "exampleTranslation": "Hast du Kinder?",
      "explanation": "Os filhos bezeichnet hier die Kinder einer Person, unabhängig vom Alter. Je nach Kontext kann filhos auch Söhne bedeuten; filhas sind Töchter. Gemeint ist hier das Verwandtschaftsverhältnis, nicht allgemein eine Gruppe junger Menschen.",
      "isVocabulary": true
    }
  ],
