      "expression": "mãe",
      "translation": "Mutter",
      "isVocabulary": true,
      "example": "Esta é a minha mãe, e este é o meu pai.",
      "exampleTranslation": "Das ist meine Mutter, und das ist mein Vater.",
      "explanation": "A mãe; Plural mães."
    },
    {
      "id": "karte-02",
      "topic": "Familie und Menschen",
      "expression": "pai",
      "translation": "Vater",
      "isVocabulary": true,
      "example": "Este é o meu pai.",
      "exampleTranslation": "Das ist mein Vater.",
      "explanation": "O pai; Plural pais."
    },
    {
      "id": "karte-03",
      "topic": "Familie und Menschen",
      "expression": "irmã",
      "translation": "Schwester",
      "isVocabulary": true,
      "example": "Tenho uma irmã.",
      "exampleTranslation": "Ich habe eine Schwester.",
      "explanation": "A irmã; Plural irmãs."
    },
    {
      "id": "karte-04",
      "topic": "Familie und Menschen",
      "expression": "irmão",
      "translation": "Bruder",
      "isVocabulary": true,
      "example": "Meu irmão se chama João.",
      "exampleTranslation": "Mein Bruder heißt João.",
      "explanation": "O irmão; Plural irmãos kann auch Geschwister bezeichnen."
    },
    {
      "id": "karte-05",
      "topic": "Familie und Menschen",
      "expression": "pais",
      "translation": "Eltern",
      "isVocabulary": true,
      "example": "Meus pais moram aqui.",
      "exampleTranslation": "Meine Eltern wohnen hier.",
      "explanation": "Os pais bedeutet die Eltern; Singular pai = Vater."
    },
    {
