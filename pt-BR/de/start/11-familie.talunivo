  "cards": [
    {
      "id": "karte-01",
      "topic": "Familie und Menschen",
      "expression": "m\u00E3e",
      "translation": "Mutter",
      "example": "Esta \u00E9 a minha m\u00E3e.",
      "exampleTranslation": "Das ist meine Mutter.",
      "explanation": "A m\u00E3e, Plural m\u00E3es. Minha m\u00E3e hei\u00DFt meine Mutter; esta \u00E9 \u2026 bedeutet das ist \u2026 f\u00FCr den hier weiblichen Bezug. Der Satz ist ein \u00DCbungsmuster und setzt keine Angabe \u00FCber deine Familie voraus.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Familie und Menschen",
      "expression": "pai",
      "translation": "Vater",
      "example": "Este \u00E9 o meu pai.",
      "exampleTranslation": "Das ist mein Vater.",
      "explanation": "O pai, Plural pais. Meu pai hei\u00DFt mein Vater. Este ist hier die m\u00E4nnliche Form. Die Mehrzahl pais kann je nach Kontext V\u00E4ter oder Eltern bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Familie und Menschen",
      "expression": "irm\u00E3",
      "translation": "Schwester",
      "example": "Tenho uma irm\u00E3.",
      "exampleTranslation": "Ich habe eine Schwester.",
      "explanation": "A irm\u00E3, Plural irm\u00E3s. Tenho uma irm\u00E3 bedeutet ich habe eine Schwester. Uma richtet sich nach dem weiblichen Nomen irm\u00E3; die Tilde geh\u00F6rt zur Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Familie und Menschen",
      "expression": "irm\u00E3o",
      "translation": "Bruder",
      "example": "Meu irm\u00E3o se chama Jo\u00E3o.",
      "exampleTranslation": "Mein Bruder hei\u00DFt Jo\u00E3o.",
      "explanation": "O irm\u00E3o, Plural irm\u00E3os. Se chama bedeutet hier hei\u00DFt und greift das Vorstellungsmodell auf. Irm\u00E3os kann Br\u00FCder oder eine gemischte Gruppe von Geschwistern bezeichnen; der Zusammenhang entscheidet.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Familie und Menschen",
      "expression": "pais",
      "translation": "Eltern",
      "example": "Meus pais moram aqui.",
      "exampleTranslation": "Meine Eltern wohnen hier.",
      "explanation": "Os pais bedeutet hier die Eltern. Meus pais hei\u00DFt meine Eltern; moram aqui bedeutet wohnen hier und steht in der Mehrzahl. Pais kann in einem anderen Zusammenhang auch V\u00E4ter bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Familie und Menschen",
      "expression": "av\u00F3",
      "translation": "Gro\u00DFmutter",
      "example": "Minha av\u00F3 mora perto.",
      "exampleTranslation": "Meine Gro\u00DFmutter wohnt in der N\u00E4he.",
      "explanation": "A av\u00F3 mit Akut bedeutet Gro\u00DFmutter. Mora perto hei\u00DFt wohnt in der N\u00E4he. Vergleiche av\u00F3 mit av\u00F4 = Gro\u00DFvater; die verschiedenen Akzente unterscheiden hier die W\u00F6rter.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Familie und Menschen",
      "expression": "av\u00F4",
      "translation": "Gro\u00DFvater",
      "example": "Meu av\u00F4 mora aqui.",
      "exampleTranslation": "Mein Gro\u00DFvater wohnt hier.",
      "explanation": "O av\u00F4 mit Zirkumflex bedeutet Gro\u00DFvater. Meu av\u00F4 hei\u00DFt mein Gro\u00DFvater; mora aqui bedeutet wohnt hier. Av\u00F3 mit Akut bezeichnet dagegen die Gro\u00DFmutter.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Familie und Menschen",
      "expression": "filhos",
      "translation": "Kinder",
      "example": "Voc\u00EA tem filhos?",
      "exampleTranslation": "Hast du Kinder?",
      "explanation": "Os filhos bezeichnet hier die Kinder einer Person, unabh\u00E4ngig vom Alter. Je nach Kontext kann filhos auch S\u00F6hne bedeuten; filhas sind T\u00F6chter. Gemeint ist hier das Verwandtschaftsverh\u00E4ltnis, nicht allgemein eine Gruppe junger Menschen.",
      "isVocabulary": true
    }
  ],
