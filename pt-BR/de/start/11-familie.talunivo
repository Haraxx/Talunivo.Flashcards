      "topic": "Familie und Menschen",
      "expression": "avó",
      "translation": "Großmutter",
      "isVocabulary": true,
      "example": "Minha avó mora perto.",
      "exampleTranslation": "Meine Großmutter wohnt in der Nähe.",
      "explanation": "A avó mit Akut bezeichnet die Großmutter."
    },
    {
      "id": "karte-07",
      "topic": "Familie und Menschen",
      "expression": "avô",
      "translation": "Großvater",
      "isVocabulary": true,
      "example": "Meu avô tem setenta anos.",
      "exampleTranslation": "Mein Großvater ist siebzig Jahre alt.",
      "explanation": "O avô mit Zirkumflex bezeichnet den Großvater."
