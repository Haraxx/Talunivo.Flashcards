  "cards": [
    {
      "id": "karte-01",
      "topic": "Freizeit und Hobbys",
      "expression": "ler",
      "translation": "lesen",
      "example": "No tempo livre, leio.",
      "exampleTranslation": "In meiner Freizeit lese ich.",
      "explanation": "Ler hei\u00DFt lesen; leio ist die unregelm\u00E4\u00DFige Ich-Form im Pr\u00E4sens. No tempo livre bedeutet in der Freizeit. Paket 32 verwendet denselben Infinitiv nach gosto de; hier steht das Verb selbst in der Ich-Form.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Freizeit und Hobbys",
      "expression": "ouvir",
      "translation": "h\u00F6ren",
      "example": "Ou\u00E7o m\u00FAsica no \u00F4nibus.",
      "exampleTranslation": "Ich h\u00F6re im Bus Musik.",
      "explanation": "Ouvir hei\u00DFt h\u00F6ren; ou\u00E7o ist die unregelm\u00E4\u00DFige Ich-Form. Ou\u00E7o m\u00FAsica bedeutet ich h\u00F6re Musik. No \u00F4nibus hei\u00DFt im Bus; der Satz beschreibt einen Ort der T\u00E4tigkeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Freizeit und Hobbys",
      "expression": "filmes",
      "translation": "Filme",
      "example": "Assisto a filmes em casa.",
      "exampleTranslation": "Ich schaue zu Hause Filme.",
      "explanation": "O filme, Plural os filmes, hei\u00DFt Film beziehungsweise Filme. Assisto a filmes ist hier das Muster f\u00FCr ich schaue Filme. Em casa bedeutet zu Hause. Im brasilianischen Alltag h\u00F6rt man assistir auch ohne a.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Freizeit und Hobbys",
      "expression": "jogar",
      "translation": "spielen (Sport)",
      "example": "Jogo futebol aos s\u00E1bados.",
      "exampleTranslation": "Ich spiele samstags Fu\u00DFball.",
      "explanation": "Jogar hei\u00DFt bei Sport und Spielen spielen; jogo ist die Ich-Form. Aos s\u00E1bados bedeutet samstags, also wiederholt. Ein Instrument spielen hei\u00DFt tocar; jogar ist nicht auf Sport beschr\u00E4nkt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Freizeit und Hobbys",
      "expression": "caminhada",
      "translation": "Spaziergang",
      "example": "Fa\u00E7o uma caminhada no parque.",
      "exampleTranslation": "Ich gehe im Park spazieren.",
      "explanation": "A caminhada, Plural caminhadas, bezeichnet hier einen Spaziergang. Fa\u00E7o ist die Ich-Form von fazer. Fazer uma caminhada bedeutet spazieren gehen; je nach Strecke kann caminhada auch eine Wanderung bezeichnen.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Freizeit und Hobbys",
      "expression": "fotos",
      "translation": "Fotos",
      "example": "Tiro fotos da cidade.",
      "exampleTranslation": "Ich fotografiere die Stadt.",
      "explanation": "A foto, Plural as fotos, hei\u00DFt Foto beziehungsweise Fotos. Tirar fotos bedeutet Fotos machen; tiro ist die Ich-Form. Da cidade hei\u00DFt hier von der Stadt und bezeichnet das Motiv.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Freizeit und Hobbys",
      "expression": "nadar",
      "translation": "schwimmen",
      "example": "Gosto de nadar no mar.",
      "exampleTranslation": "Ich schwimme gern im Meer.",
      "explanation": "Nadar hei\u00DFt schwimmen. Nach gosto de steht der Infinitiv; no mar bedeutet im Meer. Das Beispiel beschreibt eine Vorliebe und gibt keine Auskunft \u00FCber die Schwimmf\u00E4higkeit oder Bedingungen an einem bestimmten Ort.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Freizeit und Hobbys",
      "expression": "desenhar",
      "translation": "zeichnen",
      "example": "No tempo livre, desenho.",
      "exampleTranslation": "In meiner Freizeit zeichne ich.",
      "explanation": "Desenhar hei\u00DFt zeichnen; desenho ist hier die Ich-Form im Pr\u00E4sens. Als Nomen bedeutet o desenho die Zeichnung. Im Beispielsatz zeigt die Satzstellung die T\u00E4tigkeit an.",
      "isVocabulary": true
    }
  ],
