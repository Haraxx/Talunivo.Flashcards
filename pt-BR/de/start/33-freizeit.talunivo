  "cards": [
    {
      "id": "karte-01",
      "topic": "Freizeit und Hobbys",
      "expression": "ler",
      "translation": "lesen",
      "example": "No tempo livre, leio.",
      "exampleTranslation": "In meiner Freizeit lese ich.",
      "explanation": "Ler heißt lesen; leio ist die unregelmäßige Ich-Form im Präsens. No tempo livre bedeutet in der Freizeit. Paket 32 verwendet denselben Infinitiv nach gosto de; hier steht das Verb selbst in der Ich-Form.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "LER",
        "ipa": "[leɾ]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-02",
      "topic": "Freizeit und Hobbys",
      "expression": "ouvir",
      "translation": "hören",
      "example": "Ouço música no ônibus.",
      "exampleTranslation": "Ich höre im Bus Musik.",
      "explanation": "Ouvir heißt hören; ouço ist die unregelmäßige Ich-Form. Ouço música bedeutet ich höre Musik. No ônibus heißt im Bus; der Satz beschreibt einen Ort der Tätigkeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Freizeit und Hobbys",
      "expression": "filmes",
      "translation": "Filme",
      "example": "Assisto a filmes em casa.",
      "exampleTranslation": "Ich schaue zu Hause Filme.",
      "explanation": "O filme, Plural os filmes, heißt Film beziehungsweise Filme. Assisto a filmes ist hier das Muster für ich schaue Filme. Em casa bedeutet zu Hause. Im brasilianischen Alltag hört man assistir auch ohne a.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Freizeit und Hobbys",
      "expression": "jogar",
      "translation": "spielen (Sport)",
      "example": "Jogo futebol aos sábados.",
      "exampleTranslation": "Ich spiele samstags Fußball.",
      "explanation": "Jogar heißt bei Sport und Spielen spielen; jogo ist die Ich-Form. Aos sábados bedeutet samstags, also wiederholt. Ein Instrument spielen heißt tocar; jogar ist nicht auf Sport beschränkt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Freizeit und Hobbys",
      "expression": "caminhada",
      "translation": "Spaziergang",
      "example": "Faço uma caminhada no parque.",
      "exampleTranslation": "Ich gehe im Park spazieren.",
      "explanation": "A caminhada, Plural caminhadas, bezeichnet hier einen Spaziergang. Faço ist die Ich-Form von fazer. Fazer uma caminhada bedeutet spazieren gehen; je nach Strecke kann caminhada auch eine Wanderung bezeichnen.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Freizeit und Hobbys",
      "expression": "fotos",
      "translation": "Fotos",
      "example": "Tiro fotos da cidade.",
      "exampleTranslation": "Ich fotografiere die Stadt.",
      "explanation": "A foto, Plural as fotos, heißt Foto beziehungsweise Fotos. Tirar fotos bedeutet Fotos machen; tiro ist die Ich-Form. Da cidade heißt hier von der Stadt und bezeichnet das Motiv.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Freizeit und Hobbys",
      "expression": "nadar",
      "translation": "schwimmen",
      "example": "Gosto de nadar no mar.",
      "exampleTranslation": "Ich schwimme gern im Meer.",
      "explanation": "Nadar heißt schwimmen. Nach gosto de steht der Infinitiv; no mar bedeutet im Meer. Das Beispiel beschreibt eine Vorliebe und gibt keine Auskunft über die Schwimmfähigkeit oder Bedingungen an einem bestimmten Ort.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Freizeit und Hobbys",
      "expression": "desenhar",
      "translation": "zeichnen",
      "example": "No tempo livre, desenho.",
      "exampleTranslation": "In meiner Freizeit zeichne ich.",
      "explanation": "Desenhar heißt zeichnen; desenho ist hier die Ich-Form im Präsens. Als Nomen bedeutet o desenho die Zeichnung. Im Beispielsatz zeigt die Satzstellung die Tätigkeit an.",
      "isVocabulary": true
    }
  ],
