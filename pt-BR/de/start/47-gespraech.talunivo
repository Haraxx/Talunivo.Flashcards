  "title": "47 · Kleine Gespräche verbinden",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Kleine Gespräche verbinden",
      "expression": "mas",
      "translation": "aber",
      "isVocabulary": true,
      "example": "Quero sair, mas estou cansada.",
      "exampleTranslation": "Ich möchte ausgehen, aber ich bin müde.",
      "explanation": "Mas verbindet einen Gegensatz; nicht mit mais, mehr, verwechseln."
    },
    {
      "id": "karte-02",
      "topic": "Kleine Gespräche verbinden",
      "expression": "e",
      "translation": "und",
      "isVocabulary": true,
      "example": "Gosto de chá e de suco.",
      "exampleTranslation": "Ich mag Tee und Saft.",
      "explanation": "E verbindet Wörter oder Satzteile: und."
    },
    {
      "id": "karte-03",
      "topic": "Kleine Gespräche verbinden",
      "expression": "ou",
      "translation": "oder",
      "isVocabulary": true,
      "example": "Você quer água ou café?",
      "exampleTranslation": "Möchtest du Wasser oder Kaffee?",
      "explanation": "Ou bietet eine Alternative: oder."
    },
    {
      "id": "karte-04",
      "topic": "Kleine Gespräche verbinden",
      "expression": "porque",
      "translation": "weil",
      "isVocabulary": true,
      "example": "Estou cansada porque trabalhei muito.",
      "exampleTranslation": "Ich bin müde, weil ich viel gearbeitet habe.",
      "explanation": "Porque nennt einen Grund; por que in einer Frage bedeutet warum."
    },
    {
      "id": "karte-05",
      "topic": "Kleine Gespräche verbinden",
      "expression": "primeiro",
      "translation": "zuerst",
      "isVocabulary": true,
      "example": "Primeiro vou comer.",
      "exampleTranslation": "Zuerst werde ich essen.",
      "explanation": "Primeiro leitet den ersten Schritt ein."
    },
    {
      "id": "karte-05-2",
      "topic": "Kleine Gespräche verbinden",
      "expression": "depois",
      "translation": "danach",
      "isVocabulary": true,
      "example": "Depois vou sair.",
      "exampleTranslation": "Danach werde ich ausgehen.",
      "explanation": "Depois bezeichnet einen späteren Schritt."
    },
    {
      "id": "karte-06",
      "topic": "Kleine Gespräche verbinden",
      "expression": "se",
      "translation": "wenn",
      "isVocabulary": true,
      "example": "Se chover, vou ficar em casa.",
      "exampleTranslation": "Wenn es regnet, werde ich zu Hause bleiben.",
      "explanation": "Se leitet hier eine Bedingung ein: wenn."
    },
    {
      "id": "karte-07",
      "topic": "Kleine Gespräche verbinden",
      "expression": "perguntar",
      "translation": "fragen",
      "isVocabulary": true,
      "example": "Não sei, mas posso perguntar.",
      "exampleTranslation": "Ich weiß es nicht, aber ich kann fragen.",
      "explanation": "Posso perguntar = ich kann fragen."
    },
    {
      "id": "karte-08",
      "topic": "Kleine Gespräche verbinden",
      "expression": "achar",
      "translation": "glauben; finden",
      "isVocabulary": true,
      "example": "Acho que sim.",
      "exampleTranslation": "Ich glaube schon.",
      "explanation": "Acho que … bedeutet ich glaube beziehungsweise finde, dass …"
    }
  ]
