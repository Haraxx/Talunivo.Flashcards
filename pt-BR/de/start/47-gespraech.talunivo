  "title": "47 \u00B7 Kleine Gespr\u00E4che verbinden",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "mas",
      "translation": "aber",
      "example": "Quero sair, mas estou cansada.",
      "exampleTranslation": "Ich m\u00F6chte ausgehen, aber ich bin m\u00FCde.",
      "explanation": "Mas bedeutet aber und verbindet hier einen Wunsch mit einem entgegenstehenden Zustand. Nicht mit mais, mehr, verwechseln. Cansada ist die weibliche Form, cansado die m\u00E4nnliche; beide ergeben denselben deutschen Satz.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "e",
      "translation": "und",
      "example": "Gosto de ch\u00E1 e de suco.",
      "exampleTranslation": "Ich mag Tee und Saft.",
      "explanation": "E bedeutet und. Gosto de verlangt im gelehrten Muster de; im Beispiel wird de vor suco wiederholt. Der Satz nennt beide Getr\u00E4nke als Vorlieben und bietet keine Auswahl zwischen ihnen an.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "ou",
      "translation": "oder",
      "example": "Voc\u00EA quer \u00E1gua ou caf\u00E9?",
      "exampleTranslation": "M\u00F6chtest du Wasser oder Kaffee?",
      "explanation": "Ou bedeutet oder und stellt hier Wasser und Kaffee zur Auswahl. Quer geh\u00F6rt zu voc\u00EA. Der Satz fragt nach einem Wunsch; er gibt nicht vor, welches Getr\u00E4nk die Person w\u00E4hlen muss.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "porque",
      "translation": "weil",
      "example": "Estou cansada porque trabalhei muito.",
      "exampleTranslation": "Ich bin m\u00FCde, weil ich viel gearbeitet habe.",
      "explanation": "Porque bedeutet hier weil und leitet den Grund ein. Trabalhei ist die vergangene Ich-Form von trabalhar; muito hei\u00DFt hier viel. Cansada ist die weibliche Form, cansado die m\u00E4nnliche. Por que am Anfang einer direkten Frage bedeutet dagegen warum.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "primeiro",
      "translation": "zuerst",
      "example": "Primeiro vou comer.",
      "exampleTranslation": "Zuerst werde ich essen.",
      "explanation": "Primeiro hei\u00DFt hier zuerst und ordnet eine Handlung als ersten Schritt ein. Vou comer k\u00FCndigt an, dass ich essen werde. In diesem Gebrauch als Reihenfolgewort bleibt primeiro unver\u00E4ndert.",
      "isVocabulary": true
    },
    {
      "id": "karte-05-2",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "depois",
      "translation": "danach",
      "example": "Depois vou sair.",
      "exampleTranslation": "Danach werde ich ausgehen.",
      "explanation": "Depois bedeutet hier danach. Nach dem Essen aus der vorherigen Karte folgt in der Beispielsituation das Ausgehen. Vou sair k\u00FCndigt die Handlung an; eine genaue Zeitspanne zwischen den Schritten ist nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "se",
      "translation": "wenn",
      "example": "Se chover, vou ficar em casa.",
      "exampleTranslation": "Wenn es regnet, werde ich zu Hause bleiben.",
      "explanation": "Se leitet hier eine Bedingung ein: wenn oder falls. Se chover bedeutet falls es regnet; chover ist hier der Futur-Konjunktiv und sieht genauso aus wie der Infinitiv regnen. Vou ficar em casa nennt den Plan f\u00FCr diesen Fall.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "perguntar",
      "translation": "fragen",
      "example": "N\u00E3o sei, mas posso perguntar.",
      "exampleTranslation": "Ich wei\u00DF es nicht, aber ich kann fragen.",
      "explanation": "Perguntar hei\u00DFt fragen. N\u00E3o sei bedeutet ich wei\u00DF es nicht; mas verbindet damit ich kann fragen. Nach posso steht der Infinitiv perguntar. Der Satz sagt noch nicht, wen oder wonach die Person fragen wird.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Kleine Gespr\u00E4che verbinden",
      "expression": "achar",
      "translation": "glauben; finden",
      "example": "Acho que sim.",
      "exampleTranslation": "Ich glaube schon.",
      "explanation": "Achar hei\u00DFt hier glauben oder der Meinung sein; acho ist die Ich-Form. Acho que sim dr\u00FCckt eine Einsch\u00E4tzung aus, keine v\u00F6llig sichere Best\u00E4tigung. Achar kann auch einen Gegenstand finden bedeuten; diese Lesart passt hier nicht.",
      "isVocabulary": true
    }
  ],
