  "cards": [
    {
      "id": "karte-01",
      "topic": "Kleine Gespräche verbinden",
      "expression": "mas",
      "translation": "aber",
      "isVocabulary": true,
      "example": "Primeiro vou estudar, depois vou tomar um café.",
      "exampleTranslation": "Erst werde ich lernen, danach werde ich einen Kaffee trinken."
    },
    {
      "id": "karte-02",
      "topic": "Kleine Gespräche verbinden",
      "expression": "e",
      "translation": "und",
      "isVocabulary": true,
      "example": "Gosto de chá e de suco.",
      "exampleTranslation": "Ich mag Tee und Saft."
    },
    {
      "id": "karte-03",
      "topic": "Kleine Gespräche verbinden",
      "expression": "ou",
      "translation": "oder",
      "isVocabulary": true,
      "example": "Você quer água ou café?",
      "exampleTranslation": "Möchtest du Wasser oder Kaffee?"
    },
    {
      "id": "karte-04",
      "topic": "Kleine Gespräche verbinden",
      "expression": "porque",
      "translation": "weil",
      "isVocabulary": true,
      "example": "Estou cansada porque trabalhei muito.",
      "exampleTranslation": "Ich bin müde, weil ich viel gearbeitet habe."
    },
    {
      "id": "karte-05",
      "topic": "Kleine Gespräche verbinden",
      "expression": "primeiro",
      "translation": "zuerst",
      "isVocabulary": true,
      "example": "Primeiro vou comer, depois vou sair.",
      "exampleTranslation": "Erst werde ich essen, danach werde ich ausgehen."
    },
    {
      "id": "karte-05-2",
      "topic": "Kleine Gespräche verbinden",
      "expression": "depois",
      "translation": "danach",
      "isVocabulary": true,
      "example": "Primeiro vou comer, depois vou sair.",
      "exampleTranslation": "Erst werde ich essen, danach werde ich ausgehen."
    },
    {
      "id": "karte-06",
      "topic": "Kleine Gespräche verbinden",
      "expression": "se",
      "translation": "wenn",
      "isVocabulary": true,
      "example": "Se chover, vou ficar em casa.",
      "exampleTranslation": "Wenn es regnet, werde ich zu Hause bleiben."
    },
    {
      "id": "karte-07",
      "topic": "Kleine Gespräche verbinden",
      "expression": "perguntar",
      "translation": "fragen",
      "isVocabulary": true,
      "example": "Não sei, mas posso perguntar.",
      "exampleTranslation": "Ich weiß es nicht, aber ich kann fragen."
    },
    {
      "id": "karte-08",
      "topic": "Kleine Gespräche verbinden",
      "expression": "achar",
      "translation": "glauben; finden",
      "isVocabulary": true,
      "example": "Acho que sim.",
      "exampleTranslation": "Ich glaube schon."
    }
  ]
