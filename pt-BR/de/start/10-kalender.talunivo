  "cards": [
    {
      "id": "karte-01",
      "topic": "Wochentage und Datum",
      "expression": "segunda-feira",
      "translation": "Montag",
      "example": "Hoje \u00E9 segunda-feira.",
      "exampleTranslation": "Heute ist Montag.",
      "explanation": "Segunda-feira ist Montag. Portugiesische Wochentage werden kleingeschrieben. Hoje \u00E9 segunda-feira nennt den Wochentag; na segunda-feira hei\u00DFt am Montag.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Wochentage und Datum",
      "expression": "ter\u00E7a-feira",
      "translation": "Dienstag",
      "example": "Amanh\u00E3 \u00E9 ter\u00E7a-feira.",
      "exampleTranslation": "Morgen ist Dienstag.",
      "explanation": "Ter\u00E7a-feira ist Dienstag; amanh\u00E3 bedeutet morgen. Na ter\u00E7a-feira hei\u00DFt am Dienstag. Das \u00E7 in ter\u00E7a und die Tilde in amanh\u00E3 geh\u00F6ren zur Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Wochentage und Datum",
      "expression": "quarta-feira",
      "translation": "Mittwoch",
      "example": "A aula \u00E9 na quarta-feira.",
      "exampleTranslation": "Der Unterricht ist am Mittwoch.",
      "explanation": "Quarta-feira ist Mittwoch. Na entsteht aus em \u002B a: na quarta-feira = am Mittwoch. A aula aus dem Uhrzeitpaket bedeutet hier der Unterricht.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Wochentage und Datum",
      "expression": "quinta-feira",
      "translation": "Donnerstag",
      "example": "Trabalho na quinta-feira.",
      "exampleTranslation": "Ich arbeite am Donnerstag.",
      "explanation": "Quinta-feira ist Donnerstag. Trabalho hei\u00DFt hier ich arbeite; na quinta-feira bedeutet am Donnerstag. Im eindeutigen Wochentagskontext ist auch die Kurzform na quinta gebr\u00E4uchlich.",
      "isVocabulary": true
    },
    {
      "id": "karte-04-2",
      "topic": "Wochentage und Datum",
      "expression": "sexta-feira",
      "translation": "Freitag",
      "example": "A aula \u00E9 na sexta-feira.",
      "exampleTranslation": "Der Unterricht ist am Freitag.",
      "explanation": "Sexta-feira ist Freitag. Na sexta-feira bedeutet am Freitag; im eindeutigen Tageskontext ist auch na sexta m\u00F6glich. Nicht mit quinta-feira = Donnerstag verwechseln.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Wochentage und Datum",
      "expression": "s\u00E1bado",
      "translation": "Samstag",
      "example": "No s\u00E1bado, vou ao parque.",
      "exampleTranslation": "Am Samstag gehe ich in den Park.",
      "explanation": "S\u00E1bado ist Samstag und tr\u00E4gt einen Akut. No entsteht aus em \u002B o: no s\u00E1bado = am Samstag. Vou ao parque hei\u00DFt hier ich gehe in den Park.",
      "isVocabulary": true
    },
    {
      "id": "karte-05-2",
      "topic": "Wochentage und Datum",
      "expression": "domingo",
      "translation": "Sonntag",
      "example": "No domingo, fico em casa.",
      "exampleTranslation": "Am Sonntag bleibe ich zu Hause.",
      "explanation": "Domingo ist Sonntag. No domingo bedeutet am Sonntag; fico em casa hei\u00DFt ich bleibe zu Hause. F\u00FCr Samstag und Sonntag steht hier no, f\u00FCr segunda-feira bis sexta-feira na.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Wochentage und Datum",
      "expression": "dia",
      "translation": "Tag",
      "example": "Hoje \u00E9 dia dez de maio.",
      "exampleTranslation": "Heute ist der zehnte Mai.",
      "explanation": "O dia, Plural dias, ist m\u00E4nnlich. Dia dez de maio bedeutet der zehnte Mai. Que dia \u00E9 hoje? kann je nach Gespr\u00E4ch Datum oder Wochentag erfragen; ein eindeutiger Kontext ist deshalb n\u00F6tig.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Wochentage und Datum",
      "expression": "maio",
      "translation": "Mai",
      "example": "Hoje \u00E9 primeiro de maio.",
      "exampleTranslation": "Heute ist der erste Mai.",
      "explanation": "Maio ist Mai; portugiesische Monatsnamen werden kleingeschrieben. Primeiro de maio hei\u00DFt erster Mai. Den ersten Tag eines Monats benennt man hier mit primeiro; dia dez de maio verwendet dagegen die Zahl dez.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Wochentage und Datum",
      "expression": "junho",
      "translation": "Juni",
      "example": "Meu anivers\u00E1rio \u00E9 em junho.",
      "exampleTranslation": "Mein Geburtstag ist im Juni.",
      "explanation": "Junho ist Juni; em junho bedeutet im Juni. Meu anivers\u00E1rio hei\u00DFt mein Geburtstag. Verwechsle junho = Juni nicht mit dem folgenden Monat julho = Juli; dieser wird hier nur zur Abgrenzung genannt.",
      "isVocabulary": true
    }
  ],
