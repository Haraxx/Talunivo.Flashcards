  "cards": [
    {
      "id": "karte-01",
      "topic": "Wetter und Jahreszeiten",
      "expression": "tempo",
      "translation": "Wetter",
      "isVocabulary": true,
      "example": "Como está o tempo hoje?",
      "exampleTranslation": "Wie ist das Wetter heute?",
      "explanation": "O tempo bedeutet in dieser Frage Wetter. Como está …? fragt hier nach dem aktuellen Zustand; hoje heißt heute. In Você tem tempo? aus Paket 34 bedeutet tempo dagegen Zeit."
    },
    {
      "id": "karte-02",
      "topic": "Wetter und Jahreszeiten",
      "expression": "quente",
      "translation": "heiß",
      "isVocabulary": true,
      "example": "Hoje está quente.",
      "exampleTranslation": "Heute ist es heiß.",
      "explanation": "Quente heißt heiß, je nach Zusammenhang auch warm. Hoje está quente beschreibt das heutige Wetter. Quente hat dieselbe Form bei männlichen und weiblichen Nomen; die Mehrzahl lautet quentes."
    },
    {
      "id": "karte-03",
      "topic": "Wetter und Jahreszeiten",
      "expression": "frio",
      "translation": "kalt",
      "isVocabulary": true,
      "example": "Está fazendo frio.",
      "exampleTranslation": "Es ist kalt.",
      "explanation": "Frio heißt kalt. Está fazendo frio ist ein Wettermuster für es ist gerade kalt; frio steht darin unverändert. Bei einem beschriebenen Nomen passt sich das Adjektiv an: água fria heißt kaltes Wasser."
    },
    {
      "id": "karte-04",
      "topic": "Wetter und Jahreszeiten",
      "expression": "chover",
      "translation": "regnen",
      "isVocabulary": true,
      "example": "Está chovendo muito.",
      "exampleTranslation": "Es regnet stark.",
      "explanation": "Chover heißt regnen; chovendo ist das Gerundium. Está chovendo ist hier die Verlaufsform und bedeutet es regnet gerade. Muito verstärkt zu stark oder viel. Der portugiesische Wettersatz braucht kein eigenes Wort für deutsches es."
    },
    {
      "id": "karte-05",
      "topic": "Wetter und Jahreszeiten",
      "expression": "nublado",
      "translation": "bewölkt",
      "isVocabulary": true,
      "example": "O céu está nublado.",
      "exampleTranslation": "Der Himmel ist bewölkt.",
      "explanation": "Nublado heißt bewölkt und passt im Beispiel zum männlichen Nomen o céu, der Himmel. Mit einem weiblichen Nomen lautet die Form nublada. Die Aussage beschreibt den Zustand, ohne Regen zu behaupten."
    },
    {
      "id": "karte-06",
      "topic": "Wetter und Jahreszeiten",
      "expression": "vento",
      "translation": "Wind",
      "isVocabulary": true,
      "example": "Tem muito vento hoje.",
      "exampleTranslation": "Heute ist es sehr windig.",
      "explanation": "O vento bedeutet Wind. Tem muito vento heißt im brasilianischen Alltagsgebrauch es gibt viel Wind, idiomatisch es ist sehr windig. Muito bezieht sich hier auf das männliche Nomen vento."
    },
    {
      "id": "karte-07",
      "topic": "Wetter und Jahreszeiten",
      "expression": "verão",
      "translation": "Sommer",
      "isVocabulary": true,
      "example": "No verão, gosto de ir à praia.",
      "exampleTranslation": "Im Sommer gehe ich gern an den Strand.",
      "explanation": "O verão, Plural verões, heißt Sommer. No verão bedeutet im Sommer; ir à praia heißt an den Strand gehen. Das Beispiel nennt eine Vorliebe, keine für alle Regionen geltende Sommeraktivität."
    },
    {
      "id": "karte-08",
      "topic": "Wetter und Jahreszeiten",
      "expression": "inverno",
      "translation": "Winter",
      "isVocabulary": true,
      "example": "No inverno, uso um casaco.",
      "exampleTranslation": "Im Winter trage ich einen Mantel.",
      "explanation": "O inverno, Plural invernos, heißt Winter; no inverno bedeutet im Winter. Uso ist hier die Ich-Form von usar im Sinn von tragen. Casaco kann je nach Kleidungsstück Mantel oder Jacke heißen."
    },
    {
      "id": "karte-09",
      "topic": "Wetter und Jahreszeiten",
      "expression": "primavera",
      "translation": "Frühling",
      "isVocabulary": true,
      "example": "Na primavera, caminho no parque.",
      "exampleTranslation": "Im Frühling gehe ich im Park spazieren.",
      "explanation": "A primavera, Plural primaveras, heißt Frühling. Na verbindet em + a und bedeutet hier im. Caminho ist im Satz die Ich-Form von caminhar, gehen oder spazieren gehen; die Tätigkeit ist ein persönliches Beispiel."
    },
    {
      "id": "karte-10",
      "topic": "Wetter und Jahreszeiten",
      "expression": "outono",
      "translation": "Herbst",
      "isVocabulary": true,
      "example": "No outono, gosto de tomar chá.",
      "exampleTranslation": "Im Herbst trinke ich gern Tee.",
      "explanation": "O outono, Plural outonos, heißt Herbst. No verbindet em + o; no outono bedeutet im Herbst. Gosto de tomar chá heißt ich trinke gern Tee. Aus den Jahreszeitennamen folgen hier keine festen Monate oder Wetterbedingungen."
    }
  ]
}
