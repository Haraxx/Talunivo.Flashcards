  "cards": [
    {
      "id": "karte-01",
      "topic": "Bus und Metro",
      "expression": "ponto de \u00F4nibus",
      "translation": "Bushaltestelle",
      "example": "Onde fica o ponto de \u00F4nibus?",
      "exampleTranslation": "Wo ist die Bushaltestelle?",
      "explanation": "O ponto de \u00F4nibus ist eine Bushaltestelle; die Mehrzahl lautet pontos de \u00F4nibus. Onde fica \u2026? ist die bekannte Ortsfrage. \u00D4nibus bleibt auch in dieser Wortgruppe unver\u00E4ndert.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Bus und Metro",
      "expression": "\u00F4nibus",
      "translation": "Bus",
      "example": "Este \u00F4nibus vai para o centro?",
      "exampleTranslation": "F\u00E4hrt dieser Bus ins Zentrum?",
      "explanation": "O \u00F4nibus ist ein Bus, os \u00F4nibus sind mehrere Busse; das Wort bleibt gleich. Este \u00F4nibus hei\u00DFt dieser Bus. Vai para o centro fragt hier nach dem Fahrtziel ins Zentrum.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Bus und Metro",
      "expression": "linha",
      "translation": "Linie",
      "example": "Qual linha devo pegar?",
      "exampleTranslation": "Welche Linie soll ich nehmen?",
      "explanation": "A linha, Plural linhas, bezeichnet hier eine Verkehrslinie. Devo pegar hei\u00DFt in dieser Frage soll ich nehmen. Das Muster erfragt die Linie; eine konkrete Liniennummer ist noch nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Bus und Metro",
      "expression": "passagem",
      "translation": "Fahrkarte",
      "example": "Uma passagem, por favor.",
      "exampleTranslation": "Eine Fahrkarte, bitte.",
      "explanation": "A passagem, Plural passagens, ist hier eine Fahrkarte. Uma passt zum weiblichen Nomen. Je nach Verkehrskontext k\u00F6nnen Fahrkarte, Fahrschein oder Ticket passende deutsche Fassungen sein.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Bus und Metro",
      "expression": "bilhete",
      "translation": "Fahrschein",
      "example": "Onde posso comprar o bilhete?",
      "exampleTranslation": "Wo kann ich den Fahrschein kaufen?",
      "explanation": "O bilhete, Plural bilhetes, bezeichnet hier einen Fahrschein. Onde posso comprar \u2026? hei\u00DFt wo kann ich \u2026 kaufen? Au\u00DFerhalb des Verkehrskontexts kann bilhete auch eine kurze schriftliche Nachricht bezeichnen.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Bus und Metro",
      "expression": "parada",
      "translation": "Haltestelle",
      "example": "Preciso descer na pr\u00F3xima parada.",
      "exampleTranslation": "Ich muss an der n\u00E4chsten Haltestelle aussteigen.",
      "explanation": "A parada, Plural paradas, ist hier eine Haltestelle. Pr\u00F3xima parada hei\u00DFt n\u00E4chste Haltestelle; na ist em \u002B a. Preciso descer bedeutet hier ich muss aussteigen, mit einem Verb direkt nach preciso.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Bus und Metro",
      "expression": "trocar",
      "translation": "wechseln",
      "example": "Tenho que trocar de linha?",
      "exampleTranslation": "Muss ich die Linie wechseln?",
      "explanation": "Trocar bedeutet wechseln. Trocar de linha hei\u00DFt die Linie wechseln; tenho que \u2026 bedeutet hier ich muss \u2026 Die Wendung ben\u00F6tigt bei diesem Bezug de vor linha.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Bus und Metro",
      "expression": "metr\u00F4",
      "translation": "Metro",
      "example": "O metr\u00F4 est\u00E1 lotado.",
      "exampleTranslation": "Die Metro ist \u00FCberf\u00FCllt.",
      "explanation": "O metr\u00F4 ist die hier gelernte brasilianische Bezeichnung und Schreibweise f\u00FCr Metro beziehungsweise U-Bahn. Est\u00E1 lotado bedeutet ist \u00FCberf\u00FCllt; lotado ist m\u00E4nnlich wegen metr\u00F4. Der Satz beschreibt eine erfundene Fahrsituation.",
      "isVocabulary": true
    }
  ],
