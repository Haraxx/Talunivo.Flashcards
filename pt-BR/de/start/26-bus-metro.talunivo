    {
      "id": "karte-01",
      "topic": "Bus und Metro",
      "expression": "ponto de ônibus",
      "translation": "Bushaltestelle",
      "isVocabulary": true,
      "example": "Onde fica o ponto de ônibus?",
      "exampleTranslation": "Wo ist die Bushaltestelle?",
      "explanation": "O ponto de ônibus ist eine Bushaltestelle; die Mehrzahl lautet pontos de ônibus. Onde fica …? ist die bekannte Ortsfrage. Ônibus bleibt auch in dieser Wortgruppe unverändert."
    },
    {
      "id": "karte-02",
      "topic": "Bus und Metro",
      "expression": "ônibus",
      "translation": "Bus",
      "isVocabulary": true,
      "example": "Este ônibus vai para o centro?",
      "exampleTranslation": "Fährt dieser Bus ins Zentrum?",
      "explanation": "O ônibus ist ein Bus, os ônibus sind mehrere Busse; das Wort bleibt gleich. Este ônibus heißt dieser Bus. Vai para o centro fragt hier nach dem Fahrtziel ins Zentrum."
    },
    {
      "id": "karte-03",
      "topic": "Bus und Metro",
      "expression": "linha",
      "translation": "Linie",
      "isVocabulary": true,
      "example": "Qual linha devo pegar?",
      "exampleTranslation": "Welche Linie soll ich nehmen?",
      "explanation": "A linha, Plural linhas, bezeichnet hier eine Verkehrslinie. Devo pegar heißt in dieser Frage soll ich nehmen. Das Muster erfragt die Linie; eine konkrete Liniennummer ist noch nicht genannt."
    },
    {
      "id": "karte-04",
      "topic": "Bus und Metro",
      "expression": "passagem",
      "translation": "Fahrkarte",
      "isVocabulary": true,
      "example": "Uma passagem, por favor.",
      "exampleTranslation": "Eine Fahrkarte, bitte.",
      "explanation": "A passagem, Plural passagens, ist hier eine Fahrkarte. Uma passt zum weiblichen Nomen. Je nach Verkehrskontext können Fahrkarte, Fahrschein oder Ticket passende deutsche Fassungen sein."
    },
    {
      "id": "karte-05",
      "topic": "Bus und Metro",
      "expression": "bilhete",
      "translation": "Fahrschein",
      "isVocabulary": true,
      "example": "Onde posso comprar o bilhete?",
      "exampleTranslation": "Wo kann ich den Fahrschein kaufen?",
      "explanation": "O bilhete, Plural bilhetes, bezeichnet hier einen Fahrschein. Onde posso comprar …? heißt wo kann ich … kaufen? Außerhalb des Verkehrskontexts kann bilhete auch eine kurze schriftliche Nachricht bezeichnen."
    },
    {
      "id": "karte-06",
      "topic": "Bus und Metro",
      "expression": "parada",
      "translation": "Haltestelle",
      "isVocabulary": true,
      "example": "Preciso descer na próxima parada.",
      "exampleTranslation": "Ich muss an der nächsten Haltestelle aussteigen.",
      "explanation": "A parada, Plural paradas, ist hier eine Haltestelle. Próxima parada heißt nächste Haltestelle; na ist em + a. Preciso descer bedeutet hier ich muss aussteigen, mit einem Verb direkt nach preciso."
    },
    {
      "id": "karte-07",
      "topic": "Bus und Metro",
      "expression": "trocar",
      "translation": "wechseln",
      "isVocabulary": true,
      "example": "Tenho que trocar de linha?",
      "exampleTranslation": "Muss ich die Linie wechseln?",
      "explanation": "Trocar bedeutet wechseln. Trocar de linha heißt die Linie wechseln; tenho que … bedeutet hier ich muss … Die Wendung benötigt bei diesem Bezug de vor linha."
    },
    {
      "id": "karte-08",
      "topic": "Bus und Metro",
      "expression": "metrô",
      "translation": "Metro",
      "isVocabulary": true,
      "example": "O metrô está lotado.",
      "exampleTranslation": "Die Metro ist überfüllt.",
      "explanation": "O metrô ist die hier gelernte brasilianische Bezeichnung und Schreibweise für Metro beziehungsweise U-Bahn. Está lotado bedeutet ist überfüllt; lotado ist männlich wegen metrô. Der Satz beschreibt eine erfundene Fahrsituation."
    }
  ]
