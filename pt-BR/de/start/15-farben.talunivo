  "title": "15 · Farben und Beschreibungen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Farben und Beschreibungen",
      "expression": "A camisa é branca.",
      "translation": "Das Hemd ist weiß.",
      "explanation": "branca passt zum weiblichen Wort camisa.",
      "example": "Quero uma camisa branca e uma bolsa preta.",
      "exampleTranslation": "Ich möchte ein weißes Hemd und eine schwarze Tasche."
    },
    {
      "id": "karte-02",
      "topic": "Farben und Beschreibungen",
      "expression": "O sapato é preto.",
      "translation": "Der Schuh ist schwarz.",
      "explanation": "preto passt zum männlichen Wort sapato."
    },
    {
      "id": "karte-03",
      "topic": "Farben und Beschreibungen",
      "expression": "Quero a bolsa vermelha.",
      "translation": "Ich möchte die rote Tasche.",
      "explanation": "vermelha = rot, weibliche Form."
    },
    {
      "id": "karte-04",
      "topic": "Farben und Beschreibungen",
      "expression": "O céu está azul.",
      "translation": "Der Himmel ist blau.",
      "explanation": "azul bleibt bei männlichen und weiblichen Wörtern gleich."
    },
    {
      "id": "karte-05",
      "topic": "Farben und Beschreibungen",
      "expression": "A parede é verde.",
      "translation": "Die Wand ist grün.",
      "explanation": "verde bleibt für beide Geschlechter gleich."
    },
    {
      "id": "karte-06",
      "topic": "Farben und Beschreibungen",
      "expression": "O vestido é amarelo.",
      "translation": "Das Kleid ist gelb.",
      "explanation": "amarelo = gelb; vestido = Kleid."
    },
    {
      "id": "karte-07",
      "topic": "Farben und Beschreibungen",
      "expression": "Este livro é novo.",
      "translation": "Dieses Buch ist neu.",
      "explanation": "novo = neu; este = dieser."
    },
    {
      "id": "karte-08",
      "topic": "Farben und Beschreibungen",
      "expression": "A mesa é grande, mas a cadeira é pequena.",
      "translation": "Der Tisch ist groß, aber der Stuhl ist klein.",
      "explanation": "mas = aber; Eigenschaftswörter wie grande und pequena stehen hier nach dem Hauptwort."
    }
  ]
}
