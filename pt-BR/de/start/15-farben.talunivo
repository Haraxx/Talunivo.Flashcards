  "cards": [
    {
      "id": "karte-01",
      "topic": "Farben und Beschreibungen",
      "expression": "branco",
      "translation": "wei\u00DF",
      "example": "O livro \u00E9 branco.",
      "exampleTranslation": "Das Buch ist wei\u00DF.",
      "explanation": "Branco bedeutet wei\u00DF und ist die m\u00E4nnliche Einzahl, passend zu o livro. Bei einem weiblichen Nomen hei\u00DFt es branca, zum Beispiel a casa \u00E9 branca. Beschrieben wird jeweils ein bestimmter Gegenstand.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Farben und Beschreibungen",
      "expression": "preto",
      "translation": "schwarz",
      "example": "O celular \u00E9 preto.",
      "exampleTranslation": "Das Handy ist schwarz.",
      "explanation": "Preto bedeutet schwarz und steht hier in der m\u00E4nnlichen Einzahl wegen o celular. Die weibliche Form ist preta, zum Beispiel a bolsa \u00E9 preta. Entscheidend ist das portugiesische Nomen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Farben und Beschreibungen",
      "expression": "vermelho",
      "translation": "rot",
      "example": "O copo \u00E9 vermelho.",
      "exampleTranslation": "Das Glas ist rot.",
      "explanation": "Vermelho bedeutet rot und ist die m\u00E4nnliche Einzahl, passend zu o copo. Bei einem weiblichen Nomen hei\u00DFt es vermelha, zum Beispiel a porta \u00E9 vermelha. Die Form beschreibt den Gegenstand.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Farben und Beschreibungen",
      "expression": "azul",
      "translation": "blau",
      "example": "O livro \u00E9 azul.",
      "exampleTranslation": "Das Buch ist blau.",
      "explanation": "Azul bedeutet blau und bleibt in der Einzahl bei beiden Genera gleich: o livro \u00E9 azul, a bolsa \u00E9 azul. Die Mehrzahl hei\u00DFt azuis, zum Beispiel livros azuis = blaue B\u00FCcher.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Farben und Beschreibungen",
      "expression": "verde",
      "translation": "gr\u00FCn",
      "example": "A porta \u00E9 verde.",
      "exampleTranslation": "Die T\u00FCr ist gr\u00FCn.",
      "explanation": "Verde bedeutet gr\u00FCn und bleibt in der Einzahl bei m\u00E4nnlichen und weiblichen Nomen gleich. A porta \u00E9 verde hei\u00DFt die T\u00FCr ist gr\u00FCn. Die Mehrzahl lautet verdes, zum Beispiel portas verdes = gr\u00FCne T\u00FCren.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Farben und Beschreibungen",
      "expression": "amarelo",
      "translation": "gelb",
      "example": "O copo \u00E9 amarelo.",
      "exampleTranslation": "Das Glas ist gelb.",
      "explanation": "Amarelo bedeutet gelb und ist die m\u00E4nnliche Einzahl wegen o copo. Die weibliche Form hei\u00DFt amarela, zum Beispiel a bolsa \u00E9 amarela. Der Satz beschreibt ein einzelnes Glas, keine allgemeine Materialfarbe.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Farben und Beschreibungen",
      "expression": "novo",
      "translation": "neu",
      "example": "Este livro \u00E9 novo.",
      "exampleTranslation": "Dieses Buch ist neu.",
      "explanation": "Novo bedeutet beim Buch neu. Die weibliche Form lautet nova, zum Beispiel uma casa nova. In anderen Zusammenh\u00E4ngen kann novo auch jung bedeuten; hier wird die Gegenstandsbedeutung neu ge\u00FCbt.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Farben und Beschreibungen",
      "expression": "grande",
      "translation": "gro\u00DF",
      "example": "A casa \u00E9 grande.",
      "exampleTranslation": "Das Haus ist gro\u00DF.",
      "explanation": "Grande bedeutet gro\u00DF und hat in der Einzahl f\u00FCr beide Genera dieselbe Form: a casa \u00E9 grande, o quarto \u00E9 grande. Die Mehrzahl hei\u00DFt grandes. Eine Beschreibung als gro\u00DF h\u00E4ngt vom jeweiligen Vergleich ab.",
      "isVocabulary": true
    },
    {
      "id": "karte-08-2",
      "topic": "Farben und Beschreibungen",
      "expression": "pequeno",
      "translation": "klein",
      "example": "Meu quarto \u00E9 pequeno.",
      "exampleTranslation": "Mein Zimmer ist klein.",
      "explanation": "Pequeno bedeutet klein und ist m\u00E4nnlich wegen o quarto. Die weibliche Form ist pequena, zum Beispiel minha casa \u00E9 pequena. Die Form richtet sich nach dem portugiesischen Gegenstandswort, nicht nach dem deutschen Zimmer.",
      "isVocabulary": true
    }
  ],
