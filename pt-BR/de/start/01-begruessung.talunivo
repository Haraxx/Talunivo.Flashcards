{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-01-begruessung",
  "packageVersion": 4,
  "title": "01 · Begrüßung und Abschied",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Begrüßung und Abschied",
      "expression": "oi",
      "translation": "hallo",
      "isVocabulary": true,
      "example": "Oi, Ana!",
      "exampleTranslation": "Hallo, Ana!",
      "explanation": "Informelle Begrüßung. Olá bedeutet ebenfalls hallo; beide können bei einer lockeren Begegnung passen."
    },
    {
      "id": "karte-02",
      "topic": "Begrüßung und Abschied",
      "expression": "olá",
      "translation": "hallo",
      "isVocabulary": true,
      "example": "Olá, Pedro!",
      "exampleTranslation": "Hallo, Pedro!",
      "explanation": "Begrüßung wie hallo. Oi ist ebenfalls möglich; die beiden Wörter sind keine gegensätzlichen Bedeutungen."
    },
    {
      "id": "karte-03",
      "topic": "Begrüßung und Abschied",
      "expression": "bom dia",
      "translation": "guten Morgen",
      "isVocabulary": true,
      "example": "Bom dia, Ana!",
      "exampleTranslation": "Guten Morgen, Ana!",
      "explanation": "Begrüßung am Morgen. Bom dia ist eine feste Wendung; lerne die beiden Wörter zusammen."
    },
    {
      "id": "karte-04",
      "topic": "Begrüßung und Abschied",
      "expression": "boa tarde",
      "translation": "guten Tag",
      "isVocabulary": true,
      "example": "Boa tarde, Pedro!",
      "exampleTranslation": "Guten Tag, Pedro!",
      "explanation": "Begrüßung am Nachmittag. Im Deutschen sagt man dafür meist guten Tag. Die Tageszeit entscheidet über die Wahl des Grußes."
    },
    {
      "id": "karte-05",
      "topic": "Begrüßung und Abschied",
      "expression": "boa noite",
      "translation": "guten Abend; gute Nacht",
      "isVocabulary": true,
      "example": "Boa noite, Ana!",
      "exampleTranslation": "Guten Abend, Ana!",
      "explanation": "Zur Begrüßung am Abend: guten Abend. Beim Abschied zur Nacht: gute Nacht. Ohne Situation sind beide Übersetzungen möglich."
    },
    {
      "id": "karte-06",
      "topic": "Begrüßung und Abschied",
      "expression": "até amanhã",
      "translation": "bis morgen",
      "isVocabulary": true,
      "example": "Tchau, Ana! Até amanhã!",
      "exampleTranslation": "Tschüss, Ana! Bis morgen!",
      "explanation": "Até amanhã ist ein Abschied mit Blick auf den nächsten Tag: até = bis, amanhã = morgen. Der Akut in até und die Tilde in amanhã gehören zum Wort."
    },
    {
      "id": "karte-07",
      "topic": "Begrüßung und Abschied",
      "expression": "mais tarde",
      "translation": "später",
      "isVocabulary": true,
      "example": "Até mais tarde, Pedro!",
      "exampleTranslation": "Bis später, Pedro!",
      "explanation": "Mais tarde bedeutet später und ist allein noch kein Abschiedsgruß. Até mais tarde bedeutet bis später."
    },
    {
      "id": "karte-08",
      "topic": "Begrüßung und Abschied",
      "expression": "tchau",
      "translation": "tschüss",
      "isVocabulary": true,
      "example": "Tchau, Pedro!",
      "exampleTranslation": "Tschüss, Pedro!",
      "explanation": "Informeller Abschiedsgruß. Tchau verabschiedet; oi und olá begrüßen. Die Schreibweise beginnt mit tch."
    }
  ]
}
