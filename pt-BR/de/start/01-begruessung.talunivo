  "cards": [
    {
      "id": "karte-01",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "oi",
      "translation": "hallo",
      "example": "Oi, Ana!",
      "exampleTranslation": "Hallo, Ana!",
      "explanation": "Informelle Begr\u00FC\u00DFung. Ol\u00E1 bedeutet ebenfalls hallo; beide k\u00F6nnen bei einer lockeren Begegnung passen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "ol\u00E1",
      "translation": "hallo",
      "example": "Ol\u00E1, Pedro!",
      "exampleTranslation": "Hallo, Pedro!",
      "explanation": "Begr\u00FC\u00DFung wie hallo. Oi ist ebenfalls m\u00F6glich; die beiden W\u00F6rter sind keine gegens\u00E4tzlichen Bedeutungen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "bom dia",
      "translation": "guten Morgen",
      "example": "Bom dia, Ana!",
      "exampleTranslation": "Guten Morgen, Ana!",
      "explanation": "Begr\u00FC\u00DFung am Morgen. Bom dia ist eine feste Wendung; lerne die beiden W\u00F6rter zusammen.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "boa tarde",
      "translation": "guten Tag",
      "example": "Boa tarde, Pedro!",
      "exampleTranslation": "Guten Tag, Pedro!",
      "explanation": "Begr\u00FC\u00DFung am Nachmittag. Im Deutschen sagt man daf\u00FCr meist guten Tag. Die Tageszeit entscheidet \u00FCber die Wahl des Gru\u00DFes.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "boa noite",
      "translation": "guten Abend; gute Nacht",
      "example": "Boa noite, Ana!",
      "exampleTranslation": "Guten Abend, Ana!",
      "explanation": "Zur Begr\u00FC\u00DFung am Abend: guten Abend. Beim Abschied zur Nacht: gute Nacht. Ohne Situation sind beide \u00DCbersetzungen m\u00F6glich.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "at\u00E9 amanh\u00E3",
      "translation": "bis morgen",
      "example": "Tchau, Ana! At\u00E9 amanh\u00E3!",
      "exampleTranslation": "Tsch\u00FCss, Ana! Bis morgen!",
      "explanation": "At\u00E9 amanh\u00E3 ist ein Abschied mit Blick auf den n\u00E4chsten Tag: at\u00E9 = bis, amanh\u00E3 = morgen. Der Akut in at\u00E9 und die Tilde in amanh\u00E3 geh\u00F6ren zum Wort.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "mais tarde",
      "translation": "sp\u00E4ter",
      "example": "At\u00E9 mais tarde, Pedro!",
      "exampleTranslation": "Bis sp\u00E4ter, Pedro!",
      "explanation": "Mais tarde bedeutet sp\u00E4ter und ist allein noch kein Abschiedsgru\u00DF. At\u00E9 mais tarde bedeutet bis sp\u00E4ter.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Begr\u00FC\u00DFung und Abschied",
      "expression": "tchau",
      "translation": "tsch\u00FCss",
      "example": "Tchau, Pedro!",
      "exampleTranslation": "Tsch\u00FCss, Pedro!",
      "explanation": "Informeller Abschiedsgru\u00DF. Tchau verabschiedet; oi und ol\u00E1 begr\u00FC\u00DFen. Die Schreibweise beginnt mit tch.",
      "isVocabulary": true
    }
  ],
