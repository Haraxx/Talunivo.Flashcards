  "cards": [
    {
      "id": "karte-01",
      "topic": "Herkunft und Wohnort",
      "expression": "onde",
      "translation": "wo",
      "isVocabulary": true,
      "example": "De onde você é?",
      "exampleTranslation": "Woher kommst du?",
      "explanation": "Onde allein bedeutet wo. De onde bedeutet woher; De onde você é? fragt hier nach der Herkunft. Onde você mora? fragt dagegen nach dem Wohnort."
    },
    {
      "id": "karte-02",
      "topic": "Herkunft und Wohnort",
      "expression": "Alemanha",
      "translation": "Deutschland",
      "isVocabulary": true,
      "example": "Eu sou da Alemanha.",
      "exampleTranslation": "Ich komme aus Deutschland.",
      "explanation": "A Alemanha ist Deutschland. Da entsteht aus de + a: da Alemanha = aus Deutschland. Eu sou da Alemanha nennt hier die Herkunft, nicht automatisch den aktuellen Wohnort."
    },
    {
      "id": "karte-03",
      "topic": "Herkunft und Wohnort",
      "expression": "Brasil",
      "translation": "Brasilien",
      "isVocabulary": true,
      "example": "Eu sou do Brasil.",
      "exampleTranslation": "Ich komme aus Brasilien.",
      "explanation": "O Brasil ist Brasilien. Do entsteht aus de + o: do Brasil = aus Brasilien. Vergleiche da Alemanha mit do Brasil; der Artikel des Landes ist verschieden."
    },
    {
      "id": "karte-04",
      "topic": "Herkunft und Wohnort",
      "expression": "alemão",
      "translation": "Deutscher",
      "isVocabulary": true,
      "example": "Sou alemão.",
      "exampleTranslation": "Ich bin Deutscher.",
      "explanation": "Hier bezeichnet alemão einen Deutschen; die weibliche Form ist alemã. Sou alemão heißt ich bin Deutscher. In Você fala alemão? aus Paket 05 bezeichnet alemão dagegen die Sprache Deutsch."
    },
    {
      "id": "karte-05",
      "topic": "Herkunft und Wohnort",
      "expression": "brasileira",
      "translation": "Brasilianerin",
      "isVocabulary": true,
      "example": "Sou brasileira.",
      "exampleTranslation": "Ich bin Brasilianerin.",
      "explanation": "Brasileira bezeichnet hier eine Brasilianerin; die männliche Form ist brasileiro. Sou brasileira nennt eine Nationalität. Wohnort und Herkunft können davon verschieden sein."
    },
    {
      "id": "karte-06",
      "topic": "Herkunft und Wohnort",
      "expression": "morar",
      "translation": "wohnen",
      "isVocabulary": true,
      "example": "Onde você mora?",
      "exampleTranslation": "Wo wohnst du?",
      "explanation": "Morar bedeutet wohnen. Bei você heißt es mora: Onde você mora? = Wo wohnst du? Die Antwort kann mit Moro em … beginnen: Ich wohne in …"
    },
    {
      "id": "karte-07",
      "topic": "Herkunft und Wohnort",
      "expression": "Berlim",
      "translation": "Berlin",
      "isVocabulary": true,
      "example": "Moro em Berlim.",
      "exampleTranslation": "Ich wohne in Berlin.",
      "explanation": "Berlim heißt Berlin. Für diesen Städtenamen sagt man em Berlim, ohne Artikel. Moro em Berlim ist ein Muster für den Wohnort; die Herkunft wird damit nicht festgelegt."
    },
    {
      "id": "karte-08",
      "topic": "Herkunft und Wohnort",
      "expression": "cidade",
      "translation": "Stadt",
      "isVocabulary": true,
      "example": "Moro numa cidade pequena.",
      "exampleTranslation": "Ich wohne in einer kleinen Stadt.",
      "explanation": "A cidade, Plural cidades. Numa ist em uma: in einer. Pequena bedeutet klein und bezieht sich hier auf das weibliche Wort cidade. Moro numa cidade pequena beschreibt den Wohnort."
    }
  ]
