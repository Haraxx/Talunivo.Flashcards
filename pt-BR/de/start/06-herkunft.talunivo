      "id": "karte-01",
      "topic": "Herkunft und Wohnort",
      "expression": "onde",
      "translation": "wo",
      "example": "De onde você é?",
      "exampleTranslation": "Woher kommst du?",
      "explanation": "Onde allein bedeutet wo. De onde bedeutet woher; De onde você é? fragt hier nach der Herkunft. Onde você mora? fragt dagegen nach dem Wohnort.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "Õ-dschi",
        "ipa": "[ˈõdʒi]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      },
      "examplePronunciation": {
        "germanHint": "dschi Õ-dschi wo-SSE Ä?",
        "ipa": "[dʒi ˈõdʒi voˈse ɛ]",
