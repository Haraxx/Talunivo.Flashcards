      "expression": "morar",
      "translation": "wohnen",
      "example": "Onde voc\u00EA mora?",
      "exampleTranslation": "Wo wohnst du?",
      "explanation": "Morar bedeutet wohnen. Bei voc\u00EA hei\u00DFt es mora: Onde voc\u00EA mora? = Wo wohnst du? Die Antwort kann mit Moro em \u2026 beginnen: Ich wohne in \u2026",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Herkunft und Wohnort",
      "expression": "Berlim",
      "translation": "Berlin",
      "example": "Moro em Berlim.",
      "exampleTranslation": "Ich wohne in Berlin.",
      "explanation": "Berlim hei\u00DFt Berlin. F\u00FCr diesen St\u00E4dtenamen sagt man em Berlim, ohne Artikel. Moro em Berlim ist ein Muster f\u00FCr den Wohnort; die Herkunft wird damit nicht festgelegt.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Herkunft und Wohnort",
      "expression": "cidade",
      "translation": "Stadt",
      "example": "Moro numa cidade pequena.",
      "exampleTranslation": "Ich wohne in einer kleinen Stadt.",
      "explanation": "A cidade, Plural cidades. Numa ist em uma: in einer. Pequena bedeutet klein und bezieht sich hier auf das weibliche Wort cidade. Moro numa cidade pequena beschreibt den Wohnort.",
      "isVocabulary": true
    }
