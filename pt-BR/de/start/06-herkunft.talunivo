      "expression": "onde",
      "translation": "wo",
      "example": "De onde voc\u00EA \u00E9?",
      "exampleTranslation": "Woher kommst du?",
      "explanation": "Onde allein bedeutet wo. De onde bedeutet woher; De onde voc\u00EA \u00E9? fragt hier nach der Herkunft. Onde voc\u00EA mora? fragt dagegen nach dem Wohnort.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Herkunft und Wohnort",
      "expression": "Alemanha",
      "translation": "Deutschland",
      "example": "Eu sou da Alemanha.",
      "exampleTranslation": "Ich komme aus Deutschland.",
      "explanation": "A Alemanha ist Deutschland. Da entsteht aus de \u002B a: da Alemanha = aus Deutschland. Eu sou da Alemanha nennt hier die Herkunft, nicht automatisch den aktuellen Wohnort.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Herkunft und Wohnort",
      "expression": "Brasil",
