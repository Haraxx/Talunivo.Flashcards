      "id": "karte-08",
      "topic": "Im Café",
      "expression": "conta",
      "translation": "Rechnung",
      "isVocabulary": true,
      "example": "Pode trazer a conta?",
      "exampleTranslation": "Kannst du die Rechnung bringen?",
      "explanation": "A conta bezeichnet hier die Rechnung im Café."
