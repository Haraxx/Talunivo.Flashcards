      "expression": "mesa",
      "translation": "Tisch",
      "isVocabulary": true,
      "example": "Somos duas pessoas. Tem uma mesa livre?",
      "exampleTranslation": "Wir sind zwei Personen. Ist ein Tisch frei?",
      "explanation": "A mesa; livre bedeutet hier frei oder unbesetzt."
    },
    {
      "id": "karte-02",
      "topic": "Im Café",
      "expression": "pessoas",
      "translation": "Personen",
      "isVocabulary": true,
      "example": "Somos duas pessoas.",
      "exampleTranslation": "Wir sind zwei Personen.",
      "explanation": "Plural von a pessoa; duas richtet sich nach dem weiblichen Nomen."
    },
    {
      "id": "karte-03",
      "topic": "Im Café",
      "expression": "cardápio",
      "translation": "Speisekarte",
      "isVocabulary": true,
      "example": "Posso ver o cardápio?",
      "exampleTranslation": "Kann ich die Speisekarte sehen?",
      "explanation": "O cardápio ist in Brasilien die Speisekarte."
    },
    {
      "id": "karte-04",
      "topic": "Im Café",
      "expression": "sanduíche",
      "translation": "Sandwich",
      "isVocabulary": true,
      "example": "Quero um sanduíche de queijo.",
      "exampleTranslation": "Ich möchte ein Käsesandwich.",
      "explanation": "O sanduíche; de queijo bedeutet mit Käse."
    },
    {
      "id": "karte-05",
      "topic": "Im Café",
      "expression": "mais um",
      "translation": "noch ein",
      "isVocabulary": true,
      "example": "Mais um café, por favor.",
      "exampleTranslation": "Noch einen Kaffee, bitte.",
      "explanation": "Männliche Form; vor weiblichen Nomen mais uma."
    },
    {
      "id": "karte-06",
      "topic": "Im Café",
      "expression": "gostoso",
      "translation": "lecker",
      "isVocabulary": true,
      "example": "Está muito gostoso.",
      "exampleTranslation": "Das schmeckt sehr gut.",
      "explanation": "Männliche Form; weiblich gostosa."
    },
    {
      "id": "karte-07",
      "topic": "Im Café",
      "expression": "cartão",
      "translation": "Karte (Zahlung)",
      "isVocabulary": true,
      "example": "Posso pagar com cartão?",
      "exampleTranslation": "Kann ich mit Karte bezahlen?",
      "explanation": "O cartão; hier eine Zahlungskarte."
