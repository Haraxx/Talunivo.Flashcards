{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-18-cafe",
  "packageVersion": 4,
  "title": "18 · Im Café",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Café",
      "expression": "mesa",
      "translation": "Tisch",
      "isVocabulary": true,
      "example": "Tem uma mesa livre?",
      "exampleTranslation": "Ist ein Tisch frei?",
      "explanation": "A mesa, Plural mesas. Tem uma mesa livre? fragt im brasilianischen Alltag nach einem freien Tisch. Livre bedeutet hier frei oder unbesetzt."
    },
    {
      "id": "karte-02",
      "topic": "Im Café",
      "expression": "pessoas",
      "translation": "Personen",
      "isVocabulary": true,
      "example": "Uma mesa para duas pessoas, por favor.",
      "exampleTranslation": "Einen Tisch für zwei Personen, bitte.",
      "explanation": "A pessoa, Plural pessoas. Das Wort ist grammatisch weiblich, unabhängig von den Personen. Daher duas pessoas; vor einem männlichen Nomen heißt es dois."
    },
    {
      "id": "karte-03",
      "topic": "Im Café",
      "expression": "cardápio",
      "translation": "Speisekarte",
      "isVocabulary": true,
      "example": "Posso ver o cardápio, por favor?",
      "exampleTranslation": "Kann ich bitte die Speisekarte sehen?",
      "explanation": "O cardápio, Plural cardápios, ist in Brasilien die Speisekarte. Posso ver …? bedeutet kann ich … sehen? Por favor macht die Bitte ausdrücklich höflich."
    },
    {
      "id": "karte-04",
      "topic": "Im Café",
      "expression": "sanduíche",
      "translation": "Sandwich",
      "isVocabulary": true,
      "example": "Quero um sanduíche de queijo, por favor.",
      "exampleTranslation": "Ich möchte ein Käsesandwich, bitte.",
      "explanation": "O sanduíche, Plural sanduíches. De queijo bedeutet hier mit Käse. Quero … wird bei einer Bestellung als ich möchte … verwendet; por favor ergänzt die höfliche Bitte."
    },
    {
      "id": "karte-05",
      "topic": "Im Café",
      "expression": "mais um",
      "translation": "noch ein",
      "isVocabulary": true,
      "example": "Mais um café, por favor.",
      "exampleTranslation": "Noch einen Kaffee, bitte.",
      "explanation": "Mais um bedeutet noch ein vor einem männlichen Nomen: mais um café. Vor einem weiblichen Nomen: mais uma água. Es geht jeweils um eine zusätzliche Bestellung."
    },
    {
      "id": "karte-06",
      "topic": "Im Café",
      "expression": "gostoso",
      "translation": "lecker",
      "isVocabulary": true,
      "example": "O sanduíche está gostoso.",
      "exampleTranslation": "Das Sandwich schmeckt gut.",
      "explanation": "Gostoso bedeutet lecker oder wohlschmeckend. Die Form richtet sich nach dem Lebensmittel: o sanduíche está gostoso; weiblich a comida está gostosa. Nicht nach der Person, die spricht."
    },
    {
      "id": "karte-07",
      "topic": "Im Café",
      "expression": "cartão",
      "translation": "Karte (Zahlung)",
      "isVocabulary": true,
      "example": "Posso pagar com cartão?",
      "exampleTranslation": "Kann ich mit Karte bezahlen?",
      "explanation": "O cartão, Plural cartões. Hier ist eine Zahlungskarte gemeint. Pagar com cartão bedeutet mit Karte bezahlen; die konkrete Kartenart wird damit noch nicht festgelegt."
    },
    {
      "id": "karte-08",
      "topic": "Im Café",
      "expression": "conta",
      "translation": "Rechnung",
      "isVocabulary": true,
      "example": "A conta, por favor.",
      "exampleTranslation": "Die Rechnung, bitte.",
      "explanation": "A conta, Plural contas. Im Café bezeichnet conta hier die Rechnung. A conta, por favor ist eine kurze höfliche Bitte; sie bedeutet noch nicht, dass schon bezahlt wurde."
    }
  ]
}
