  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Caf\u00E9",
      "expression": "mesa",
      "translation": "Tisch",
      "example": "Tem uma mesa livre?",
      "exampleTranslation": "Ist ein Tisch frei?",
      "explanation": "A mesa, Plural mesas. Tem uma mesa livre? fragt im brasilianischen Alltag nach einem freien Tisch. Livre bedeutet hier frei oder unbesetzt.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Im Caf\u00E9",
      "expression": "pessoas",
      "translation": "Personen",
      "example": "Uma mesa para duas pessoas, por favor.",
      "exampleTranslation": "Einen Tisch f\u00FCr zwei Personen, bitte.",
      "explanation": "A pessoa, Plural pessoas. Das Wort ist grammatisch weiblich, unabh\u00E4ngig von den Personen. Daher duas pessoas; vor einem m\u00E4nnlichen Nomen hei\u00DFt es dois.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Im Caf\u00E9",
      "expression": "card\u00E1pio",
      "translation": "Speisekarte",
      "example": "Posso ver o card\u00E1pio, por favor?",
      "exampleTranslation": "Kann ich bitte die Speisekarte sehen?",
      "explanation": "O card\u00E1pio, Plural card\u00E1pios, ist in Brasilien die Speisekarte. Posso ver \u2026? bedeutet kann ich \u2026 sehen? Por favor macht die Bitte ausdr\u00FCcklich h\u00F6flich.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Im Caf\u00E9",
      "expression": "sandu\u00EDche",
      "translation": "Sandwich",
      "example": "Quero um sandu\u00EDche de queijo, por favor.",
      "exampleTranslation": "Ich m\u00F6chte ein K\u00E4sesandwich, bitte.",
      "explanation": "O sandu\u00EDche, Plural sandu\u00EDches. De queijo bedeutet hier mit K\u00E4se. Quero \u2026 wird bei einer Bestellung als ich m\u00F6chte \u2026 verwendet; por favor erg\u00E4nzt die h\u00F6fliche Bitte.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Im Caf\u00E9",
      "expression": "mais um",
      "translation": "noch ein",
      "example": "Mais um caf\u00E9, por favor.",
      "exampleTranslation": "Noch einen Kaffee, bitte.",
      "explanation": "Mais um bedeutet noch ein vor einem m\u00E4nnlichen Nomen: mais um caf\u00E9. Vor einem weiblichen Nomen: mais uma \u00E1gua. Es geht jeweils um eine zus\u00E4tzliche Bestellung.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Im Caf\u00E9",
      "expression": "gostoso",
      "translation": "lecker",
      "example": "O sandu\u00EDche est\u00E1 gostoso.",
      "exampleTranslation": "Das Sandwich schmeckt gut.",
      "explanation": "Gostoso bedeutet lecker oder wohlschmeckend. Die Form richtet sich nach dem Lebensmittel: o sandu\u00EDche est\u00E1 gostoso; weiblich a comida est\u00E1 gostosa. Nicht nach der Person, die spricht.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Im Caf\u00E9",
      "expression": "cart\u00E3o",
      "translation": "Karte (Zahlung)",
      "example": "Posso pagar com cart\u00E3o?",
      "exampleTranslation": "Kann ich mit Karte bezahlen?",
      "explanation": "O cart\u00E3o, Plural cart\u00F5es. Hier ist eine Zahlungskarte gemeint. Pagar com cart\u00E3o bedeutet mit Karte bezahlen; die konkrete Kartenart wird damit noch nicht festgelegt.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Im Caf\u00E9",
      "expression": "conta",
      "translation": "Rechnung",
      "example": "A conta, por favor.",
      "exampleTranslation": "Die Rechnung, bitte.",
      "explanation": "A conta, Plural contas. Im Caf\u00E9 bezeichnet conta hier die Rechnung. A conta, por favor ist eine kurze h\u00F6fliche Bitte; sie bedeutet noch nicht, dass schon bezahlt wurde.",
      "isVocabulary": true
    }
  ],
