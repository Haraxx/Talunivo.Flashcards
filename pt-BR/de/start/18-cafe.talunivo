{
  "format": "talunivo",
  "schemaVersion": 1,
  "packageId": "start-ptbr-18-cafe",
  "packageVersion": 1,
  "title": "18 · Im Café",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Café",
      "expression": "Tem uma mesa livre?",
      "translation": "Ist ein Tisch frei?",
      "explanation": "livre = frei, also nicht besetzt.",
      "example": "Somos duas pessoas. Tem uma mesa livre?",
      "exampleTranslation": "Wir sind zwei Personen. Ist ein Tisch frei?"
    },
    {
      "id": "karte-02",
      "topic": "Im Café",
      "expression": "Somos duas pessoas.",
      "translation": "Wir sind zwei Personen.",
      "explanation": "somos = wir sind; duas zu pessoas."
    },
    {
      "id": "karte-03",
      "topic": "Im Café",
      "expression": "Posso ver o cardápio?",
      "translation": "Kann ich die Speisekarte sehen?",
      "explanation": "cardápio heißt in Brasilien Speise- oder Getränkekarte."
    },
    {
      "id": "karte-04",
      "topic": "Im Café",
      "expression": "Quero um sanduíche de queijo.",
      "translation": "Ich möchte ein Käsesandwich.",
      "explanation": "de queijo = mit Käse."
    },
    {
      "id": "karte-05",
      "topic": "Im Café",
      "expression": "Mais um café, por favor.",
      "translation": "Noch einen Kaffee, bitte.",
      "explanation": "mais um = noch einen."
    },
    {
      "id": "karte-06",
      "topic": "Im Café",
      "expression": "Está muito gostoso.",
      "translation": "Das schmeckt sehr gut.",
      "explanation": "gostoso beschreibt hier etwas Leckeres."
    },
    {
      "id": "karte-07",
      "topic": "Im Café",
      "expression": "Posso pagar com cartão?",
      "translation": "Kann ich mit Karte bezahlen?",
      "explanation": "pagar = bezahlen; cartão = Karte."
    },
    {
      "id": "karte-08",
      "topic": "Im Café",
      "expression": "Pode trazer a conta?",
      "translation": "Kannst du die Rechnung bringen?",
      "explanation": "trazer = bringen; conta = Rechnung."
    }
  ]
}
