  "cards": [
    {
      "id": "karte-01",
      "topic": "Zu Hause",
      "expression": "casa",
      "translation": "Haus",
      "example": "Minha casa \u00E9 pequena.",
      "exampleTranslation": "Mein Haus ist klein.",
      "explanation": "A casa, Plural casas. Minha casa bedeutet mein Haus; pequena ist die weibliche Form von klein und bezieht sich auf casa. Em casa hei\u00DFt dagegen zu Hause und bezeichnet nicht zwingend ein eigenes Haus.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Zu Hause",
      "expression": "apartamento",
      "translation": "Wohnung",
      "example": "Meu apartamento \u00E9 pequeno.",
      "exampleTranslation": "Meine Wohnung ist klein.",
      "explanation": "O apartamento, Plural apartamentos, bezeichnet eine Wohnung. Pequeno richtet sich nach dem m\u00E4nnlichen portugiesischen Wort apartamento, obwohl Wohnung im Deutschen weiblich ist.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Zu Hause",
      "expression": "cozinha",
      "translation": "K\u00FCche",
      "example": "A cozinha fica aqui.",
      "exampleTranslation": "Die K\u00FCche ist hier.",
      "explanation": "A cozinha, Plural cozinhas. Fica beschreibt hier, wo sich ein Raum befindet. Aqui bedeutet hier. A cozinha fica aqui zeigt die Lage der K\u00FCche, nicht eine Bewegung.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Zu Hause",
      "expression": "banheiro",
      "translation": "Badezimmer; Toilette",
      "example": "O banheiro fica ali.",
      "exampleTranslation": "Das Badezimmer ist dort.",
      "explanation": "O banheiro, Plural banheiros. Im Wohnkontext ist ein Badezimmer gemeint; bei einer Ortsfrage kann auch Toilette die passende deutsche Fassung sein. Ali bedeutet dort; fica beschreibt hier die Lage.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Zu Hause",
      "expression": "quarto",
      "translation": "Zimmer",
      "example": "Meu quarto tem uma janela.",
      "exampleTranslation": "Mein Zimmer hat ein Fenster.",
      "explanation": "O quarto, Plural quartos. Zu Hause ist oft das Schlafzimmer gemeint; im Hotel ein G\u00E4stezimmer. Tem uma janela bedeutet hat ein Fenster. Quarto ist keine allgemeine Bezeichnung f\u00FCr jede Art von Raum.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Zu Hause",
      "expression": "sala",
      "translation": "Wohnzimmer",
      "example": "A sala \u00E9 grande.",
      "exampleTranslation": "Das Wohnzimmer ist gro\u00DF.",
      "explanation": "A sala, Plural salas. Im Beispiel zu Hause bedeutet sala Wohnzimmer; sala de estar ist die ausdr\u00FCckliche Bezeichnung. In anderen Zusammenh\u00E4ngen kann sala auch einen anderen Raum oder Saal bezeichnen. Grande bedeutet gro\u00DF.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Zu Hause",
      "expression": "fam\u00EDlia",
      "translation": "Familie",
      "example": "Moro com minha fam\u00EDlia.",
      "exampleTranslation": "Ich wohne mit meiner Familie.",
      "explanation": "A fam\u00EDlia, Plural fam\u00EDlias. Com minha fam\u00EDlia hei\u00DFt mit meiner Familie. Moro aus dem Wohnortpaket bedeutet ich wohne. Der Satz beschreibt eine m\u00F6gliche Wohnsituation; zum \u00DCben kann sie erfunden sein.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Zu Hause",
      "expression": "porta",
      "translation": "T\u00FCr",
      "example": "A porta est\u00E1 aberta.",
      "exampleTranslation": "Die T\u00FCr ist offen.",
      "explanation": "A porta, Plural portas. Est\u00E1 aberta beschreibt den Zustand ist offen. Aberta ist weiblich, weil porta weiblich ist; die m\u00E4nnliche Form w\u00E4re aberto. Die Form bezieht sich auf die T\u00FCr, nicht auf die sprechende Person.",
      "isVocabulary": true
    }
  ],
