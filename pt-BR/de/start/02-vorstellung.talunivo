      "id": "karte-01",
      "topic": "Name und Vorstellung",
      "expression": "nome",
      "translation": "Name",
      "isVocabulary": true,
      "example": "Meu nome é Lucas. E o seu?",
      "exampleTranslation": "Mein Name ist Lucas. Und deiner?",
      "explanation": "O nome; Plural nomes."
    },
    {
      "id": "karte-02",
      "topic": "Name und Vorstellung",
      "expression": "chamar-se",
      "translation": "sich nennen; heißen",
      "isVocabulary": true,
      "example": "Eu me chamo Lucas.",
      "exampleTranslation": "Ich heiße Lucas.",
      "explanation": "Eu me chamo bedeutet ich heiße; me gehört zum Verb."
    },
    {
      "id": "karte-03",
      "topic": "Name und Vorstellung",
      "expression": "você",
      "translation": "du; Sie",
      "isVocabulary": true,
      "example": "Como você se chama?",
      "exampleTranslation": "Wie heißt du?",
      "explanation": "Você steht mit der dritten Person Singular; die passende deutsche Anrede hängt vom Kontext ab."
    },
    {
      "id": "karte-04",
      "topic": "Name und Vorstellung",
      "expression": "qual",
      "translation": "welcher; welche; welches",
      "isVocabulary": true,
      "example": "Qual é o seu nome?",
      "exampleTranslation": "Wie ist dein Name?",
      "explanation": "Bei Fragen: Qual é o seu nome? = Wie heißt du?"
    },
    {
      "id": "karte-05",
      "topic": "Name und Vorstellung",
      "expression": "prazer",
      "translation": "Vergnügen",
      "isVocabulary": true,
      "example": "Prazer em conhecer você.",
      "exampleTranslation": "Freut mich, dich kennenzulernen.",
      "explanation": "Prazer! ist bei einer Vorstellung etwa freut mich."
    },
    {
      "id": "karte-06",
      "topic": "Name und Vorstellung",
      "expression": "este",
      "translation": "dieser",
      "isVocabulary": true,
      "example": "Este é o Pedro.",
      "exampleTranslation": "Das ist Pedro.",
      "explanation": "Männliche Form; weiblich esta."
    },
    {
      "id": "karte-07",
      "topic": "Name und Vorstellung",
      "expression": "amiga",
      "translation": "Freundin",
      "isVocabulary": true,
      "example": "Esta é a minha amiga.",
      "exampleTranslation": "Das ist meine Freundin.",
      "explanation": "A amiga; männlich o amigo. Kann auch eine platonische Freundin sein."
    },
    {
      "id": "karte-08",
      "topic": "Name und Vorstellung",
      "expression": "chamar",
      "translation": "rufen; nennen",
      "isVocabulary": true,
      "example": "Pode me chamar de Bia.",
      "exampleTranslation": "Du kannst mich Bia nennen.",
      "explanation": "Chamar alguém de … bedeutet jemanden … nennen."
