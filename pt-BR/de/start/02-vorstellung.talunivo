  "title": "02 · Name und Vorstellung",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Name und Vorstellung",
      "expression": "nome",
      "translation": "Name",
      "isVocabulary": true,
      "example": "Meu nome é Ana.",
      "exampleTranslation": "Mein Name ist Ana.",
      "explanation": "O nome, Plural nomes. Meu nome é … bedeutet mein Name ist … Ersetze Ana durch deinen Namen."
    },
    {
      "id": "karte-02",
      "topic": "Name und Vorstellung",
      "expression": "chamar-se",
      "translation": "sich nennen; heißen",
      "isVocabulary": true,
      "example": "Eu me chamo Pedro.",
      "exampleTranslation": "Ich heiße Pedro.",
      "explanation": "Chamar-se heißt sich nennen oder heißen. Für die eigene Vorstellung: eu me chamo … Das me gehört hier zum Verb; lerne das Muster zusammen."
    },
    {
      "id": "karte-03",
      "topic": "Name und Vorstellung",
      "expression": "você",
      "translation": "du; Sie",
      "isVocabulary": true,
      "example": "Como você se chama?",
      "exampleTranslation": "Wie heißt du?",
      "explanation": "Você wird hier mit du übersetzt und verwendet die dritte Person Singular: você se chama. Die passende deutsche Anrede hängt von der Situation ab; eine förmliche Anrede wird gesondert geübt."
    },
    {
      "id": "karte-04",
      "topic": "Name und Vorstellung",
      "expression": "qual",
      "translation": "welcher; welche; welches",
      "isVocabulary": true,
      "example": "Qual é o seu nome?",
      "exampleTranslation": "Wie heißt du?",
      "explanation": "Qual bedeutet je nach Zusammenhang welcher, welche oder welches. Qual é o seu nome? ist eine übliche Frage nach dem Namen; auf Deutsch natürlich: Wie heißt du?"
    },
    {
      "id": "karte-05",
      "topic": "Name und Vorstellung",
      "expression": "prazer",
      "translation": "Vergnügen",
      "isVocabulary": true,
      "example": "Prazer, Ana!",
      "exampleTranslation": "Freut mich, Ana!",
      "explanation": "O prazer bedeutet wörtlich das Vergnügen. Bei einer Vorstellung heißt Prazer! sinngemäß freut mich. Die passende Antwort kann ebenfalls Prazer! sein."
    },
    {
      "id": "karte-06",
      "topic": "Name und Vorstellung",
      "expression": "este",
      "translation": "dieser",
      "isVocabulary": true,
      "example": "Este é o Pedro.",
      "exampleTranslation": "Das ist Pedro.",
      "explanation": "Este ist die männliche Form, esta die weibliche. Este é o Pedro bedeutet das ist Pedro. O vor einem Personennamen kommt in Brasilien vor; der Gebrauch ist regional unterschiedlich."
    },
    {
      "id": "karte-07",
      "topic": "Name und Vorstellung",
      "expression": "amiga",
      "translation": "Freundin",
      "isVocabulary": true,
      "example": "Esta é a minha amiga Ana.",
      "exampleTranslation": "Das ist meine Freundin Ana.",
      "explanation": "A amiga, Plural amigas; männlich o amigo. Minha amiga kann eine platonische Freundin bezeichnen. Esta ist hier die weibliche Form von este."
    },
    {
      "id": "karte-08",
      "topic": "Name und Vorstellung",
      "expression": "chamar",
      "translation": "rufen; nennen",
      "isVocabulary": true,
      "example": "Pode me chamar de Bia.",
      "exampleTranslation": "Du kannst mich Bia nennen.",
      "explanation": "Chamar heißt rufen oder nennen. Chamar alguém de … bedeutet jemanden … nennen. Pode me chamar de … nennt den gewünschten Rufnamen; Eu me chamo … stellt den eigenen Namen vor."
    }
  ]
}
