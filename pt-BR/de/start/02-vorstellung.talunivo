  "title": "02 \u00B7 Name und Vorstellung",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Name und Vorstellung",
      "expression": "nome",
      "translation": "Name",
      "example": "Meu nome \u00E9 Ana.",
      "exampleTranslation": "Mein Name ist Ana.",
      "explanation": "O nome, Plural nomes. Meu nome \u00E9 \u2026 bedeutet mein Name ist \u2026 Ersetze Ana durch deinen Namen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Name und Vorstellung",
      "expression": "chamar-se",
      "translation": "sich nennen; hei\u00DFen",
      "example": "Eu me chamo Pedro.",
      "exampleTranslation": "Ich hei\u00DFe Pedro.",
      "explanation": "Chamar-se hei\u00DFt sich nennen oder hei\u00DFen. F\u00FCr die eigene Vorstellung: eu me chamo \u2026 Das me geh\u00F6rt hier zum Verb; lerne das Muster zusammen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Name und Vorstellung",
      "expression": "voc\u00EA",
      "translation": "du; Sie",
      "example": "Como voc\u00EA se chama?",
      "exampleTranslation": "Wie hei\u00DFt du?",
      "explanation": "Voc\u00EA wird hier mit du \u00FCbersetzt und verwendet die dritte Person Singular: voc\u00EA se chama. Die passende deutsche Anrede h\u00E4ngt von der Situation ab; eine f\u00F6rmliche Anrede wird gesondert ge\u00FCbt.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Name und Vorstellung",
      "expression": "qual",
      "translation": "welcher; welche; welches",
      "example": "Qual \u00E9 o seu nome?",
      "exampleTranslation": "Wie hei\u00DFt du?",
      "explanation": "Qual bedeutet je nach Zusammenhang welcher, welche oder welches. Qual \u00E9 o seu nome? ist eine \u00FCbliche Frage nach dem Namen; auf Deutsch nat\u00FCrlich: Wie hei\u00DFt du?",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Name und Vorstellung",
      "expression": "prazer",
      "translation": "Vergn\u00FCgen",
      "example": "Prazer, Ana!",
      "exampleTranslation": "Freut mich, Ana!",
      "explanation": "O prazer bedeutet w\u00F6rtlich das Vergn\u00FCgen. Bei einer Vorstellung hei\u00DFt Prazer! sinngem\u00E4\u00DF freut mich. Die passende Antwort kann ebenfalls Prazer! sein.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Name und Vorstellung",
      "expression": "este",
      "translation": "dieser",
      "example": "Este \u00E9 o Pedro.",
      "exampleTranslation": "Das ist Pedro.",
      "explanation": "Este ist die m\u00E4nnliche Form, esta die weibliche. Este \u00E9 o Pedro bedeutet das ist Pedro. O vor einem Personennamen kommt in Brasilien vor; der Gebrauch ist regional unterschiedlich.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Name und Vorstellung",
      "expression": "amiga",
      "translation": "Freundin",
      "example": "Esta \u00E9 a minha amiga Ana.",
      "exampleTranslation": "Das ist meine Freundin Ana.",
      "explanation": "A amiga, Plural amigas; m\u00E4nnlich o amigo. Minha amiga kann eine platonische Freundin bezeichnen. Esta ist hier die weibliche Form von este.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Name und Vorstellung",
      "expression": "chamar",
      "translation": "rufen; nennen",
      "example": "Pode me chamar de Bia.",
      "exampleTranslation": "Du kannst mich Bia nennen.",
      "explanation": "Chamar hei\u00DFt rufen oder nennen. Chamar algu\u00E9m de \u2026 bedeutet jemanden \u2026 nennen. Pode me chamar de \u2026 nennt den gew\u00FCnschten Rufnamen; Eu me chamo \u2026 stellt den eigenen Namen vor.",
      "isVocabulary": true
    }
  ],
