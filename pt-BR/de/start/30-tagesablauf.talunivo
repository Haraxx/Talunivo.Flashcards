  "cards": [
    {
      "id": "karte-01",
      "topic": "Mein Tagesablauf",
      "expression": "acordar",
      "translation": "aufwachen",
      "isVocabulary": true,
      "example": "Acordo às sete e almoço ao meio-dia.",
      "exampleTranslation": "Ich wache um sieben auf und esse um zwölf Uhr mittags zu Mittag.",
      "explanation": "Acordo = ich wache auf; aufstehen heißt levantar."
    },
    {
      "id": "karte-02",
      "topic": "Mein Tagesablauf",
      "expression": "levantar",
      "translation": "aufstehen",
      "isVocabulary": true,
      "example": "Levanto cedo.",
      "exampleTranslation": "Ich stehe früh auf.",
      "explanation": "Levanto = ich stehe auf; reflexiv auch me levanto."
    },
    {
      "id": "karte-03",
      "topic": "Mein Tagesablauf",
      "expression": "tomar banho",
      "translation": "duschen; baden",
      "isVocabulary": true,
      "example": "Tomo banho de manhã.",
      "exampleTranslation": "Ich dusche morgens.",
      "explanation": "In Brasilien übliche Wendung für duschen oder baden."
    },
    {
      "id": "karte-04",
      "topic": "Mein Tagesablauf",
      "expression": "escovar",
      "translation": "putzen; bürsten",
      "isVocabulary": true,
      "example": "Escovo os dentes.",
      "exampleTranslation": "Ich putze mir die Zähne.",
      "explanation": "Escovar os dentes = die Zähne putzen."
    },
    {
      "id": "karte-05",
      "topic": "Mein Tagesablauf",
      "expression": "almoçar",
      "translation": "zu Mittag essen",
      "isVocabulary": true,
      "example": "Almoço ao meio-dia.",
      "exampleTranslation": "Ich esse um zwölf Uhr mittags zu Mittag.",
      "explanation": "Almoço ist hier die Verbform ich esse zu Mittag."
    },
    {
      "id": "karte-06",
      "topic": "Mein Tagesablauf",
      "expression": "voltar",
      "translation": "zurückkommen",
      "isVocabulary": true,
      "example": "Volto para casa às seis.",
      "exampleTranslation": "Ich komme um sechs nach Hause zurück.",
      "explanation": "Volto = ich komme zurück; para casa = nach Hause."
    },
    {
      "id": "karte-07",
      "topic": "Mein Tagesablauf",
      "expression": "jantar",
      "translation": "zu Abend essen",
      "isVocabulary": true,
      "example": "Janto com minha família.",
      "exampleTranslation": "Ich esse mit meiner Familie zu Abend.",
      "explanation": "Janto = ich esse zu Abend."
    },
    {
      "id": "karte-08",
      "topic": "Mein Tagesablauf",
      "expression": "dormir",
      "translation": "schlafen",
      "isVocabulary": true,
      "example": "Vou dormir às dez da noite.",
      "exampleTranslation": "Ich gehe um zehn Uhr abends schlafen.",
      "explanation": "Vou dormir = ich gehe schlafen."
    }
  ]
