    {
      "id": "karte-01",
      "topic": "Mein Tagesablauf",
      "expression": "acordar",
      "translation": "aufwachen",
      "example": "Acordo \u00E0s sete.",
      "exampleTranslation": "Ich wache um sieben auf.",
      "explanation": "Acordar bedeutet aufwachen; acordo hei\u00DFt ich wache auf. \u00C0s sete ist um sieben Uhr. Aufstehen ist eine andere T\u00E4tigkeit und hei\u00DFt hier levantar; beides muss nicht gleichzeitig geschehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Mein Tagesablauf",
      "expression": "levantar",
      "translation": "aufstehen",
      "example": "Levanto cedo.",
      "exampleTranslation": "Ich stehe fr\u00FCh auf.",
      "explanation": "Levantar bedeutet im Tagesablauf hier aufstehen; levanto hei\u00DFt ich stehe auf. Cedo bedeutet fr\u00FCh. Auch Me levanto cedo. ist eine m\u00F6gliche Formulierung; sie soll nicht allein wegen me als falsch bewertet werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Mein Tagesablauf",
      "expression": "tomar banho",
      "translation": "duschen; baden",
      "example": "Tomo banho de manh\u00E3.",
      "exampleTranslation": "Ich dusche morgens.",
      "explanation": "Tomar banho ist in Brasilien eine \u00FCbliche Wendung f\u00FCr duschen oder baden. Tomo banho hei\u00DFt hier ich dusche; de manh\u00E3 bedeutet morgens. Ohne genaueren Zusammenhang kann auch ich bade eine passende deutsche Deutung sein.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Mein Tagesablauf",
      "expression": "escovar",
      "translation": "putzen; b\u00FCrsten",
      "example": "Escovo os dentes.",
      "exampleTranslation": "Ich putze mir die Z\u00E4hne.",
      "explanation": "Escovar bedeutet b\u00FCrsten beziehungsweise mit einer B\u00FCrste putzen. Escovo hei\u00DFt ich putze hier; os dentes sind die Z\u00E4hne. Escovar os dentes ist die feste Verbindung die Z\u00E4hne putzen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Mein Tagesablauf",
      "expression": "almo\u00E7ar",
      "translation": "zu Mittag essen",
      "example": "Almo\u00E7o ao meio-dia.",
      "exampleTranslation": "Ich esse um zw\u00F6lf Uhr mittags zu Mittag.",
      "explanation": "Almo\u00E7ar bedeutet zu Mittag essen. Almo\u00E7o ist hier die Verbform ich esse zu Mittag; o almo\u00E7o w\u00E4re das Mittagessen als Nomen. Ao meio-dia bedeutet um zw\u00F6lf Uhr mittags und greift die bekannte Zeitangabe auf.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Mein Tagesablauf",
      "expression": "voltar",
      "translation": "zur\u00FCckkommen",
      "example": "Volto para casa \u00E0s seis.",
      "exampleTranslation": "Ich komme um sechs nach Hause zur\u00FCck.",
      "explanation": "Voltar bedeutet zur\u00FCckkommen; volto hei\u00DFt ich komme zur\u00FCck. Para casa ist nach Hause, \u00E0s seis um sechs Uhr. Ohne weiteren Tageszusatz legt die Uhrzeit allein nicht fest, ob morgens oder abends gemeint ist.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Mein Tagesablauf",
      "expression": "jantar",
      "translation": "zu Abend essen",
      "example": "Janto com minha fam\u00EDlia.",
      "exampleTranslation": "Ich esse mit meiner Familie zu Abend.",
      "explanation": "Jantar bedeutet zu Abend essen; janto hei\u00DFt ich esse zu Abend. Com minha fam\u00EDlia ist mit meiner Familie. Der Satz beschreibt eine m\u00F6gliche, frei erfundene Routine und setzt kein bestimmtes Zusammenleben voraus.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Mein Tagesablauf",
      "expression": "dormir",
      "translation": "schlafen",
      "example": "Vou dormir \u00E0s dez da noite.",
      "exampleTranslation": "Ich gehe um zehn Uhr abends schlafen.",
      "explanation": "Dormir bedeutet schlafen. Vou dormir hei\u00DFt hier ich gehe schlafen. \u00C0s dez da noite ist um zehn Uhr abends, also 22 Uhr; der Zusatz da noite macht die Tagesh\u00E4lfte ausdr\u00FCcklich klar.",
      "isVocabulary": true
    }
  ],
