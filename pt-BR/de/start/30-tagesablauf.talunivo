      "id": "karte-01",
      "topic": "Mein Tagesablauf",
      "expression": "acordar",
      "translation": "aufwachen",
      "isVocabulary": true,
      "example": "Acordo às sete.",
      "exampleTranslation": "Ich wache um sieben auf.",
      "explanation": "Acordar bedeutet aufwachen; acordo heißt ich wache auf. Às sete ist um sieben Uhr. Aufstehen ist eine andere Tätigkeit und heißt hier levantar; beides muss nicht gleichzeitig geschehen."
    },
    {
      "id": "karte-02",
      "topic": "Mein Tagesablauf",
      "expression": "levantar",
      "translation": "aufstehen",
      "isVocabulary": true,
      "example": "Levanto cedo.",
      "exampleTranslation": "Ich stehe früh auf.",
      "explanation": "Levantar bedeutet im Tagesablauf hier aufstehen; levanto heißt ich stehe auf. Cedo bedeutet früh. Auch Me levanto cedo. ist eine mögliche Formulierung; sie soll nicht allein wegen me als falsch bewertet werden."
    },
    {
      "id": "karte-03",
      "topic": "Mein Tagesablauf",
      "expression": "tomar banho",
      "translation": "duschen; baden",
      "isVocabulary": true,
      "example": "Tomo banho de manhã.",
      "exampleTranslation": "Ich dusche morgens.",
      "explanation": "Tomar banho ist in Brasilien eine übliche Wendung für duschen oder baden. Tomo banho heißt hier ich dusche; de manhã bedeutet morgens. Ohne genaueren Zusammenhang kann auch ich bade eine passende deutsche Deutung sein."
    },
    {
      "id": "karte-04",
      "topic": "Mein Tagesablauf",
      "expression": "escovar",
      "translation": "putzen; bürsten",
      "isVocabulary": true,
      "example": "Escovo os dentes.",
      "exampleTranslation": "Ich putze mir die Zähne.",
      "explanation": "Escovar bedeutet bürsten beziehungsweise mit einer Bürste putzen. Escovo heißt ich putze hier; os dentes sind die Zähne. Escovar os dentes ist die feste Verbindung die Zähne putzen."
    },
    {
      "id": "karte-05",
      "topic": "Mein Tagesablauf",
      "expression": "almoçar",
      "translation": "zu Mittag essen",
      "isVocabulary": true,
      "example": "Almoço ao meio-dia.",
      "exampleTranslation": "Ich esse um zwölf Uhr mittags zu Mittag.",
      "explanation": "Almoçar bedeutet zu Mittag essen. Almoço ist hier die Verbform ich esse zu Mittag; o almoço wäre das Mittagessen als Nomen. Ao meio-dia bedeutet um zwölf Uhr mittags und greift die bekannte Zeitangabe auf."
    },
    {
      "id": "karte-06",
      "topic": "Mein Tagesablauf",
      "expression": "voltar",
      "translation": "zurückkommen",
      "isVocabulary": true,
      "example": "Volto para casa às seis.",
      "exampleTranslation": "Ich komme um sechs nach Hause zurück.",
      "explanation": "Voltar bedeutet zurückkommen; volto heißt ich komme zurück. Para casa ist nach Hause, às seis um sechs Uhr. Ohne weiteren Tageszusatz legt die Uhrzeit allein nicht fest, ob morgens oder abends gemeint ist."
    },
    {
      "id": "karte-07",
      "topic": "Mein Tagesablauf",
      "expression": "jantar",
      "translation": "zu Abend essen",
      "isVocabulary": true,
      "example": "Janto com minha família.",
      "exampleTranslation": "Ich esse mit meiner Familie zu Abend.",
      "explanation": "Jantar bedeutet zu Abend essen; janto heißt ich esse zu Abend. Com minha família ist mit meiner Familie. Der Satz beschreibt eine mögliche, frei erfundene Routine und setzt kein bestimmtes Zusammenleben voraus."
    },
    {
      "id": "karte-08",
      "topic": "Mein Tagesablauf",
      "expression": "dormir",
      "translation": "schlafen",
      "isVocabulary": true,
      "example": "Vou dormir às dez da noite.",
      "exampleTranslation": "Ich gehe um zehn Uhr abends schlafen.",
      "explanation": "Dormir bedeutet schlafen. Vou dormir heißt hier ich gehe schlafen. Às dez da noite ist um zehn Uhr abends, also 22 Uhr; der Zusatz da noite macht die Tageshälfte ausdrücklich klar."
    }
  ]
