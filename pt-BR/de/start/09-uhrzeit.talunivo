    {
      "id": "karte-01",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "hora",
      "translation": "Stunde; Uhrzeit",
      "example": "Que horas s\u00E3o?",
      "exampleTranslation": "Wie sp\u00E4t ist es?",
      "explanation": "A hora, Plural horas. Que horas s\u00E3o? ist die feste Frage nach der Uhrzeit. Hora kann auch eine Zeitdauer von einer Stunde bezeichnen; hier geht es um die Uhrzeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "uma hora",
      "translation": "ein Uhr",
      "example": "\u00C9 uma hora.",
      "exampleTranslation": "Es ist ein Uhr.",
      "explanation": "F\u00FCr ein Uhr sagt man \u00C9 uma hora, mit \u00E9 im Singular. Hora ist weiblich, deshalb uma. In einer anderen Satzumgebung kann uma hora eine Stunde Dauer bedeuten; hier wird ein Uhr angegeben.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "duas horas",
      "translation": "zwei Uhr",
      "example": "S\u00E3o duas horas.",
      "exampleTranslation": "Es ist zwei Uhr.",
      "explanation": "F\u00FCr zwei Uhr sagt man S\u00E3o duas horas, mit s\u00E3o im Plural. Horas ist weiblich, deshalb duas. Vergleiche \u00C9 uma hora f\u00FCr ein Uhr mit S\u00E3o duas horas f\u00FCr zwei Uhr.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "meia",
      "translation": "halb",
      "example": "S\u00E3o tr\u00EAs e meia.",
      "exampleTranslation": "Es ist halb vier.",
      "explanation": "Bei Uhrzeiten bedeutet e meia eine halbe Stunde nach der genannten Stunde. Tr\u00EAs e meia ist 3:30, auf Deutsch halb vier. Meia bezieht sich auf die weibliche hora; es hei\u00DFt hier nicht meio.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "quinze",
      "translation": "f\u00FCnfzehn",
      "example": "S\u00E3o quatro e quinze.",
      "exampleTranslation": "Es ist Viertel nach vier.",
      "explanation": "Quinze ist 15. Bei S\u00E3o quatro e quinze sind f\u00FCnfzehn Minuten nach vier gemeint: 4:15 oder Viertel nach vier. Die Zahl aus dem Preispaket wird hier f\u00FCr Minuten verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "dez para",
      "translation": "zehn vor (bei Uhrzeiten)",
      "example": "S\u00E3o dez para as cinco.",
      "exampleTranslation": "Es ist zehn vor f\u00FCnf.",
      "explanation": "Dez para as cinco bedeutet zehn Minuten vor f\u00FCnf, also 4:50. Die Zielstunde steht nach para as. Dez para allein nennt noch keine vollst\u00E4ndige Uhrzeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "aula",
      "translation": "Unterricht",
      "example": "A aula come\u00E7a \u00E0s oito.",
      "exampleTranslation": "Der Unterricht beginnt um acht.",
      "explanation": "A aula, Plural aulas. Come\u00E7a bedeutet beginnt; \u00E0s oito hei\u00DFt um acht Uhr. Vergleiche S\u00E3o oito horas = Es ist acht Uhr mit \u00E0s oito = um acht Uhr. F\u00FCr um ein Uhr hei\u00DFt es \u00E0 uma.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "meio-dia",
      "translation": "Mittag; zw\u00F6lf Uhr mittags",
      "example": "\u00C9 meio-dia.",
      "exampleTranslation": "Es ist zw\u00F6lf Uhr mittags.",
      "explanation": "O meio-dia bezeichnet Mittag, also zw\u00F6lf Uhr mittags. \u00C9 meio-dia nennt die Uhrzeit. Ao meio-dia bedeutet dagegen um zw\u00F6lf Uhr mittags und nennt einen Zeitpunkt f\u00FCr eine Handlung.",
      "isVocabulary": true
    }
  ],
