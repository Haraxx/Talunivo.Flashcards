  "title": "09 · Uhrzeit und Verabredungen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "hora",
      "translation": "Stunde; Uhrzeit",
      "isVocabulary": true,
      "example": "Que horas são?",
      "exampleTranslation": "Wie spät ist es?",
      "explanation": "A hora, Plural horas. Que horas são? ist die feste Frage nach der Uhrzeit. Hora kann auch eine Zeitdauer von einer Stunde bezeichnen; hier geht es um die Uhrzeit."
    },
    {
      "id": "karte-02",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "uma hora",
      "translation": "ein Uhr",
      "isVocabulary": true,
      "example": "É uma hora.",
      "exampleTranslation": "Es ist ein Uhr.",
      "explanation": "Für ein Uhr sagt man É uma hora, mit é im Singular. Hora ist weiblich, deshalb uma. In einer anderen Satzumgebung kann uma hora eine Stunde Dauer bedeuten; hier wird ein Uhr angegeben."
    },
    {
      "id": "karte-03",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "duas horas",
      "translation": "zwei Uhr",
      "isVocabulary": true,
      "example": "São duas horas.",
      "exampleTranslation": "Es ist zwei Uhr.",
      "explanation": "Für zwei Uhr sagt man São duas horas, mit são im Plural. Horas ist weiblich, deshalb duas. Vergleiche É uma hora für ein Uhr mit São duas horas für zwei Uhr."
    },
    {
      "id": "karte-04",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "meia",
      "translation": "halb",
      "isVocabulary": true,
      "example": "São três e meia.",
      "exampleTranslation": "Es ist halb vier.",
      "explanation": "Bei Uhrzeiten bedeutet e meia eine halbe Stunde nach der genannten Stunde. Três e meia ist 3:30, auf Deutsch halb vier. Meia bezieht sich auf die weibliche hora; es heißt hier nicht meio."
    },
    {
      "id": "karte-05",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "quinze",
      "translation": "fünfzehn",
      "isVocabulary": true,
      "example": "São quatro e quinze.",
      "exampleTranslation": "Es ist Viertel nach vier.",
      "explanation": "Quinze ist 15. Bei São quatro e quinze sind fünfzehn Minuten nach vier gemeint: 4:15 oder Viertel nach vier. Die Zahl aus dem Preispaket wird hier für Minuten verwendet."
    },
    {
      "id": "karte-06",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "dez para",
      "translation": "zehn vor (bei Uhrzeiten)",
      "isVocabulary": true,
      "example": "São dez para as cinco.",
      "exampleTranslation": "Es ist zehn vor fünf.",
      "explanation": "Dez para as cinco bedeutet zehn Minuten vor fünf, also 4:50. Die Zielstunde steht nach para as. Dez para allein nennt noch keine vollständige Uhrzeit."
    },
    {
      "id": "karte-07",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "aula",
      "translation": "Unterricht",
      "isVocabulary": true,
      "example": "A aula começa às oito.",
      "exampleTranslation": "Der Unterricht beginnt um acht.",
      "explanation": "A aula, Plural aulas. Começa bedeutet beginnt; às oito heißt um acht Uhr. Vergleiche São oito horas = Es ist acht Uhr mit às oito = um acht Uhr. Für um ein Uhr heißt es à uma."
    },
    {
      "id": "karte-08",
      "topic": "Uhrzeit und Verabredungen",
      "expression": "meio-dia",
      "translation": "Mittag; zwölf Uhr mittags",
      "isVocabulary": true,
      "example": "É meio-dia.",
      "exampleTranslation": "Es ist zwölf Uhr mittags.",
      "explanation": "O meio-dia bezeichnet Mittag, also zwölf Uhr mittags. É meio-dia nennt die Uhrzeit. Ao meio-dia bedeutet dagegen um zwölf Uhr mittags und nennt einen Zeitpunkt für eine Handlung."
    }
  ]
}
