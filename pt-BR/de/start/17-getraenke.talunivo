  "cards": [
    {
      "id": "karte-01",
      "topic": "Getränke bestellen",
      "expression": "água sem gás",
      "translation": "stilles Wasser",
      "isVocabulary": true,
      "example": "Uma água sem gás, por favor.",
      "exampleTranslation": "Ein stilles Wasser, bitte.",
      "explanation": "A água ist weiblich, deshalb uma água. Sem gás bedeutet ohne Kohlensäure: stilles Wasser. Sem gelo würde dagegen ohne Eiswürfel bedeuten; das sind verschiedene Zusätze."
    },
    {
      "id": "karte-02",
      "topic": "Getränke bestellen",
      "expression": "água com gás",
      "translation": "Sprudelwasser",
      "isVocabulary": true,
      "example": "Quero água com gás.",
      "exampleTranslation": "Ich möchte Sprudelwasser.",
      "explanation": "Água com gás ist Wasser mit Kohlensäure, auf Deutsch auch Sprudelwasser. Com bedeutet mit; sem gás wäre ohne Kohlensäure. Hier wird kein bestimmter Kohlensäuregehalt festgelegt."
    },
    {
      "id": "karte-03",
      "topic": "Getränke bestellen",
      "expression": "café com leite",
      "translation": "Milchkaffee",
      "isVocabulary": true,
      "example": "Um café com leite, por favor.",
      "exampleTranslation": "Einen Kaffee mit Milch, bitte.",
      "explanation": "Café com leite bedeutet Kaffee mit Milch; Milchkaffee ist ebenfalls eine passende deutsche Bezeichnung. O café ist männlich, deshalb um café. Die Wendung allein gibt kein genaues Verhältnis von Kaffee und Milch an."
    },
    {
      "id": "karte-04",
      "topic": "Getränke bestellen",
      "expression": "chá",
      "translation": "Tee",
      "isVocabulary": true,
      "example": "Tem chá?",
      "exampleTranslation": "Gibt es Tee?",
      "explanation": "O chá ist Tee; der Akut gehört zur Schreibweise. Tem chá? fragt nach der Verfügbarkeit. Eine Bestellung kann zum Beispiel mit Um chá, por favor. formuliert werden."
    },
    {
      "id": "karte-05",
      "topic": "Getränke bestellen",
      "expression": "suco de laranja",
      "translation": "Orangensaft",
      "isVocabulary": true,
      "example": "Quero um suco de laranja, por favor.",
      "exampleTranslation": "Ich möchte einen Orangensaft, bitte.",
      "explanation": "O suco ist die brasilianische Bezeichnung für Saft. Suco de laranja bedeutet Orangensaft; de laranja nennt hier die Frucht, aus der der Saft stammt. Um passt zum männlichen suco."
    },
    {
      "id": "karte-06",
      "topic": "Getränke bestellen",
      "expression": "sem gelo",
      "translation": "ohne Eiswürfel",
      "isVocabulary": true,
      "example": "Sem gelo, por favor.",
      "exampleTranslation": "Ohne Eiswürfel, bitte.",
      "explanation": "Gelo bedeutet Eis; bei einem Getränk sind hier Eiswürfel gemeint. Sem gelo ist ohne Eiswürfel und ergänzt eine Bestellung. Speiseeis heißt sorvete; sem gelo ist nicht dieselbe Angabe wie sem gás."
    },
    {
      "id": "karte-07",
      "topic": "Getränke bestellen",
      "expression": "xícara",
      "translation": "Tasse",
      "isVocabulary": true,
      "example": "Uma xícara de chá, por favor.",
      "exampleTranslation": "Eine Tasse Tee, bitte.",
      "explanation": "A xícara, Plural xícaras. Uma xícara de chá bedeutet eine Tasse Tee. De verbindet hier das Gefäß mit dem Inhalt. Xícara ist eine Tasse; copo aus Paket 14 bezeichnet ein Trinkglas."
    },
    {
      "id": "karte-08",
      "topic": "Getränke bestellen",
      "expression": "para levar",
      "translation": "zum Mitnehmen",
      "isVocabulary": true,
      "example": "Um café para levar, por favor.",
      "exampleTranslation": "Einen Kaffee zum Mitnehmen, bitte.",
      "explanation": "Para levar heißt bei einer Bestellung zum Mitnehmen. Die Wendung ergänzt hier den Kaffee. Sie benennt die Mitnahme, aber noch keine bestimmte Verpackung oder Gefäßgröße."
    }
  ]
}
