  "cards": [
    {
      "id": "karte-01",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "\u00E1gua sem g\u00E1s",
      "translation": "stilles Wasser",
      "example": "Uma \u00E1gua sem g\u00E1s, por favor.",
      "exampleTranslation": "Ein stilles Wasser, bitte.",
      "explanation": "A \u00E1gua ist weiblich, deshalb uma \u00E1gua. Sem g\u00E1s bedeutet ohne Kohlens\u00E4ure: stilles Wasser. Sem gelo w\u00FCrde dagegen ohne Eisw\u00FCrfel bedeuten; das sind verschiedene Zus\u00E4tze.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "\u00E1gua com g\u00E1s",
      "translation": "Sprudelwasser",
      "example": "Quero \u00E1gua com g\u00E1s.",
      "exampleTranslation": "Ich m\u00F6chte Sprudelwasser.",
      "explanation": "\u00C1gua com g\u00E1s ist Wasser mit Kohlens\u00E4ure, auf Deutsch auch Sprudelwasser. Com bedeutet mit; sem g\u00E1s w\u00E4re ohne Kohlens\u00E4ure. Hier wird kein bestimmter Kohlens\u00E4uregehalt festgelegt.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "caf\u00E9 com leite",
      "translation": "Milchkaffee",
      "example": "Um caf\u00E9 com leite, por favor.",
      "exampleTranslation": "Einen Kaffee mit Milch, bitte.",
      "explanation": "Caf\u00E9 com leite bedeutet Kaffee mit Milch; Milchkaffee ist ebenfalls eine passende deutsche Bezeichnung. O caf\u00E9 ist m\u00E4nnlich, deshalb um caf\u00E9. Die Wendung allein gibt kein genaues Verh\u00E4ltnis von Kaffee und Milch an.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "ch\u00E1",
      "translation": "Tee",
      "example": "Tem ch\u00E1?",
      "exampleTranslation": "Gibt es Tee?",
      "explanation": "O ch\u00E1 ist Tee; der Akut geh\u00F6rt zur Schreibweise. Tem ch\u00E1? fragt nach der Verf\u00FCgbarkeit. Eine Bestellung kann zum Beispiel mit Um ch\u00E1, por favor. formuliert werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "suco de laranja",
      "translation": "Orangensaft",
      "example": "Quero um suco de laranja, por favor.",
      "exampleTranslation": "Ich m\u00F6chte einen Orangensaft, bitte.",
      "explanation": "O suco ist die brasilianische Bezeichnung f\u00FCr Saft. Suco de laranja bedeutet Orangensaft; de laranja nennt hier die Frucht, aus der der Saft stammt. Um passt zum m\u00E4nnlichen suco.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "sem gelo",
      "translation": "ohne Eisw\u00FCrfel",
      "example": "Sem gelo, por favor.",
      "exampleTranslation": "Ohne Eisw\u00FCrfel, bitte.",
      "explanation": "Gelo bedeutet Eis; bei einem Getr\u00E4nk sind hier Eisw\u00FCrfel gemeint. Sem gelo ist ohne Eisw\u00FCrfel und erg\u00E4nzt eine Bestellung. Speiseeis hei\u00DFt sorvete; sem gelo ist nicht dieselbe Angabe wie sem g\u00E1s.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "x\u00EDcara",
      "translation": "Tasse",
      "example": "Uma x\u00EDcara de ch\u00E1, por favor.",
      "exampleTranslation": "Eine Tasse Tee, bitte.",
      "explanation": "A x\u00EDcara, Plural x\u00EDcaras. Uma x\u00EDcara de ch\u00E1 bedeutet eine Tasse Tee. De verbindet hier das Gef\u00E4\u00DF mit dem Inhalt. X\u00EDcara ist eine Tasse; copo aus Paket 14 bezeichnet ein Trinkglas.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Getr\u00E4nke bestellen",
      "expression": "para levar",
      "translation": "zum Mitnehmen",
      "example": "Um caf\u00E9 para levar, por favor.",
      "exampleTranslation": "Einen Kaffee zum Mitnehmen, bitte.",
      "explanation": "Para levar hei\u00DFt bei einer Bestellung zum Mitnehmen. Die Wendung erg\u00E4nzt hier den Kaffee. Sie benennt die Mitnahme, aber noch keine bestimmte Verpackung oder Gef\u00E4\u00DFgr\u00F6\u00DFe.",
      "isVocabulary": true
    }
  ],
