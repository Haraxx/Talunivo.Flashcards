  "cards": [
    {
      "id": "karte-01",
      "topic": "Um Hilfe bitten",
      "expression": "ajudar",
      "translation": "helfen",
      "example": "Pode me ajudar, por favor?",
      "exampleTranslation": "K\u00F6nnen Sie mir bitte helfen?",
      "explanation": "Ajudar hei\u00DFt helfen. Pode me ajudar? bedeutet k\u00F6nnen Sie mir helfen?; me bezieht sich auf die sprechende Person. Por favor erg\u00E4nzt die Bitte. Ajuda ist das Nomen Hilfe aus Paket 38.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Um Hilfe bitten",
      "expression": "perdido",
      "translation": "verirrt (m\u00E4nnlich)",
      "example": "Estou perdido.",
      "exampleTranslation": "Ich habe mich verlaufen.",
      "explanation": "Perdido ist hier die m\u00E4nnliche Form von verirrt; die weibliche lautet perdida. Estou perdido beschreibt den aktuellen Zustand. Die deutsche \u00DCbersetzung kann ich habe mich verlaufen oder ich bin verirrt lauten.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Um Hilfe bitten",
      "expression": "perdida",
      "translation": "verirrt (weiblich)",
      "example": "Estou perdida nesta rua.",
      "exampleTranslation": "Ich habe mich in dieser Stra\u00DFe verlaufen.",
      "explanation": "Perdida ist hier die weibliche Form von verirrt; die m\u00E4nnliche lautet perdido. Nesta verbindet em \u002B esta und bedeutet in dieser. Beide Formen beschreiben dasselbe Befinden; die Auswahl nicht aus einem Avatar ableiten.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Um Hilfe bitten",
      "expression": "perder",
      "translation": "verlieren",
      "example": "Perdi meu celular.",
      "exampleTranslation": "Ich habe mein Handy verloren.",
      "explanation": "Perder hei\u00DFt verlieren; perdi ist die Ich-Form in der abgeschlossenen Vergangenheit: ich habe verloren. Meu celular hei\u00DFt mein Handy. Im Unterschied zu estou perdido beschreibt der Satz hier den Verlust eines Gegenstands.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Um Hilfe bitten",
      "expression": "encontrar",
      "translation": "finden",
      "example": "N\u00E3o encontro meu passaporte.",
      "exampleTranslation": "Ich finde meinen Reisepass nicht.",
      "explanation": "Encontrar hei\u00DFt finden; encontro ist die Ich-Form im Pr\u00E4sens. N\u00E3o verneint die Aussage, meu passaporte hei\u00DFt mein Reisepass. Nichtfinden sagt noch nicht, ob der Pass verloren wurde.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Um Hilfe bitten",
      "expression": "ambul\u00E2ncia",
      "translation": "Krankenwagen",
      "example": "Chame uma ambul\u00E2ncia, por favor.",
      "exampleTranslation": "Rufen Sie bitte einen Krankenwagen.",
      "explanation": "A ambul\u00E2ncia, Plural ambul\u00E2ncias, hei\u00DFt Krankenwagen. Chame ist hier die Aufforderungsform von chamar zur Ansprache mit voc\u00EA; por favor macht die Bitte ausdr\u00FCcklich. Der Satz nennt keine Rufnummer und beschreibt keinen konkreten Ablauf.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Um Hilfe bitten",
      "expression": "m\u00E9dico",
      "translation": "Arzt",
      "example": "Preciso de um m\u00E9dico.",
      "exampleTranslation": "Ich brauche einen Arzt.",
      "explanation": "O m\u00E9dico hei\u00DFt Arzt; die weibliche Form ist a m\u00E9dica, \u00C4rztin. Preciso de \u002B Nomen hei\u00DFt ich brauche etwas oder jemanden. Um m\u00E9dico benennt hier die gesuchte Person; der Satz nennt keine bestimmte Behandlung.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Um Hilfe bitten",
      "expression": "entrada",
      "translation": "Eingang",
      "example": "Estou na entrada do hotel.",
      "exampleTranslation": "Ich bin am Hoteleingang.",
      "explanation": "A entrada, Plural entradas, bezeichnet hier den Eingang. Na verbindet em \u002B a, do verbindet de \u002B o. Na entrada do hotel hei\u00DFt am Eingang des Hotels. Estou nennt hier den aktuellen Standort.",
      "isVocabulary": true
    }
  ],
