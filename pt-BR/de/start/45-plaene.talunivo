  "cards": [
    {
      "id": "karte-01",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "trabalhar",
      "translation": "arbeiten",
      "example": "Amanh\u00E3 vou trabalhar de manh\u00E3.",
      "exampleTranslation": "Morgen werde ich vormittags arbeiten.",
      "explanation": "Trabalhar hei\u00DFt arbeiten. Vou \u002B Infinitiv dr\u00FCckt hier einen Plan der sprechenden Person aus. Amanh\u00E3 bedeutet morgen, de manh\u00E3 morgens oder vormittags; beides zusammen hei\u00DFt morgen am Vormittag.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "visitar",
      "translation": "besuchen",
      "example": "Vou visitar minha irm\u00E3.",
      "exampleTranslation": "Ich werde meine Schwester besuchen.",
      "explanation": "Visitar hei\u00DFt besuchen. Vou visitar bezeichnet hier meinen geplanten Besuch; minha irm\u00E3 hei\u00DFt meine Schwester. Im Portugiesischen folgt die besuchte Person hier direkt auf visitar, ohne eine zus\u00E4tzliche Pr\u00E4position.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "comprar",
      "translation": "kaufen",
      "example": "Amanh\u00E3 vamos comprar comida.",
      "exampleTranslation": "Morgen werden wir Lebensmittel einkaufen.",
      "explanation": "Comprar hei\u00DFt kaufen; comida bezeichnet hier Essen beziehungsweise Lebensmittel. Vamos \u002B Infinitiv geh\u00F6rt zu wir. Amanh\u00E3 nennt morgen als Zeitpunkt; vamos comprar kann im Gespr\u00E4ch auch einen gemeinsamen Vorschlag ausdr\u00FCcken.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "chegar",
      "translation": "ankommen",
      "example": "Ela vai chegar \u00E0 tarde.",
      "exampleTranslation": "Sie wird am Nachmittag ankommen.",
      "explanation": "Chegar hei\u00DFt ankommen. Vai \u002B Infinitiv geh\u00F6rt hier zu ela, sie in der Einzahl. \u00C0 tarde bedeutet am Nachmittag; eine genaue Uhrzeit und ein Ankunftsort werden nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "viajar",
      "translation": "verreisen",
      "example": "Voc\u00EA vai viajar no fim de semana?",
      "exampleTranslation": "Wirst du am Wochenende verreisen?",
      "explanation": "Viajar hei\u00DFt reisen oder verreisen. Vai geh\u00F6rt im Satz zu voc\u00EA; no fim de semana bedeutet am Wochenende. Die Frage nennt weder Reiseziel noch Verkehrsmittel.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "sair",
      "translation": "ausgehen",
      "example": "N\u00E3o vou sair hoje.",
      "exampleTranslation": "Ich werde heute nicht ausgehen.",
      "explanation": "Sair bedeutet hier ausgehen, je nach Zusammenhang auch weggehen oder hinausgehen. N\u00E3o steht vor vou und verneint den Zukunftssatz. Hoje bedeutet heute; die Aussage nennt keine Ursache f\u00FCr den Plan.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "fazer",
      "translation": "machen",
      "example": "O que voc\u00EA vai fazer amanh\u00E3?",
      "exampleTranslation": "Was wirst du morgen machen?",
      "explanation": "Fazer hei\u00DFt machen oder tun. O que fragt hier was, voc\u00EA vai fazer nach der geplanten T\u00E4tigkeit der angesprochenen Person. Amanh\u00E3 bedeutet morgen; es handelt sich um eine offene Frage.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Pl\u00E4ne f\u00FCr morgen",
      "expression": "ficar",
      "translation": "bleiben",
      "example": "Amanh\u00E3 vamos ficar em casa.",
      "exampleTranslation": "Morgen werden wir zu Hause bleiben.",
      "explanation": "Ficar hei\u00DFt hier bleiben. Vamos ficar nennt einen gemeinsamen Plan, em casa bedeutet zu Hause. Amanh\u00E3 legt den Zeitpunkt auf morgen fest. Als Gespr\u00E4chsbeitrag kann vamos auch einen Vorschlag einleiten.",
      "isVocabulary": true
    }
  ],
