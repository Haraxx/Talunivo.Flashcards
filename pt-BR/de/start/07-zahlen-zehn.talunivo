  "cards": [
    {
      "id": "karte-01",
      "topic": "Zahlen von null bis zehn",
      "expression": "zero",
      "translation": "null",
      "example": "A temperatura est\u00E1 em zero grau.",
      "exampleTranslation": "Die Temperatur liegt bei null Grad.",
      "explanation": "Zero steht f\u00FCr 0. Im Beispiel nennt zero die Temperatur: zero grau = null Grad. Beim einzelnen Nennen einer Ziffer hei\u00DFt 0 ebenfalls zero.",
      "isVocabulary": true
    },
    {
      "id": "karte-01-2",
      "topic": "Zahlen von null bis zehn",
      "expression": "um",
      "translation": "eins",
      "example": "Quero um caf\u00E9, por favor.",
      "exampleTranslation": "Ich m\u00F6chte einen Kaffee, bitte.",
      "explanation": "Um steht beim Z\u00E4hlen f\u00FCr eins. Vor einem m\u00E4nnlichen Nomen: um caf\u00E9; vor einem weiblichen: uma pessoa. Um kann auch ein unbestimmter Artikel sein; die Bedeutung ergibt sich aus dem Satz.",
      "isVocabulary": true
    },
    {
      "id": "karte-01-3",
      "topic": "Zahlen von null bis zehn",
      "expression": "dois",
      "translation": "zwei",
      "example": "Tenho dois livros.",
      "exampleTranslation": "Ich habe zwei B\u00FCcher.",
      "explanation": "Dois steht f\u00FCr 2 vor m\u00E4nnlichen Nomen: dois livros = zwei B\u00FCcher. Vor weiblichen Nomen hei\u00DFt es duas, etwa duas pessoas. Tenho bedeutet ich habe.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Zahlen von null bis zehn",
      "expression": "tr\u00EAs",
      "translation": "drei",
      "example": "Tenho tr\u00EAs canetas.",
      "exampleTranslation": "Ich habe drei Stifte.",
      "explanation": "Tr\u00EAs steht f\u00FCr 3. Die Form ist bei m\u00E4nnlichen und weiblichen Nomen gleich. Tr\u00EAs canetas bedeutet drei Stifte; der Zirkumflex in tr\u00EAs geh\u00F6rt zur Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-02-2",
      "topic": "Zahlen von null bis zehn",
      "expression": "quatro",
      "translation": "vier",
      "example": "S\u00E3o quatro pessoas.",
      "exampleTranslation": "Es sind vier Personen.",
      "explanation": "Quatro steht f\u00FCr 4 und ver\u00E4ndert sich vor m\u00E4nnlichen oder weiblichen Nomen nicht. S\u00E3o quatro pessoas bedeutet es sind vier Personen; pessoas ist die Mehrzahl von pessoa.",
      "isVocabulary": true
    },
    {
      "id": "karte-02-3",
      "topic": "Zahlen von null bis zehn",
      "expression": "cinco",
      "translation": "f\u00FCnf",
      "example": "Quero cinco ma\u00E7\u00E3s.",
      "exampleTranslation": "Ich m\u00F6chte f\u00FCnf \u00C4pfel.",
      "explanation": "Cinco steht f\u00FCr 5. Quero cinco ma\u00E7\u00E3s hei\u00DFt ich m\u00F6chte f\u00FCnf \u00C4pfel. Ma\u00E7\u00E3s ist die Mehrzahl von ma\u00E7\u00E3; die Zahl cinco bleibt unver\u00E4ndert.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Zahlen von null bis zehn",
      "expression": "seis",
      "translation": "sechs",
      "example": "Tenho seis livros.",
      "exampleTranslation": "Ich habe sechs B\u00FCcher.",
      "explanation": "Seis steht f\u00FCr 6: seis livros = sechs B\u00FCcher. Sete steht dagegen f\u00FCr 7. Die Form seis bleibt vor m\u00E4nnlichen und weiblichen Nomen gleich.",
      "isVocabulary": true
    },
    {
      "id": "karte-03-2",
      "topic": "Zahlen von null bis zehn",
      "expression": "sete",
      "translation": "sieben",
      "example": "A semana tem sete dias.",
      "exampleTranslation": "Die Woche hat sieben Tage.",
      "explanation": "Sete steht f\u00FCr 7. A semana hei\u00DFt die Woche; sete dias bedeutet sieben Tage. Damit wird eine Anzahl genannt, noch kein einzelner Wochentag.",
      "isVocabulary": true
    },
    {
      "id": "karte-03-3",
      "topic": "Zahlen von null bis zehn",
      "expression": "oito",
      "translation": "acht",
      "example": "S\u00E3o oito reais.",
      "exampleTranslation": "Das macht acht Reais.",
      "explanation": "Oito steht f\u00FCr 8. Bei einem Preis bedeutet S\u00E3o oito reais: Das macht acht Reais. Reais ist die Mehrzahl der W\u00E4hrung real; der Betrag ist nur ein Lernbeispiel.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Zahlen von null bis zehn",
      "expression": "nove",
      "translation": "neun",
      "example": "Tenho nove moedas.",
      "exampleTranslation": "Ich habe neun M\u00FCnzen.",
      "explanation": "Nove steht f\u00FCr 9. Moedas sind M\u00FCnzen; nove moedas bedeutet neun M\u00FCnzen. Die Zahl ver\u00E4ndert sich vor m\u00E4nnlichen und weiblichen Nomen nicht.",
      "isVocabulary": true
    },
    {
      "id": "karte-04-2",
      "topic": "Zahlen von null bis zehn",
      "expression": "dez",
      "translation": "zehn",
      "example": "Tenho dez livros.",
      "exampleTranslation": "Ich habe zehn B\u00FCcher.",
      "explanation": "Dez steht f\u00FCr 10. Tenho dez livros hei\u00DFt ich habe zehn B\u00FCcher. Dez bleibt unver\u00E4ndert; nicht mit dois = zwei verwechseln.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Zahlen von null bis zehn",
      "expression": "pessoa",
      "translation": "Person",
      "example": "Tem uma pessoa na sala.",
      "exampleTranslation": "Im Wohnzimmer ist eine Person.",
      "explanation": "A pessoa, Plural pessoas. Das portugiesische Nomen ist grammatisch weiblich, unabh\u00E4ngig von der bezeichneten Person: uma pessoa, duas pessoas. Na sala bedeutet hier im Wohnzimmer.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Zahlen von null bis zehn",
      "expression": "duas",
      "translation": "zwei (weiblich)",
      "example": "Tem duas mesas livres.",
      "exampleTranslation": "Es sind zwei Tische frei.",
      "explanation": "Duas ist die weibliche Form der Zahl 2. A mesa ist im Portugiesischen weiblich, daher duas mesas; das deutsche Wort Tisch ist daf\u00FCr nicht ma\u00DFgeblich. Livres bedeutet hier frei.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Zahlen von null bis zehn",
      "expression": "irm\u00E3o",
      "translation": "Bruder",
      "example": "Meu irm\u00E3o mora aqui.",
      "exampleTranslation": "Mein Bruder wohnt hier.",
      "explanation": "O irm\u00E3o, Plural irm\u00E3os. Meu irm\u00E3o hei\u00DFt mein Bruder; mora aqui bedeutet wohnt hier. Irm\u00E3os kann je nach Kontext Br\u00FCder oder eine gemischte Gruppe von Geschwistern bezeichnen.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Zahlen von null bis zehn",
      "expression": "real",
      "translation": "Real (brasilianische W\u00E4hrung)",
      "example": "Um p\u00E3o custa um real.",
      "exampleTranslation": "Ein Brot kostet einen Real.",
      "explanation": "O real ist hier die brasilianische W\u00E4hrung; die Mehrzahl hei\u00DFt reais. Bei Preisen: um real, dois reais. Custa bedeutet kostet. Der Beispielsatz ist keine aktuelle Preisangabe.",
      "isVocabulary": true
    }
  ],
