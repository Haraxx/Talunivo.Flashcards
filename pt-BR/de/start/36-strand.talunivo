  "cards": [
    {
      "id": "karte-01",
      "topic": "Strand und Ausflug",
      "expression": "praia",
      "translation": "Strand",
      "example": "Vamos \u00E0 praia?",
      "exampleTranslation": "Wollen wir an den Strand gehen?",
      "explanation": "A praia, Plural praias, hei\u00DFt Strand. \u00C0 verbindet a \u002B a; \u00E0 praia bezeichnet hier das Ziel an den Strand. Vamos \u2026? ist mit Frageintonation ein gemeinsamer Vorschlag.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Strand und Ausflug",
      "expression": "protetor solar",
      "translation": "Sonnencreme",
      "example": "Preciso de protetor solar.",
      "exampleTranslation": "Ich brauche Sonnencreme.",
      "explanation": "O protetor solar, Plural protetores solares, bezeichnet ein Sonnenschutzmittel. Sonnencreme ist hier die deutsche Wiedergabe. Preciso de \u002B Nomen hei\u00DFt ich brauche etwas; der Satz nennt weder Produkt noch Anwendung.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Strand und Ausflug",
      "expression": "chap\u00E9u",
      "translation": "Hut",
      "example": "Leve um chap\u00E9u, por favor.",
      "exampleTranslation": "Nimm bitte einen Hut mit.",
      "explanation": "O chap\u00E9u, Plural chap\u00E9us, ist der Hut. Leve ist hier die Aufforderungsform von levar zur Ansprache mit voc\u00EA: nimm mit. Der Akut geh\u00F6rt auch im Plural zur Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Strand und Ausflug",
      "expression": "guarda-sol",
      "translation": "Sonnenschirm",
      "example": "Onde posso alugar um guarda-sol?",
      "exampleTranslation": "Wo kann ich einen Sonnenschirm mieten?",
      "explanation": "O guarda-sol hei\u00DFt Sonnenschirm; die Mehrzahl lautet guarda-s\u00F3is. Posso alugar bedeutet ich kann mieten, onde fragt nach dem Ort. Die Frage nennt noch keinen tats\u00E4chlichen Anbieter oder Preis.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Strand und Ausflug",
      "expression": "mar",
      "translation": "Meer",
      "example": "O mar est\u00E1 calmo hoje.",
      "exampleTranslation": "Das Meer ist heute ruhig.",
      "explanation": "O mar, Plural mares, hei\u00DFt Meer. Calmo passt zur m\u00E4nnlichen Form mar und bedeutet ruhig. Est\u00E1 beschreibt hier den Zustand heute; ruhig ist sprachlich nicht gleichbedeutend mit sicher.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Strand und Ausflug",
      "expression": "seguro",
      "translation": "sicher",
      "example": "\u00C9 seguro nadar aqui?",
      "exampleTranslation": "Ist es sicher, hier zu schwimmen?",
      "explanation": "Seguro bedeutet hier sicher. Im Muster \u00E9 seguro \u002B Infinitiv wird eine Handlung beurteilt; nadar hei\u00DFt schwimmen, aqui hier. Das Beispiel ist eine Frage und enth\u00E4lt keine Antwort \u00FCber einen bestimmten Ort.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Strand und Ausflug",
      "expression": "sombra",
      "translation": "Schatten",
      "example": "Vou ficar na sombra.",
      "exampleTranslation": "Ich werde im Schatten bleiben.",
      "explanation": "A sombra, Plural sombras, bedeutet Schatten. Na verbindet em \u002B a; na sombra hei\u00DFt im Schatten. Vou ficar k\u00FCndigt hier an: ich werde bleiben.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Strand und Ausflug",
      "expression": "escurecer",
      "translation": "dunkel werden",
      "example": "Vamos voltar antes de escurecer.",
      "exampleTranslation": "Kehren wir zur\u00FCck, bevor es dunkel wird.",
      "explanation": "Escurecer hei\u00DFt hier dunkel werden. Antes de \u002B Infinitiv nennt ein Ereignis, vor dem etwas geschieht. Vamos voltar ist hier ein Vorschlag zur R\u00FCckkehr; der Satz nennt keine genaue Uhrzeit.",
      "isVocabulary": true
    }
  ],
