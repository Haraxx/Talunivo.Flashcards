  "cards": [
    {
      "id": "karte-01",
      "topic": "Strand und Ausflug",
      "expression": "praia",
      "translation": "Strand",
      "isVocabulary": true,
      "example": "Vamos à praia?",
      "exampleTranslation": "Wollen wir an den Strand gehen?",
      "explanation": "A praia, Plural praias, heißt Strand. À verbindet a + a; à praia bezeichnet hier das Ziel an den Strand. Vamos …? ist mit Frageintonation ein gemeinsamer Vorschlag."
    },
    {
      "id": "karte-02",
      "topic": "Strand und Ausflug",
      "expression": "protetor solar",
      "translation": "Sonnencreme",
      "isVocabulary": true,
      "example": "Preciso de protetor solar.",
      "exampleTranslation": "Ich brauche Sonnencreme.",
      "explanation": "O protetor solar, Plural protetores solares, bezeichnet ein Sonnenschutzmittel. Sonnencreme ist hier die deutsche Wiedergabe. Preciso de + Nomen heißt ich brauche etwas; der Satz nennt weder Produkt noch Anwendung."
    },
    {
      "id": "karte-03",
      "topic": "Strand und Ausflug",
      "expression": "chapéu",
      "translation": "Hut",
      "isVocabulary": true,
      "example": "Leve um chapéu, por favor.",
      "exampleTranslation": "Nimm bitte einen Hut mit.",
      "explanation": "O chapéu, Plural chapéus, ist der Hut. Leve ist hier die Aufforderungsform von levar zur Ansprache mit você: nimm mit. Der Akut gehört auch im Plural zur Schreibweise."
    },
    {
      "id": "karte-04",
      "topic": "Strand und Ausflug",
      "expression": "guarda-sol",
      "translation": "Sonnenschirm",
      "isVocabulary": true,
      "example": "Onde posso alugar um guarda-sol?",
      "exampleTranslation": "Wo kann ich einen Sonnenschirm mieten?",
      "explanation": "O guarda-sol heißt Sonnenschirm; die Mehrzahl lautet guarda-sóis. Posso alugar bedeutet ich kann mieten, onde fragt nach dem Ort. Die Frage nennt noch keinen tatsächlichen Anbieter oder Preis."
    },
    {
      "id": "karte-05",
      "topic": "Strand und Ausflug",
      "expression": "mar",
      "translation": "Meer",
      "isVocabulary": true,
      "example": "O mar está calmo hoje.",
      "exampleTranslation": "Das Meer ist heute ruhig.",
      "explanation": "O mar, Plural mares, heißt Meer. Calmo passt zur männlichen Form mar und bedeutet ruhig. Está beschreibt hier den Zustand heute; ruhig ist sprachlich nicht gleichbedeutend mit sicher."
    },
    {
      "id": "karte-06",
      "topic": "Strand und Ausflug",
      "expression": "seguro",
      "translation": "sicher",
      "isVocabulary": true,
      "example": "É seguro nadar aqui?",
      "exampleTranslation": "Ist es sicher, hier zu schwimmen?",
      "explanation": "Seguro bedeutet hier sicher. Im Muster é seguro + Infinitiv wird eine Handlung beurteilt; nadar heißt schwimmen, aqui hier. Das Beispiel ist eine Frage und enthält keine Antwort über einen bestimmten Ort."
    },
    {
      "id": "karte-07",
      "topic": "Strand und Ausflug",
      "expression": "sombra",
      "translation": "Schatten",
      "isVocabulary": true,
      "example": "Vou ficar na sombra.",
      "exampleTranslation": "Ich werde im Schatten bleiben.",
      "explanation": "A sombra, Plural sombras, bedeutet Schatten. Na verbindet em + a; na sombra heißt im Schatten. Vou ficar kündigt hier an: ich werde bleiben."
    },
    {
      "id": "karte-08",
      "topic": "Strand und Ausflug",
      "expression": "escurecer",
      "translation": "dunkel werden",
      "isVocabulary": true,
      "example": "Vamos voltar antes de escurecer.",
      "exampleTranslation": "Kehren wir zurück, bevor es dunkel wird.",
      "explanation": "Escurecer heißt hier dunkel werden. Antes de + Infinitiv nennt ein Ereignis, vor dem etwas geschieht. Vamos voltar ist hier ein Vorschlag zur Rückkehr; der Satz nennt keine genaue Uhrzeit."
    }
  ]
}
