{
  "format": "talunivo",
  "schemaVersion": 1,
  "packageId": "start-ptbr-36-strand",
  "packageVersion": 1,
  "title": "36 · Strand und Ausflug",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Strand und Ausflug",
      "expression": "Vamos à praia amanhã.",
      "translation": "Gehen wir morgen an den Strand.",
      "explanation": "à = a + a; praia = Strand.",
      "example": "Vamos à praia. Leve água e protetor solar.",
      "exampleTranslation": "Gehen wir an den Strand. Nimm Wasser und Sonnencreme mit."
    },
    {
      "id": "karte-02",
      "topic": "Strand und Ausflug",
      "expression": "Preciso de protetor solar.",
      "translation": "Ich brauche Sonnencreme.",
      "explanation": "protetor solar = Sonnenschutzmittel."
    },
    {
      "id": "karte-03",
      "topic": "Strand und Ausflug",
      "expression": "Leve água e um chapéu.",
      "translation": "Nimm Wasser und einen Hut mit.",
      "explanation": "leve ist eine Aufforderung; chapéu = Hut."
    },
    {
      "id": "karte-04",
      "topic": "Strand und Ausflug",
      "expression": "Onde posso alugar um guarda-sol?",
      "translation": "Wo kann ich einen Sonnenschirm mieten?",
      "explanation": "alugar = mieten; guarda-sol = Sonnenschirm."
    },
    {
      "id": "karte-05",
      "topic": "Strand und Ausflug",
      "expression": "O mar está calmo hoje.",
      "translation": "Das Meer ist heute ruhig.",
      "explanation": "calmo = ruhig."
    },
    {
      "id": "karte-06",
      "topic": "Strand und Ausflug",
      "expression": "É seguro nadar aqui?",
      "translation": "Ist es sicher, hier zu schwimmen?",
      "explanation": "seguro = sicher; vor Ort aktuelle Hinweise beachten."
    },
    {
      "id": "karte-07",
      "topic": "Strand und Ausflug",
      "expression": "Vou ficar na sombra.",
      "translation": "Ich werde im Schatten bleiben.",
      "explanation": "sombra = Schatten."
    },
    {
      "id": "karte-08",
      "topic": "Strand und Ausflug",
      "expression": "Vamos voltar antes de escurecer.",
      "translation": "Kehren wir zurück, bevor es dunkel wird.",
      "explanation": "antes de = bevor; escurecer = dunkel werden."
    }
  ]
}
