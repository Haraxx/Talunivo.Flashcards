  "cards": [
    {
      "id": "karte-01",
      "topic": "Verstehen und Nachfragen",
      "expression": "entender",
      "translation": "verstehen",
      "example": "N\u00E3o entendi.",
      "exampleTranslation": "Ich habe es nicht verstanden.",
      "explanation": "Entender bedeutet verstehen. Entendi ist hier die Vergangenheitsform f\u00FCr ich habe verstanden; n\u00E3o verneint sie. N\u00E3o entendi hei\u00DFt ich habe es nicht verstanden. Die Gegenwartsform w\u00E4re n\u00E3o entendo.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Verstehen und Nachfragen",
      "expression": "devagar",
      "translation": "langsam",
      "example": "Pode falar mais devagar, por favor?",
      "exampleTranslation": "Kannst du bitte langsamer sprechen?",
      "explanation": "Devagar bedeutet langsam, mais devagar langsamer. Pode falar \u2026? hei\u00DFt hier kannst du \u2026 sprechen? Die Bitte betrifft das Sprechtempo; pode repetir? bittet darum, etwas zu wiederholen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Verstehen und Nachfragen",
      "expression": "significar",
      "translation": "bedeuten",
      "example": "O que isso significa?",
      "exampleTranslation": "Was bedeutet das?",
      "explanation": "Significar bedeutet bedeuten. Significa ist die hier verwendete Form; isso hei\u00DFt das. O que isso significa? fragt nach der Bedeutung eines Wortes, Ausdrucks oder gezeigten Zeichens.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Verstehen und Nachfragen",
      "expression": "dizer",
      "translation": "sagen",
      "example": "Como se diz isso em portugu\u00EAs?",
      "exampleTranslation": "Wie sagt man das auf Portugiesisch?",
      "explanation": "Dizer bedeutet sagen. Como se diz \u2026? hei\u00DFt wie sagt man \u2026? Isso bedeutet das, em portugu\u00EAs auf Portugiesisch. Hier wird nach einem Ausdruck gefragt, nicht nach seiner Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Verstehen und Nachfragen",
      "expression": "escrever",
      "translation": "schreiben",
      "example": "Como se escreve seu nome?",
      "exampleTranslation": "Wie schreibt man deinen Namen?",
      "explanation": "Escrever bedeutet schreiben. Como se escreve \u2026? fragt nach der Schreibweise. Seu nome hei\u00DFt hier dein Name. Die Frage kann mit geschriebenen Buchstaben oder einer buchstabierten Antwort beantwortet werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Verstehen und Nachfragen",
      "expression": "alem\u00E3o",
      "translation": "Deutsch (Sprache)",
      "example": "Voc\u00EA fala alem\u00E3o?",
      "exampleTranslation": "Sprichst du Deutsch?",
      "explanation": "Alem\u00E3o bezeichnet hier die deutsche Sprache. Sprachennamen werden im Portugiesischen kleingeschrieben. Voc\u00EA fala \u2026? hei\u00DFt sprichst du \u2026? Die Bedeutung Deutscher ist in diesem Beispiel nicht gemeint.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Verstehen und Nachfragen",
      "expression": "aprender",
      "translation": "lernen",
      "example": "Estou aprendendo portugu\u00EAs.",
      "exampleTranslation": "Ich lerne gerade Portugiesisch.",
      "explanation": "Aprender bedeutet lernen; aprendendo ist das Gerundium. Estou \u002B Gerundium beschreibt hier den laufenden Lernprozess: Estou aprendendo portugu\u00EAs hei\u00DFt ich lerne gerade Portugiesisch. Portugu\u00EAs bezeichnet die portugiesische Sprache.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Verstehen und Nachfragen",
      "expression": "momento",
      "translation": "Moment",
      "example": "S\u00F3 um momento, por favor.",
      "exampleTranslation": "Nur einen Moment, bitte.",
      "explanation": "O momento, Plural momentos. S\u00F3 bedeutet hier nur; s\u00F3 um momento hei\u00DFt nur einen Moment. Por favor macht daraus eine h\u00F6fliche Bitte um etwas Zeit. Der Akut geh\u00F6rt zu s\u00F3.",
      "isVocabulary": true
    }
  ],
