  "title": "05 · Verstehen und Nachfragen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Verstehen und Nachfragen",
      "expression": "entender",
      "translation": "verstehen",
      "example": "Não entendi.",
      "exampleTranslation": "Ich habe es nicht verstanden.",
      "explanation": "Entender bedeutet verstehen. Entendi ist hier die Vergangenheitsform für ich habe verstanden; não verneint sie. Não entendi heißt ich habe es nicht verstanden. Die Gegenwartsform wäre não entendo.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Verstehen und Nachfragen",
      "expression": "devagar",
      "translation": "langsam",
      "example": "Pode falar mais devagar, por favor?",
      "exampleTranslation": "Kannst du bitte langsamer sprechen?",
      "explanation": "Devagar bedeutet langsam, mais devagar langsamer. Pode falar …? heißt hier kannst du … sprechen? Die Bitte betrifft das Sprechtempo; pode repetir? bittet darum, etwas zu wiederholen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Verstehen und Nachfragen",
      "expression": "significar",
      "translation": "bedeuten",
      "example": "O que isso significa?",
      "exampleTranslation": "Was bedeutet das?",
      "explanation": "Significar bedeutet bedeuten. Significa ist die hier verwendete Form; isso heißt das. O que isso significa? fragt nach der Bedeutung eines Wortes, Ausdrucks oder gezeigten Zeichens.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Verstehen und Nachfragen",
      "expression": "dizer",
      "translation": "sagen",
      "example": "Como se diz isso em português?",
      "exampleTranslation": "Wie sagt man das auf Portugiesisch?",
      "explanation": "Dizer bedeutet sagen. Como se diz …? heißt wie sagt man …? Isso bedeutet das, em português auf Portugiesisch. Hier wird nach einem Ausdruck gefragt, nicht nach seiner Schreibweise.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Verstehen und Nachfragen",
      "expression": "escrever",
      "translation": "schreiben",
      "example": "Como se escreve seu nome?",
      "exampleTranslation": "Wie schreibt man deinen Namen?",
      "explanation": "Escrever bedeutet schreiben. Como se escreve …? fragt nach der Schreibweise. Seu nome heißt hier dein Name. Die Frage kann mit geschriebenen Buchstaben oder einer buchstabierten Antwort beantwortet werden.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Verstehen und Nachfragen",
      "expression": "alemão",
      "translation": "Deutsch (Sprache)",
      "example": "Você fala alemão?",
      "exampleTranslation": "Sprichst du Deutsch?",
      "explanation": "Alemão bezeichnet hier die deutsche Sprache. Sprachennamen werden im Portugiesischen kleingeschrieben. Você fala …? heißt sprichst du …? Die Bedeutung Deutscher ist in diesem Beispiel nicht gemeint.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "a-le-MÃU",
        "ipa": "[aleˈmɐ̃w̃]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-07",
      "topic": "Verstehen und Nachfragen",
      "expression": "aprender",
      "translation": "lernen",
      "example": "Estou aprendendo português.",
      "exampleTranslation": "Ich lerne gerade Portugiesisch.",
      "explanation": "Aprender bedeutet lernen; aprendendo ist das Gerundium. Estou + Gerundium beschreibt hier den laufenden Lernprozess: Estou aprendendo português heißt ich lerne gerade Portugiesisch. Português bezeichnet die portugiesische Sprache.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Verstehen und Nachfragen",
      "expression": "momento",
      "translation": "Moment",
      "example": "Só um momento, por favor.",
      "exampleTranslation": "Nur einen Moment, bitte.",
      "explanation": "O momento, Plural momentos. Só bedeutet hier nur; só um momento heißt nur einen Moment. Por favor macht daraus eine höfliche Bitte um etwas Zeit. Der Akut gehört zu só.",
      "isVocabulary": true
    }
  ],
