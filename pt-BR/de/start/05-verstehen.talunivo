      "id": "karte-08",
      "topic": "Verstehen und Nachfragen",
      "expression": "momento",
      "translation": "Moment",
      "isVocabulary": true,
      "example": "Só um momento, por favor.",
      "exampleTranslation": "Nur einen Moment, bitte.",
      "explanation": "O momento; só um momento = nur einen Moment."
    }
