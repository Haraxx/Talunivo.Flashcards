      "topic": "Verstehen und Nachfragen",
      "expression": "entender",
      "translation": "verstehen",
      "isVocabulary": true,
      "example": "Não entendi. Pode repetir mais devagar?",
      "exampleTranslation": "Ich habe es nicht verstanden. Kannst du es langsamer wiederholen?",
      "explanation": "Não entendi ist Vergangenheit: ich habe es nicht verstanden."
    },
    {
      "id": "karte-02",
      "topic": "Verstehen und Nachfragen",
      "expression": "devagar",
      "translation": "langsam",
      "isVocabulary": true,
      "example": "Pode falar mais devagar?",
      "exampleTranslation": "Kannst du langsamer sprechen?",
      "explanation": "Mais devagar bedeutet langsamer."
    },
    {
      "id": "karte-03",
      "topic": "Verstehen und Nachfragen",
      "expression": "significar",
      "translation": "bedeuten",
      "isVocabulary": true,
      "example": "O que isso significa?",
      "exampleTranslation": "Was bedeutet das?",
      "explanation": "Significa ist die Form zu isso: das bedeutet."
    },
    {
      "id": "karte-04",
      "topic": "Verstehen und Nachfragen",
      "expression": "dizer",
      "translation": "sagen",
      "isVocabulary": true,
      "example": "Como se diz isso em português?",
      "exampleTranslation": "Wie sagt man das auf Portugiesisch?",
      "explanation": "Como se diz …? = Wie sagt man …?"
    },
    {
      "id": "karte-05",
      "topic": "Verstehen und Nachfragen",
      "expression": "escrever",
      "translation": "schreiben",
      "isVocabulary": true,
      "example": "Como se escreve seu nome?",
      "exampleTranslation": "Wie schreibt man deinen Namen?",
      "explanation": "Como se escreve …? = Wie schreibt man …?"
    },
    {
      "id": "karte-06",
      "topic": "Verstehen und Nachfragen",
      "expression": "alemão",
      "translation": "Deutsch (Sprache)",
      "isVocabulary": true,
      "example": "Você fala alemão?",
      "exampleTranslation": "Sprichst du Deutsch?",
      "explanation": "Als Sprachname; dieselbe Schreibweise kann auch Deutscher bedeuten."
    },
    {
      "id": "karte-07",
      "topic": "Verstehen und Nachfragen",
      "expression": "aprender",
      "translation": "lernen",
      "isVocabulary": true,
      "example": "Estou aprendendo português.",
      "exampleTranslation": "Ich lerne gerade Portugiesisch.",
      "explanation": "Estou aprendendo beschreibt laufendes Lernen."
    },
