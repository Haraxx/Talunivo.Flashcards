  "title": "50 · Abschluss: Ein Tag in Brasilien",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "nome",
      "translation": "Name",
      "isVocabulary": true,
      "example": "Meu nome é Ana. E o seu?",
      "exampleTranslation": "Mein Name ist Ana. Und deiner?",
      "explanation": "O nome; Meu nome é … = Mein Name ist …"
    },
    {
      "id": "karte-02",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "aprender",
      "translation": "lernen",
      "isVocabulary": true,
      "example": "Estou aprendendo português e preciso praticar.",
      "exampleTranslation": "Ich lerne Portugiesisch und muss üben.",
      "explanation": "Estou aprendendo = ich lerne gerade."
    },
    {
      "id": "karte-03",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "pão com queijo",
      "translation": "Brot mit Käse",
      "isVocabulary": true,
      "example": "Quero um café e um pão com queijo.",
      "exampleTranslation": "Ich möchte einen Kaffee und ein Brot mit Käse.",
      "explanation": "Pão com queijo ist Brot mit Käse; pão de queijo ist ein anderes Gebäck."
    },
    {
      "id": "karte-04",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "pegar",
      "translation": "nehmen (Verkehrsmittel)",
      "isVocabulary": true,
      "example": "Depois vou pegar o ônibus para o centro.",
      "exampleTranslation": "Danach werde ich den Bus ins Zentrum nehmen.",
      "explanation": "Pegar o ônibus ist in Brasilien üblich für den Bus nehmen."
    },
    {
      "id": "karte-05",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "museu",
      "translation": "Museum",
      "isVocabulary": true,
      "example": "Pode me dizer onde fica o museu?",
      "exampleTranslation": "Können Sie mir sagen, wo das Museum ist?",
      "explanation": "O museu; onde fica …? = wo ist …?"
    },
    {
      "id": "karte-06",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "à tarde",
      "translation": "nachmittags",
      "isVocabulary": true,
      "example": "À tarde vou encontrar uma amiga no parque.",
      "exampleTranslation": "Am Nachmittag werde ich eine Freundin im Park treffen.",
      "explanation": "À tarde bedeutet nachmittags; tarde ohne Artikel kann spät heißen."
    },
    {
      "id": "karte-07",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "praia",
      "translation": "Strand",
      "isVocabulary": true,
      "example": "Ontem fui à praia e gostei muito.",
      "exampleTranslation": "Gestern bin ich an den Strand gegangen und es hat mir sehr gefallen.",
      "explanation": "A praia; fui à praia = ich bin an den Strand gegangen."
    },
    {
      "id": "karte-08",
      "topic": "Abschluss: Ein Tag in Brasilien",
      "expression": "conversar",
      "translation": "sich unterhalten",
      "isVocabulary": true,
      "example": "Amanhã quero conversar mais em português.",
      "exampleTranslation": "Morgen möchte ich mehr auf Portugiesisch sprechen.",
      "explanation": "Conversar em português = sich auf Portugiesisch unterhalten."
    }
  ]
}
