  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Restaurant",
      "expression": "mesa",
      "translation": "Tisch",
      "isVocabulary": true,
      "example": "Tem uma mesa para dois?",
      "exampleTranslation": "Ist ein Tisch für zwei frei?",
      "explanation": "A mesa; para dois = für zwei Personen."
    },
    {
      "id": "karte-02",
      "topic": "Im Restaurant",
      "expression": "prato do dia",
      "translation": "Tagesgericht",
      "isVocabulary": true,
      "example": "Qual é o prato do dia?",
      "exampleTranslation": "Was ist das Tagesgericht?",
      "explanation": "O prato do dia bedeutet das Tagesgericht."
    },
    {
      "id": "karte-03",
      "topic": "Im Restaurant",
      "expression": "arroz",
      "translation": "Reis",
      "isVocabulary": true,
      "example": "Quero arroz, por favor.",
      "exampleTranslation": "Ich möchte Reis, bitte.",
      "explanation": "O arroz wird als Stoffname meist im Singular verwendet."
    },
    {
      "id": "karte-03-2",
      "topic": "Im Restaurant",
      "expression": "feijão",
      "translation": "Bohnen",
      "isVocabulary": true,
      "example": "O feijão está gostoso.",
      "exampleTranslation": "Die Bohnen sind lecker.",
      "explanation": "O feijão bezeichnet Bohnen als Lebensmittel; einzelne Bohnen: feijões."
    },
    {
      "id": "karte-04",
      "topic": "Im Restaurant",
      "expression": "peixe",
      "translation": "Fisch",
      "isVocabulary": true,
      "example": "O peixe vem com arroz?",
      "exampleTranslation": "Wird der Fisch mit Reis serviert?",
      "explanation": "O peixe; Plural peixes."
    },
    {
      "id": "karte-04-2",
      "topic": "Im Restaurant",
      "expression": "salada",
      "translation": "Salat",
      "isVocabulary": true,
      "example": "Quero uma salada pequena.",
      "exampleTranslation": "Ich möchte einen kleinen Salat.",
      "explanation": "A salada bezeichnet einen Salat als Gericht."
    },
    {
      "id": "karte-05",
      "topic": "Im Restaurant",
      "expression": "carne",
      "translation": "Fleisch",
      "isVocabulary": true,
      "example": "Não como carne.",
      "exampleTranslation": "Ich esse kein Fleisch.",
      "explanation": "A carne; não como = ich esse nicht."
    },
    {
      "id": "karte-06",
      "topic": "Im Restaurant",
      "expression": "amendoim",
      "translation": "Erdnuss",
      "isVocabulary": true,
      "example": "Este prato tem amendoim?",
      "exampleTranslation": "Enthält dieses Gericht Erdnüsse?",
      "explanation": "O amendoim wird als Lebensmittel häufig im Singular verwendet."
    },
    {
      "id": "karte-07",
      "topic": "Im Restaurant",
      "expression": "pimenta",
      "translation": "Chili; Pfeffer",
      "isVocabulary": true,
      "example": "Sem pimenta, por favor.",
      "exampleTranslation": "Ohne Chili, bitte.",
      "explanation": "A pimenta bezeichnet hier Chili; schwarzer Pfeffer heißt pimenta-do-reino."
    },
    {
      "id": "karte-08",
      "topic": "Im Restaurant",
      "expression": "dividir",
      "translation": "teilen",
      "isVocabulary": true,
      "example": "Podemos dividir a conta?",
      "exampleTranslation": "Können wir die Rechnung teilen?",
      "explanation": "Dividir a conta bedeutet die Rechnung teilen."
    }
  ]
