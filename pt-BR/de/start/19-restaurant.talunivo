  "title": "19 \u00B7 Im Restaurant",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Restaurant",
      "expression": "mesa",
      "translation": "Tisch",
      "example": "Tem uma mesa para duas pessoas?",
      "exampleTranslation": "Ist ein Tisch f\u00FCr zwei Personen frei?",
      "explanation": "A mesa, Plural mesas. Para duas pessoas bedeutet f\u00FCr zwei Personen; duas richtet sich nach dem weiblichen pessoa. Die verk\u00FCrzte Tischfrage para dois ist ebenfalls gebr\u00E4uchlich.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Im Restaurant",
      "expression": "prato do dia",
      "translation": "Tagesgericht",
      "example": "Qual \u00E9 o prato do dia?",
      "exampleTranslation": "Was ist das Tagesgericht?",
      "explanation": "O prato do dia ist das Tagesgericht. Prato bedeutet hier Gericht, nicht der leere Teller als Gegenstand. Do ist de \u002B o; do dia hei\u00DFt hier des Tages.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Im Restaurant",
      "expression": "arroz",
      "translation": "Reis",
      "example": "Quero arroz, por favor.",
      "exampleTranslation": "Ich m\u00F6chte Reis, bitte.",
      "explanation": "O arroz bezeichnet hier Reis als Lebensmittel und steht im Singular. Quero arroz, por favor ist eine einfache Bestellung. Der Satz legt noch keine genaue Portionsgr\u00F6\u00DFe fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-03-2",
      "topic": "Im Restaurant",
      "expression": "feij\u00E3o",
      "translation": "Bohnen",
      "example": "O feij\u00E3o est\u00E1 gostoso.",
      "exampleTranslation": "Die Bohnen sind lecker.",
      "explanation": "O feij\u00E3o bezeichnet hier Bohnen als Lebensmittel oder Gericht. Im Portugiesischen steht der Ausdruck im Singular, die deutsche \u00DCbersetzung im Plural. Einzelne Bohnenk\u00F6rner kann man als gr\u00E3os de feij\u00E3o benennen; feij\u00F5es kann auch verschiedene Bohnensorten bezeichnen.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Im Restaurant",
      "expression": "peixe",
      "translation": "Fisch",
      "example": "O peixe vem com arroz?",
      "exampleTranslation": "Wird der Fisch mit Reis serviert?",
      "explanation": "O peixe, Plural peixes. Vem com arroz bedeutet im Restaurant hier wird mit Reis serviert oder kommt mit Reis. Die Frage betrifft die Beilage; sie nennt noch keinen Preis.",
      "isVocabulary": true
    },
    {
      "id": "karte-04-2",
      "topic": "Im Restaurant",
      "expression": "salada",
      "translation": "Salat",
      "example": "Quero uma salada pequena, por favor.",
      "exampleTranslation": "Ich m\u00F6chte einen kleinen Salat, bitte.",
      "explanation": "A salada, Plural saladas, ist ein Salat als Gericht. Uma und pequena richten sich nach dem weiblichen portugiesischen salada, obwohl Salat im Deutschen m\u00E4nnlich ist. Por favor erg\u00E4nzt die h\u00F6fliche Bitte.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Im Restaurant",
      "expression": "carne",
      "translation": "Fleisch",
      "example": "N\u00E3o como carne.",
      "exampleTranslation": "Ich esse kein Fleisch.",
      "explanation": "A carne ist Fleisch. Como hei\u00DFt hier ich esse; n\u00E3o verneint die Aussage. Der Satz nennt eine m\u00F6gliche Essenswahl, ohne einen Grund oder eine bestimmte Ern\u00E4hrung des Nutzers vorauszusetzen.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Im Restaurant",
      "expression": "amendoim",
      "translation": "Erdnuss",
      "example": "Este prato tem amendoim?",
      "exampleTranslation": "Enth\u00E4lt dieses Gericht Erdn\u00FCsse?",
      "explanation": "O amendoim bedeutet Erdnuss und wird als Zutat oft im Singular verwendet. Este prato hei\u00DFt dieses Gericht; tem fragt hier nach einer enthaltenen Zutat. Die deutsche Fassung verwendet nat\u00FCrlich Erdn\u00FCsse.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Im Restaurant",
      "expression": "pimenta",
      "translation": "Chili; Pfeffer",
      "example": "Sem pimenta, por favor.",
      "exampleTranslation": "Ohne Chili, bitte.",
      "explanation": "A pimenta meint in diesem Beispiel Chili. Das Wort kann je nach Zusammenhang auch Pfeffer bezeichnen; schwarzer Pfeffer hei\u00DFt ausdr\u00FCcklich pimenta-do-reino. Bei einer offenen Wortfrage sind daher mehrere \u00DCbersetzungen m\u00F6glich.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Im Restaurant",
      "expression": "dividir",
      "translation": "teilen",
      "example": "Podemos dividir a conta?",
      "exampleTranslation": "K\u00F6nnen wir die Rechnung teilen?",
      "explanation": "Dividir hei\u00DFt teilen. Podemos bedeutet k\u00F6nnen wir; a conta ist hier die Restaurantrechnung. Die Frage bittet um Rechnungsteilung, sagt aber noch nicht, wer welchen Betrag bezahlt.",
      "isVocabulary": true
    }
  ],
