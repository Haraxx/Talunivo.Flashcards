{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-19-restaurant",
  "packageVersion": 4,
  "title": "19 · Im Restaurant",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Restaurant",
      "expression": "mesa",
      "translation": "Tisch",
      "isVocabulary": true,
      "example": "Tem uma mesa para duas pessoas?",
      "exampleTranslation": "Ist ein Tisch für zwei Personen frei?",
      "explanation": "A mesa, Plural mesas. Para duas pessoas bedeutet für zwei Personen; duas richtet sich nach dem weiblichen pessoa. Die verkürzte Tischfrage para dois ist ebenfalls gebräuchlich."
    },
    {
      "id": "karte-02",
      "topic": "Im Restaurant",
      "expression": "prato do dia",
      "translation": "Tagesgericht",
      "isVocabulary": true,
      "example": "Qual é o prato do dia?",
      "exampleTranslation": "Was ist das Tagesgericht?",
      "explanation": "O prato do dia ist das Tagesgericht. Prato bedeutet hier Gericht, nicht der leere Teller als Gegenstand. Do ist de + o; do dia heißt hier des Tages."
    },
    {
      "id": "karte-03",
      "topic": "Im Restaurant",
      "expression": "arroz",
      "translation": "Reis",
      "isVocabulary": true,
      "example": "Quero arroz, por favor.",
      "exampleTranslation": "Ich möchte Reis, bitte.",
      "explanation": "O arroz bezeichnet hier Reis als Lebensmittel und steht im Singular. Quero arroz, por favor ist eine einfache Bestellung. Der Satz legt noch keine genaue Portionsgröße fest."
    },
    {
      "id": "karte-03-2",
      "topic": "Im Restaurant",
      "expression": "feijão",
      "translation": "Bohnen",
      "isVocabulary": true,
      "example": "O feijão está gostoso.",
      "exampleTranslation": "Die Bohnen sind lecker.",
      "explanation": "O feijão bezeichnet hier Bohnen als Lebensmittel oder Gericht. Im Portugiesischen steht der Ausdruck im Singular, die deutsche Übersetzung im Plural. Einzelne Bohnenkörner kann man als grãos de feijão benennen; feijões kann auch verschiedene Bohnensorten bezeichnen."
    },
    {
      "id": "karte-04",
      "topic": "Im Restaurant",
      "expression": "peixe",
      "translation": "Fisch",
      "isVocabulary": true,
      "example": "O peixe vem com arroz?",
      "exampleTranslation": "Wird der Fisch mit Reis serviert?",
      "explanation": "O peixe, Plural peixes. Vem com arroz bedeutet im Restaurant hier wird mit Reis serviert oder kommt mit Reis. Die Frage betrifft die Beilage; sie nennt noch keinen Preis."
    },
    {
      "id": "karte-04-2",
      "topic": "Im Restaurant",
      "expression": "salada",
      "translation": "Salat",
      "isVocabulary": true,
      "example": "Quero uma salada pequena, por favor.",
      "exampleTranslation": "Ich möchte einen kleinen Salat, bitte.",
      "explanation": "A salada, Plural saladas, ist ein Salat als Gericht. Uma und pequena richten sich nach dem weiblichen portugiesischen salada, obwohl Salat im Deutschen männlich ist. Por favor ergänzt die höfliche Bitte."
    },
    {
      "id": "karte-05",
      "topic": "Im Restaurant",
      "expression": "carne",
      "translation": "Fleisch",
      "isVocabulary": true,
      "example": "Não como carne.",
      "exampleTranslation": "Ich esse kein Fleisch.",
      "explanation": "A carne ist Fleisch. Como heißt hier ich esse; não verneint die Aussage. Der Satz nennt eine mögliche Essenswahl, ohne einen Grund oder eine bestimmte Ernährung des Nutzers vorauszusetzen."
    },
    {
      "id": "karte-06",
      "topic": "Im Restaurant",
      "expression": "amendoim",
      "translation": "Erdnuss",
      "isVocabulary": true,
      "example": "Este prato tem amendoim?",
      "exampleTranslation": "Enthält dieses Gericht Erdnüsse?",
      "explanation": "O amendoim bedeutet Erdnuss und wird als Zutat oft im Singular verwendet. Este prato heißt dieses Gericht; tem fragt hier nach einer enthaltenen Zutat. Die deutsche Fassung verwendet natürlich Erdnüsse."
    },
    {
      "id": "karte-07",
      "topic": "Im Restaurant",
      "expression": "pimenta",
      "translation": "Chili; Pfeffer",
      "isVocabulary": true,
      "example": "Sem pimenta, por favor.",
      "exampleTranslation": "Ohne Chili, bitte.",
      "explanation": "A pimenta meint in diesem Beispiel Chili. Das Wort kann je nach Zusammenhang auch Pfeffer bezeichnen; schwarzer Pfeffer heißt ausdrücklich pimenta-do-reino. Bei einer offenen Wortfrage sind daher mehrere Übersetzungen möglich."
    },
    {
      "id": "karte-08",
      "topic": "Im Restaurant",
      "expression": "dividir",
      "translation": "teilen",
      "isVocabulary": true,
      "example": "Podemos dividir a conta?",
      "exampleTranslation": "Können wir die Rechnung teilen?",
      "explanation": "Dividir heißt teilen. Podemos bedeutet können wir; a conta ist hier die Restaurantrechnung. Die Frage bittet um Rechnungsteilung, sagt aber noch nicht, wer welchen Betrag bezahlt."
    }
  ]
}
