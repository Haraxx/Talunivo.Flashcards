  "title": "41 \u00B7 Handy und Kontakt",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Handy und Kontakt",
      "expression": "n\u00FAmero",
      "translation": "Nummer",
      "example": "Qual \u00E9 o seu n\u00FAmero de telefone?",
      "exampleTranslation": "Wie lautet deine Telefonnummer?",
      "explanation": "O n\u00FAmero, Plural n\u00FAmeros, hei\u00DFt hier Nummer. N\u00FAmero de telefone bedeutet Telefonnummer. Qual \u00E9 o seu \u2026? fragt nach der Angabe der angesprochenen Person; der Satz enth\u00E4lt noch keine Ziffernfolge.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Handy und Kontakt",
      "expression": "mensagem",
      "translation": "Nachricht",
      "example": "Pode me mandar uma mensagem, por favor?",
      "exampleTranslation": "Kannst du mir bitte eine Nachricht schicken?",
      "explanation": "A mensagem, Plural mensagens, bedeutet Nachricht. Mandar uma mensagem hei\u00DFt eine Nachricht schicken. Me bezieht sich hier auf die sprechende Person als Empf\u00E4nger; im deutschen Satz steht mir. Ein bestimmter Nachrichtendienst wird nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Handy und Kontakt",
      "expression": "ligar",
      "translation": "anrufen",
      "example": "Vou te ligar amanh\u00E3.",
      "exampleTranslation": "Ich rufe dich morgen an.",
      "explanation": "Ligar hei\u00DFt im Telefonkontext anrufen. Vou \u002B Infinitiv k\u00FCndigt eine zuk\u00FCnftige Handlung an; te bezieht sich hier auf die angesprochene Person. Ligar para algu\u00E9m hei\u00DFt jemanden anrufen. Bei einem Ger\u00E4t kann ligar auch einschalten bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Handy und Kontakt",
      "expression": "bateria",
      "translation": "Akku",
      "example": "Meu celular est\u00E1 sem bateria.",
      "exampleTranslation": "Der Akku meines Handys ist leer.",
      "explanation": "A bateria, Plural baterias, bedeutet beim Handy Akku. Estar sem bateria hei\u00DFt hier keine Akkuladung mehr haben. Der Satz beschreibt einen leeren Akku und sagt nicht, dass das Bauteil im Handy fehlt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Handy und Kontakt",
      "expression": "tomada",
      "translation": "Steckdose",
      "example": "Tem uma tomada aqui?",
      "exampleTranslation": "Gibt es hier eine Steckdose?",
      "explanation": "A tomada, Plural tomadas, ist die Steckdose. Tem \u2026? fragt im brasilianischen Alltagsgebrauch hier nach dem Vorhandensein; aqui hei\u00DFt hier. Die Frage enth\u00E4lt noch keine Angabe zur Nutzung der Steckdose.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Handy und Kontakt",
      "expression": "carregar",
      "translation": "aufladen",
      "example": "Posso carregar meu celular?",
      "exampleTranslation": "Kann ich mein Handy aufladen?",
      "explanation": "Carregar hei\u00DFt hier aufladen; carregar o celular bedeutet das Handy aufladen. Posso ist die Ich-Form von poder. Die Frage kann je nach Situation nach einer M\u00F6glichkeit oder Erlaubnis fragen; andere Bedeutungen von carregar sind etwa tragen oder beladen.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Handy und Kontakt",
      "expression": "sinal",
      "translation": "Empfang; Signal",
      "example": "N\u00E3o tenho sinal aqui.",
      "exampleTranslation": "Ich habe hier keinen Empfang.",
      "explanation": "O sinal, Plural sinais, hei\u00DFt Signal; im Handygespr\u00E4ch ist hier Mobilfunkempfang gemeint. N\u00E3o tenho verneint ich habe, aqui nennt den aktuellen Ort. Der Satz macht keine Aussage \u00FCber eine bestimmte Netzabdeckung au\u00DFerhalb der Beispielsituation.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Handy und Kontakt",
      "expression": "e-mail",
      "translation": "E-Mail",
      "example": "Pode escrever seu endere\u00E7o de e-mail, por favor?",
      "exampleTranslation": "Kannst du deine E-Mail-Adresse bitte aufschreiben?",
      "explanation": "O e-mail, Plural e-mails, bezeichnet eine E-Mail. Endere\u00E7o de e-mail ist die E-Mail-Adresse; danach wird hier gefragt. Pode escrever \u2026? bittet um das Aufschreiben, nicht um das Versenden einer Nachricht.",
      "isVocabulary": true
    }
  ],
