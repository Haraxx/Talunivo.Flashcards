      "expression": "mensagem",
      "translation": "Nachricht",
      "isVocabulary": true,
      "example": "Pode me mandar uma mensagem?",
      "exampleTranslation": "Kannst du mir eine Nachricht schicken?",
      "explanation": "A mensagem; mandar uma mensagem = eine Nachricht schicken."
    },
