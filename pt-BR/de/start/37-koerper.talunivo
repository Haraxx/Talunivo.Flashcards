  "cards": [
    {
      "id": "karte-01",
      "topic": "K\u00F6rper und Befinden",
      "expression": "cabe\u00E7a",
      "translation": "Kopf",
      "example": "Estou com dor de cabe\u00E7a.",
      "exampleTranslation": "Ich habe Kopfschmerzen.",
      "explanation": "A cabe\u00E7a, Plural cabe\u00E7as, ist der Kopf. Dor de cabe\u00E7a bedeutet Kopfschmerzen. Estou com \u2026 beschreibt hier das aktuelle Befinden; das portugiesische Muster verwendet com, die deutsche Wiedergabe haben.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "K\u00F6rper und Befinden",
      "expression": "garganta",
      "translation": "Hals; Rachen",
      "example": "Estou com dor de garganta.",
      "exampleTranslation": "Ich habe Halsschmerzen.",
      "explanation": "A garganta, Plural gargantas, bezeichnet den inneren Hals beziehungsweise Rachen. Dor de garganta hei\u00DFt Halsschmerzen. Das Beispiel wiederholt estou com \u002B Beschwerde, ohne eine Ursache zu nennen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "K\u00F6rper und Befinden",
      "expression": "bra\u00E7o",
      "translation": "Arm",
      "example": "Meu bra\u00E7o d\u00F3i.",
      "exampleTranslation": "Mein Arm tut weh.",
      "explanation": "O bra\u00E7o, Plural bra\u00E7os, ist der Arm. Meu passt zum m\u00E4nnlichen Nomen bra\u00E7o. D\u00F3i geh\u00F6rt zum Verb doer und bedeutet hier tut weh; der Satz beschreibt einen einzelnen Arm.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "K\u00F6rper und Befinden",
      "expression": "perna",
      "translation": "Bein",
      "example": "Minha perna est\u00E1 cansada.",
      "exampleTranslation": "Mein Bein ist m\u00FCde.",
      "explanation": "A perna, Plural pernas, hei\u00DFt Bein. Minha und cansada passen zur weiblichen Form perna. Diese Formen beziehen sich auf das Bein, nicht auf das Geschlecht der sprechenden Person.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "K\u00F6rper und Befinden",
      "expression": "p\u00E9s",
      "translation": "F\u00FC\u00DFe",
      "example": "Preciso descansar os p\u00E9s.",
      "exampleTranslation": "Ich muss meine F\u00FC\u00DFe ausruhen.",
      "explanation": "O p\u00E9 hei\u00DFt Fu\u00DF, os p\u00E9s hei\u00DFt die F\u00FC\u00DFe. Der Akut bleibt im Plural erhalten. Preciso descansar hei\u00DFt ich muss ausruhen; bei den eigenen K\u00F6rperteilen verwendet das Portugiesische hier den Artikel os, das Deutsche meine.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "K\u00F6rper und Befinden",
      "expression": "m\u00E3os",
      "translation": "H\u00E4nde",
      "example": "Lave as m\u00E3os, por favor.",
      "exampleTranslation": "Wasch dir bitte die H\u00E4nde.",
      "explanation": "A m\u00E3o hei\u00DFt Hand, as m\u00E3os hei\u00DFt die H\u00E4nde. Das Wort ist trotz der Endung -\u00E3o weiblich. Lave ist hier die Aufforderungsform von lavar zur Ansprache mit voc\u00EA; por favor macht die Bitte ausdr\u00FCcklich.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "K\u00F6rper und Befinden",
      "expression": "barriga",
      "translation": "Bauch",
      "example": "Estou com dor de barriga.",
      "exampleTranslation": "Ich habe Bauchschmerzen.",
      "explanation": "A barriga, Plural barrigas, hei\u00DFt Bauch. Dor de barriga bedeutet Bauchschmerzen. Das bekannte Muster estou com \u2026 beschreibt die Beschwerde; barriga bezeichnet nicht ausschlie\u00DFlich den Magen.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "K\u00F6rper und Befinden",
      "expression": "olhos",
      "translation": "Augen",
      "example": "Meus olhos est\u00E3o vermelhos.",
      "exampleTranslation": "Meine Augen sind rot.",
      "explanation": "O olho hei\u00DFt Auge, os olhos hei\u00DFt die Augen. Meus und vermelhos stehen wie olhos im m\u00E4nnlichen Plural. Est\u00E3o ist die Mehrzahlform zu est\u00E1; der Satz beschreibt einen sichtbaren Zustand.",
      "isVocabulary": true
    }
  ],
