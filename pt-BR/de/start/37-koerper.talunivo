  "cards": [
    {
      "id": "karte-01",
      "topic": "Körper und Befinden",
      "expression": "cabeça",
      "translation": "Kopf",
      "isVocabulary": true,
      "example": "Estou com dor de cabeça.",
      "exampleTranslation": "Ich habe Kopfschmerzen.",
      "explanation": "A cabeça, Plural cabeças, ist der Kopf. Dor de cabeça bedeutet Kopfschmerzen. Estou com … beschreibt hier das aktuelle Befinden; das portugiesische Muster verwendet com, die deutsche Wiedergabe haben."
    },
    {
      "id": "karte-02",
      "topic": "Körper und Befinden",
      "expression": "garganta",
      "translation": "Hals; Rachen",
      "isVocabulary": true,
      "example": "Estou com dor de garganta.",
      "exampleTranslation": "Ich habe Halsschmerzen.",
      "explanation": "A garganta, Plural gargantas, bezeichnet den inneren Hals beziehungsweise Rachen. Dor de garganta heißt Halsschmerzen. Das Beispiel wiederholt estou com + Beschwerde, ohne eine Ursache zu nennen."
    },
    {
      "id": "karte-03",
      "topic": "Körper und Befinden",
      "expression": "braço",
      "translation": "Arm",
      "isVocabulary": true,
      "example": "Meu braço dói.",
      "exampleTranslation": "Mein Arm tut weh.",
      "explanation": "O braço, Plural braços, ist der Arm. Meu passt zum männlichen Nomen braço. Dói gehört zum Verb doer und bedeutet hier tut weh; der Satz beschreibt einen einzelnen Arm."
    },
    {
      "id": "karte-04",
      "topic": "Körper und Befinden",
      "expression": "perna",
      "translation": "Bein",
      "isVocabulary": true,
      "example": "Minha perna está cansada.",
      "exampleTranslation": "Mein Bein ist müde.",
      "explanation": "A perna, Plural pernas, heißt Bein. Minha und cansada passen zur weiblichen Form perna. Diese Formen beziehen sich auf das Bein, nicht auf das Geschlecht der sprechenden Person."
    },
    {
      "id": "karte-05",
      "topic": "Körper und Befinden",
      "expression": "pés",
      "translation": "Füße",
      "isVocabulary": true,
      "example": "Preciso descansar os pés.",
      "exampleTranslation": "Ich muss meine Füße ausruhen.",
      "explanation": "O pé heißt Fuß, os pés heißt die Füße. Der Akut bleibt im Plural erhalten. Preciso descansar heißt ich muss ausruhen; bei den eigenen Körperteilen verwendet das Portugiesische hier den Artikel os, das Deutsche meine."
    },
    {
      "id": "karte-06",
      "topic": "Körper und Befinden",
      "expression": "mãos",
      "translation": "Hände",
      "isVocabulary": true,
      "example": "Lave as mãos, por favor.",
      "exampleTranslation": "Wasch dir bitte die Hände.",
      "explanation": "A mão heißt Hand, as mãos heißt die Hände. Das Wort ist trotz der Endung -ão weiblich. Lave ist hier die Aufforderungsform von lavar zur Ansprache mit você; por favor macht die Bitte ausdrücklich."
    },
    {
      "id": "karte-07",
      "topic": "Körper und Befinden",
      "expression": "barriga",
      "translation": "Bauch",
      "isVocabulary": true,
      "example": "Estou com dor de barriga.",
      "exampleTranslation": "Ich habe Bauchschmerzen.",
      "explanation": "A barriga, Plural barrigas, heißt Bauch. Dor de barriga bedeutet Bauchschmerzen. Das bekannte Muster estou com … beschreibt die Beschwerde; barriga bezeichnet nicht ausschließlich den Magen."
    },
    {
      "id": "karte-08",
      "topic": "Körper und Befinden",
      "expression": "olhos",
      "translation": "Augen",
      "isVocabulary": true,
      "example": "Meus olhos estão vermelhos.",
      "exampleTranslation": "Meine Augen sind rot.",
      "explanation": "O olho heißt Auge, os olhos heißt die Augen. Meus und vermelhos stehen wie olhos im männlichen Plural. Estão ist die Mehrzahlform zu está; der Satz beschreibt einen sichtbaren Zustand."
    }
  ]
}
