  "cards": [
    {
      "id": "karte-01",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "hoje",
      "translation": "heute",
      "example": "Hoje estou bem.",
      "exampleTranslation": "Heute geht es mir gut.",
      "explanation": "Hoje bedeutet heute. Hoje estou bem hei\u00DFt heute geht es mir gut. Das Wort bezeichnet den heutigen Tag; es ver\u00E4ndert seine Form nicht.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "bem",
      "translation": "gut",
      "example": "Estou bem, e voc\u00EA?",
      "exampleTranslation": "Mir geht es gut, und dir?",
      "explanation": "Bem beschreibt hier, wie es jemandem geht: estou bem = mir geht es gut. E voc\u00EA? fragt zur\u00FCck: und dir? Bem bleibt unver\u00E4ndert; die Form h\u00E4ngt nicht von der sprechenden Person ab.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "feliz",
      "translation": "gl\u00FCcklich",
      "example": "Estou feliz.",
      "exampleTranslation": "Ich bin gl\u00FCcklich.",
      "explanation": "Feliz bedeutet gl\u00FCcklich. Die Einzahl ist bei m\u00E4nnlichem und weiblichem Bezug gleich; die Mehrzahl hei\u00DFt felizes. Estou feliz beschreibt hier das aktuelle Gef\u00FChl.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "triste",
      "translation": "traurig",
      "example": "Estou triste.",
      "exampleTranslation": "Ich bin traurig.",
      "explanation": "Triste bedeutet traurig. Die Einzahl ist bei m\u00E4nnlichem und weiblichem Bezug gleich; die Mehrzahl hei\u00DFt tristes. Estou triste beschreibt hier das aktuelle Gef\u00FChl.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "cansado",
      "translation": "m\u00FCde (m\u00E4nnlich)",
      "example": "Estou cansado.",
      "exampleTranslation": "Ich bin m\u00FCde.",
      "explanation": "Cansado ist die m\u00E4nnliche Einzahl, cansada die weibliche. Estou cansado bedeutet ich bin m\u00FCde, wenn die sprechende Person die m\u00E4nnliche Form verwendet. Die Form wird nicht aus einem Avatar abgeleitet.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "cansada",
      "translation": "m\u00FCde (weiblich)",
      "example": "Estou cansada.",
      "exampleTranslation": "Ich bin m\u00FCde.",
      "explanation": "Cansada ist die weibliche Einzahl, cansado die m\u00E4nnliche. Estou cansada bedeutet ich bin m\u00FCde, wenn die sprechende Person die weibliche Form verwendet. Beide Beispiels\u00E4tze haben dieselbe deutsche \u00DCbersetzung.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "tudo",
      "translation": "alles",
      "example": "Est\u00E1 tudo bem.",
      "exampleTranslation": "Es ist alles in Ordnung.",
      "explanation": "Tudo bedeutet alles. Est\u00E1 tudo bem. ist hier eine Aussage: Es ist alles in Ordnung. Tudo bem? ist dagegen eine kurze Frage nach dem Befinden: Alles gut?",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Befinden und Gef\u00FChle",
      "expression": "mais ou menos",
      "translation": "so einigerma\u00DFen",
      "example": "Mais ou menos.",
      "exampleTranslation": "So einigerma\u00DFen.",
      "explanation": "Als Antwort auf Tudo bem? bedeutet mais ou menos so einigerma\u00DFen. Die Wendung hat je nach Kontext andere Anwendungen, etwa ungef\u00E4hr bei einer Menge. Hier wird das Befinden ge\u00FCbt.",
      "isVocabulary": true
    }
  ],
