      "expression": "usar",
      "translation": "benutzen",
      "isVocabulary": true,
      "example": "Pode usar meu telefone.",
      "exampleTranslation": "Du darfst mein Telefon benutzen.",
      "explanation": "Pode usar = du darfst benutzen."
    },
    {
