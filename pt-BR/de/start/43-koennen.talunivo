      "topic": "Können und Erlaubnis",
      "expression": "abrir",
      "translation": "öffnen",
      "isVocabulary": true,
      "example": "Você pode abrir isto?",
      "exampleTranslation": "Kannst du das hier öffnen?",
      "explanation": "Abrir isto = das hier öffnen."
