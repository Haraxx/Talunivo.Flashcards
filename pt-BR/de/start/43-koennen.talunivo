      "topic": "Können und Erlaubnis",
      "expression": "sair",
      "translation": "weggehen",
      "isVocabulary": true,
      "example": "Não posso sair agora.",
      "exampleTranslation": "Ich kann jetzt nicht weggehen.",
      "explanation": "Sair bedeutet je nach Kontext weggehen, ausgehen oder losgehen."
    },
