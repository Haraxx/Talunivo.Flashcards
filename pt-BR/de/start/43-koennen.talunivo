      "topic": "Können und Erlaubnis",
      "expression": "sentar",
      "translation": "sich setzen",
      "isVocabulary": true,
      "example": "Posso sentar aqui?",
      "exampleTranslation": "Darf ich mich hier hinsetzen?",
      "explanation": "Sentar aqui = sich hier hinsetzen; auch sentar-se ist möglich."
    },
