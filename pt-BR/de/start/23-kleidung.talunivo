      "id": "karte-01",
      "topic": "Kleidung und Größen",
      "expression": "camiseta",
      "translation": "T-Shirt",
      "isVocabulary": true,
      "example": "Esta camiseta é azul.",
      "exampleTranslation": "Dieses T-Shirt ist blau.",
      "explanation": "A camiseta, Plural camisetas, ist ein T-Shirt. Esta passt zum weiblichen Nomen; azul bleibt in der Einzahl unverändert. Camisa ist dagegen ein Hemd und nicht dieselbe Bezeichnung."
    },
    {
      "id": "karte-02",
      "topic": "Kleidung und Größen",
      "expression": "calça",
      "translation": "Hose",
      "isVocabulary": true,
      "example": "Preciso de uma calça.",
      "exampleTranslation": "Ich brauche eine Hose.",
      "explanation": "A calça, Plural calças. Uma calça steht im Portugiesischen für eine einzelne Hose, nicht für mehrere Hosen. Preciso de … ist das bereits bekannte Muster ich brauche …"
    },
    {
      "id": "karte-03",
      "topic": "Kleidung und Größen",
      "expression": "maior",
      "translation": "größer",
      "isVocabulary": true,
      "example": "Tem um tamanho maior?",
      "exampleTranslation": "Gibt es eine größere Größe?",
      "explanation": "Maior ist die unregelmäßige Vergleichsform von grande: größer. Tamanho heißt Größe. Tem um tamanho maior? fragt nach einer größeren Ausführung; maior verändert sich hier nicht nach dem Genus."
    },
    {
      "id": "karte-04",
      "topic": "Kleidung und Größen",
      "expression": "menor",
      "translation": "kleiner",
      "isVocabulary": true,
      "example": "Tem um tamanho menor?",
      "exampleTranslation": "Gibt es eine kleinere Größe?",
      "explanation": "Menor ist die unregelmäßige Vergleichsform von pequeno: kleiner. Das Muster ist dasselbe wie bei maior, aber die Vergleichsrichtung ist umgekehrt. Eine bestimmte Größennummer wird damit nicht genannt."
    },
    {
      "id": "karte-05",
      "topic": "Kleidung und Größen",
      "expression": "jaqueta",
      "translation": "Jacke",
      "isVocabulary": true,
      "example": "Posso experimentar esta jaqueta?",
      "exampleTranslation": "Kann ich diese Jacke anprobieren?",
      "explanation": "A jaqueta, Plural jaquetas, ist eine Jacke. Experimentar heißt im Kleidungsgeschäft hier anprobieren. Posso …? fragt nach Erlaubnis; esta bezieht sich auf die gezeigte Jacke."
    },
    {
      "id": "karte-06",
      "topic": "Kleidung und Größen",
      "expression": "provador",
      "translation": "Umkleidekabine",
      "isVocabulary": true,
      "example": "Onde fica o provador?",
      "exampleTranslation": "Wo ist die Umkleidekabine?",
      "explanation": "O provador, Plural provadores, ist hier die Umkleidekabine im Geschäft. Onde fica …? ist die bekannte Ortsfrage. Gemeint ist der Ort zum Anprobieren, nicht eine bestimmte Kleidungsgröße."
    },
    {
      "id": "karte-07",
      "topic": "Kleidung und Größen",
      "expression": "sapatos",
      "translation": "Schuhe",
      "isVocabulary": true,
      "example": "Estes sapatos estão apertados.",
      "exampleTranslation": "Diese Schuhe sind zu eng.",
      "explanation": "O sapato ist ein Schuh; sapatos ist die Mehrzahl. Estes und apertados sind männliche Mehrzahlformen passend zu sapatos. Estão apertados bedeutet hier sind zu eng; eine genaue Schuhgröße wird nicht genannt."
    },
    {
      "id": "karte-08",
      "topic": "Kleidung und Größen",
      "expression": "boa",
      "translation": "gut (weiblich)",
      "isVocabulary": true,
      "example": "Esta camiseta ficou boa.",
      "exampleTranslation": "Dieses T-Shirt passt gut.",
      "explanation": "Boa ist die weibliche Form von bom und richtet sich hier nach camiseta. Ficou ist eine Vergangenheitsform von ficar; im Anprobekontext beschreibt ficou boa das Ergebnis: passt gut oder steht gut. Die passende deutsche Fassung hängt von der Situation ab."
    }
  ]
