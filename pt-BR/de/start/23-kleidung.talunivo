  "title": "23 · Kleidung und Größen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Kleidung und Größen",
      "expression": "Procuro uma camiseta.",
      "translation": "Ich suche ein T-Shirt.",
      "explanation": "procurar = suchen; camiseta = T-Shirt.",
      "example": "Esta camiseta está apertada. Tem um tamanho maior?",
      "exampleTranslation": "Dieses T-Shirt ist zu eng. Gibt es eine größere Größe?"
    },
    {
      "id": "karte-02",
      "topic": "Kleidung und Größen",
      "expression": "Preciso de uma calça.",
      "translation": "Ich brauche eine Hose.",
      "explanation": "calça ist in Brasilien ein übliches Wort für Hose."
    },
    {
      "id": "karte-03",
      "topic": "Kleidung und Größen",
      "expression": "Tem um tamanho maior?",
      "translation": "Gibt es eine größere Größe?",
      "explanation": "tamanho = Größe; maior = größer."
    },
    {
      "id": "karte-04",
      "topic": "Kleidung und Größen",
      "expression": "Tem um tamanho menor?",
      "translation": "Gibt es eine kleinere Größe?",
      "explanation": "menor = kleiner."
    },
    {
      "id": "karte-05",
      "topic": "Kleidung und Größen",
      "expression": "Posso experimentar esta jaqueta?",
      "translation": "Kann ich diese Jacke anprobieren?",
      "explanation": "experimentar bedeutet hier anprobieren."
    },
    {
      "id": "karte-06",
      "topic": "Kleidung und Größen",
      "expression": "Onde fica o provador?",
      "translation": "Wo ist die Umkleidekabine?",
      "explanation": "provador = Umkleidekabine im Laden."
    },
    {
      "id": "karte-07",
      "topic": "Kleidung und Größen",
      "expression": "Estes sapatos estão apertados.",
      "translation": "Diese Schuhe sind zu eng.",
      "explanation": "apertados = eng; sapatos = Schuhe."
    },
    {
      "id": "karte-08",
      "topic": "Kleidung und Größen",
      "expression": "Esta camiseta ficou boa.",
      "translation": "Dieses T-Shirt passt gut.",
      "explanation": "ficou boa sagt hier, dass das Kleidungsstück gut passt."
    }
  ]
}
