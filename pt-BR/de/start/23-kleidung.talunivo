  "cards": [
    {
      "id": "karte-01",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "camiseta",
      "translation": "T-Shirt",
      "example": "Esta camiseta \u00E9 azul.",
      "exampleTranslation": "Dieses T-Shirt ist blau.",
      "explanation": "A camiseta, Plural camisetas, ist ein T-Shirt. Esta passt zum weiblichen Nomen; azul bleibt in der Einzahl unver\u00E4ndert. Camisa ist dagegen ein Hemd und nicht dieselbe Bezeichnung.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "cal\u00E7a",
      "translation": "Hose",
      "example": "Preciso de uma cal\u00E7a.",
      "exampleTranslation": "Ich brauche eine Hose.",
      "explanation": "A cal\u00E7a, Plural cal\u00E7as. Uma cal\u00E7a steht im Portugiesischen f\u00FCr eine einzelne Hose, nicht f\u00FCr mehrere Hosen. Preciso de \u2026 ist das bereits bekannte Muster ich brauche \u2026",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "maior",
      "translation": "gr\u00F6\u00DFer",
      "example": "Tem um tamanho maior?",
      "exampleTranslation": "Gibt es eine gr\u00F6\u00DFere Gr\u00F6\u00DFe?",
      "explanation": "Maior ist die unregelm\u00E4\u00DFige Vergleichsform von grande: gr\u00F6\u00DFer. Tamanho hei\u00DFt Gr\u00F6\u00DFe. Tem um tamanho maior? fragt nach einer gr\u00F6\u00DFeren Ausf\u00FChrung; maior ver\u00E4ndert sich hier nicht nach dem Genus.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "menor",
      "translation": "kleiner",
      "example": "Tem um tamanho menor?",
      "exampleTranslation": "Gibt es eine kleinere Gr\u00F6\u00DFe?",
      "explanation": "Menor ist die unregelm\u00E4\u00DFige Vergleichsform von pequeno: kleiner. Das Muster ist dasselbe wie bei maior, aber die Vergleichsrichtung ist umgekehrt. Eine bestimmte Gr\u00F6\u00DFennummer wird damit nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "jaqueta",
      "translation": "Jacke",
      "example": "Posso experimentar esta jaqueta?",
      "exampleTranslation": "Kann ich diese Jacke anprobieren?",
      "explanation": "A jaqueta, Plural jaquetas, ist eine Jacke. Experimentar hei\u00DFt im Kleidungsgesch\u00E4ft hier anprobieren. Posso \u2026? fragt nach Erlaubnis; esta bezieht sich auf die gezeigte Jacke.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "provador",
      "translation": "Umkleidekabine",
      "example": "Onde fica o provador?",
      "exampleTranslation": "Wo ist die Umkleidekabine?",
      "explanation": "O provador, Plural provadores, ist hier die Umkleidekabine im Gesch\u00E4ft. Onde fica \u2026? ist die bekannte Ortsfrage. Gemeint ist der Ort zum Anprobieren, nicht eine bestimmte Kleidungsgr\u00F6\u00DFe.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "sapatos",
      "translation": "Schuhe",
      "example": "Estes sapatos est\u00E3o apertados.",
      "exampleTranslation": "Diese Schuhe sind zu eng.",
      "explanation": "O sapato ist ein Schuh; sapatos ist die Mehrzahl. Estes und apertados sind m\u00E4nnliche Mehrzahlformen passend zu sapatos. Est\u00E3o apertados bedeutet hier sind zu eng; eine genaue Schuhgr\u00F6\u00DFe wird nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Kleidung und Gr\u00F6\u00DFen",
      "expression": "boa",
      "translation": "gut (weiblich)",
      "example": "Esta camiseta ficou boa.",
      "exampleTranslation": "Dieses T-Shirt passt gut.",
      "explanation": "Boa ist die weibliche Form von bom und richtet sich hier nach camiseta. Ficou ist eine Vergangenheitsform von ficar; im Anprobekontext beschreibt ficou boa das Ergebnis: passt gut oder steht gut. Die passende deutsche Fassung h\u00E4ngt von der Situation ab.",
      "isVocabulary": true
    }
  ],
