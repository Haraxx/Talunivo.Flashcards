      "topic": "Kleine Probleme im Hotel",
      "expression": "perder",
      "translation": "verlieren",
      "isVocabulary": true,
      "example": "Perdi a chave do quarto.",
      "exampleTranslation": "Ich habe den Zimmerschlüssel verloren.",
      "explanation": "Perdi ist Vergangenheit: ich habe verloren."
    },
