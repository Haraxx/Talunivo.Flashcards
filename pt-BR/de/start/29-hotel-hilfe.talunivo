    {
      "id": "karte-01",
      "topic": "Kleine Probleme im Hotel",
      "expression": "ar-condicionado",
      "translation": "Klimaanlage",
      "example": "O ar-condicionado n\u00E3o funciona.",
      "exampleTranslation": "Die Klimaanlage funktioniert nicht.",
      "explanation": "O ar-condicionado ist die Klimaanlage und wird mit Bindestrich geschrieben. N\u00E3o funciona hei\u00DFt funktioniert nicht. Der kurze Satz benennt hier das Problem; eine weitere Bitte kann anschlie\u00DFend folgen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Kleine Probleme im Hotel",
      "expression": "\u00E1gua quente",
      "translation": "warmes Wasser",
      "example": "N\u00E3o tem \u00E1gua quente.",
      "exampleTranslation": "Es gibt kein warmes Wasser.",
      "explanation": "\u00C1gua quente ist hier warmes Wasser. Quente bleibt in der Einzahl bei m\u00E4nnlichen und weiblichen Nomen gleich und kann je nach Zusammenhang auch hei\u00DF bedeuten. N\u00E3o tem \u2026 hei\u00DFt im brasilianischen Alltag hier es gibt kein \u2026",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Kleine Probleme im Hotel",
      "expression": "toalha",
      "translation": "Handtuch",
      "example": "Preciso de uma toalha limpa.",
      "exampleTranslation": "Ich brauche ein sauberes Handtuch.",
      "explanation": "A toalha, Plural toalhas, ist hier ein Handtuch. Limpa hei\u00DFt sauber und ist weiblich wegen toalha. Preciso de \u2026 ist das bekannte Bedarfsmuster; der Satz bittet im Hotelkontext um ein sauberes Handtuch.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Kleine Probleme im Hotel",
      "expression": "limpar",
      "translation": "reinigen",
      "example": "Pode limpar o quarto amanh\u00E3?",
      "exampleTranslation": "K\u00F6nnen Sie das Zimmer morgen reinigen?",
      "explanation": "Limpar bedeutet reinigen oder sauber machen. Pode limpar \u2026? ist hier eine h\u00F6fliche Bitte; o quarto ist das Hotelzimmer. Amanh\u00E3 bedeutet morgen und nennt den gew\u00FCnschten Tag, noch keine bestimmte Uhrzeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Kleine Probleme im Hotel",
      "expression": "perder",
      "translation": "verlieren",
      "example": "Perdi a chave do quarto.",
      "exampleTranslation": "Ich habe den Zimmerschl\u00FCssel verloren.",
      "explanation": "Perder bedeutet verlieren. Perdi ist hier die Vergangenheitsform ich habe verloren. A chave do quarto ist der Zimmerschl\u00FCssel aus dem vorherigen Paket; es wird ein bereits geschehenes Problem beschrieben.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Kleine Probleme im Hotel",
      "expression": "cobertor",
      "translation": "Decke",
      "example": "Tem um cobertor extra?",
      "exampleTranslation": "Gibt es eine zus\u00E4tzliche Decke?",
      "explanation": "O cobertor, Plural cobertores, ist eine w\u00E4rmende Decke, etwa f\u00FCrs Bett. Extra bedeutet zus\u00E4tzlich. Die deutsche Decke meint hier keine Zimmerdecke; die Frage betrifft ein Ausstattungsst\u00FCck.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Kleine Probleme im Hotel",
      "expression": "barulhento",
      "translation": "laut",
      "example": "O quarto est\u00E1 muito barulhento.",
      "exampleTranslation": "Das Zimmer ist sehr laut.",
      "explanation": "Barulhento bedeutet hier laut beziehungsweise voller st\u00F6render Ger\u00E4usche. Die m\u00E4nnliche Form richtet sich nach o quarto; weiblich hei\u00DFt es barulhenta. Muito verst\u00E4rkt die Beschreibung zu sehr laut.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Kleine Probleme im Hotel",
      "expression": "trocar",
      "translation": "wechseln",
      "example": "Posso trocar de quarto?",
      "exampleTranslation": "Kann ich das Zimmer wechseln?",
      "explanation": "Trocar de quarto hei\u00DFt das Zimmer wechseln. Vergleiche trocar de linha aus Paket 26: Das Muster trocar de \u2026 bleibt gleich, der Bezug \u00E4ndert sich. Posso \u2026? fragt hier nach der M\u00F6glichkeit eines Wechsels.",
      "isVocabulary": true
    }
  ],
