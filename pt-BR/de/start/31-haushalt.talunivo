  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Haushalt",
      "expression": "lou\u00E7a",
      "translation": "Geschirr",
      "example": "Lavo a lou\u00E7a depois do almo\u00E7o.",
      "exampleTranslation": "Ich sp\u00FCle nach dem Mittagessen das Geschirr.",
      "explanation": "A lou\u00E7a bezeichnet hier das Geschirr als Gesamtheit. Lavar a lou\u00E7a hei\u00DFt das Geschirr sp\u00FClen; lavo ist die Ich-Form von lavar. Depois do almo\u00E7o bedeutet nach dem Mittagessen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Im Haushalt",
      "expression": "roupa",
      "translation": "W\u00E4sche; Kleidung",
      "example": "Preciso lavar a roupa.",
      "exampleTranslation": "Ich muss die W\u00E4sche waschen.",
      "explanation": "A roupa bedeutet Kleidung oder, beim Waschen, W\u00E4sche. Preciso lavar hei\u00DFt ich muss waschen: Nach preciso folgt hier der Infinitiv. F\u00FCr einzelne Kleidungsst\u00FCcke kann man pe\u00E7as de roupa sagen.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Im Haushalt",
      "expression": "cama",
      "translation": "Bett",
      "example": "Vou arrumar a cama.",
      "exampleTranslation": "Ich werde das Bett machen.",
      "explanation": "A cama, Plural camas, ist das Bett. Arrumar a cama bedeutet das Bett machen. Vou \u002B Infinitiv k\u00FCndigt hier eine beabsichtigte Handlung an.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Im Haushalt",
      "expression": "fechar",
      "translation": "schlie\u00DFen",
      "example": "Pode fechar a janela, por favor?",
      "exampleTranslation": "Kannst du bitte das Fenster schlie\u00DFen?",
      "explanation": "Fechar hei\u00DFt schlie\u00DFen. A janela ist das Fenster. Pode \u002B Infinitiv fragt hier h\u00F6flich nach einer Handlung; por favor erg\u00E4nzt die Bitte. Das Gegenteil von fechar ist abrir.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Im Haushalt",
      "expression": "abrir",
      "translation": "\u00F6ffnen",
      "example": "Pode abrir a porta, por favor?",
      "exampleTranslation": "Kannst du bitte die T\u00FCr \u00F6ffnen?",
      "explanation": "Abrir hei\u00DFt \u00F6ffnen; a porta ist die T\u00FCr. Pode abrir \u2026? ist eine Bitte, etwas zu \u00F6ffnen. Fechar bedeutet dagegen schlie\u00DFen. Das Verb bleibt nach pode im Infinitiv.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Im Haushalt",
      "expression": "luz",
      "translation": "Licht",
      "example": "A luz est\u00E1 acesa.",
      "exampleTranslation": "Das Licht ist an.",
      "explanation": "A luz, Plural luzes, bedeutet Licht. Acesa hei\u00DFt hier an oder eingeschaltet und passt zur weiblichen Form luz. Est\u00E1 beschreibt den aktuellen Zustand.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Im Haushalt",
      "expression": "apagar",
      "translation": "ausschalten",
      "example": "Apague a luz, por favor.",
      "exampleTranslation": "Mach bitte das Licht aus.",
      "explanation": "Apagar a luz hei\u00DFt das Licht ausschalten. Apague ist hier die Aufforderungsform zur Ansprache mit voc\u00EA. Apagar kann in anderem Kontext l\u00F6schen bedeuten; f\u00FCr Ger\u00E4te wird h\u00E4ufig desligar verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Im Haushalt",
      "expression": "lixo",
      "translation": "M\u00FCll",
      "example": "O lixo fica l\u00E1 fora.",
      "exampleTranslation": "Der M\u00FCll ist drau\u00DFen.",
      "explanation": "O lixo bezeichnet M\u00FCll als Sammelbegriff. Fica nennt hier den Ort; l\u00E1 fora bedeutet dort drau\u00DFen. Der Satz sagt, wo der M\u00FCll ist, und fordert nicht zum Hinaustragen auf.",
      "isVocabulary": true
    }
  ],
