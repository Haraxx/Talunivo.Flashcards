  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Haushalt",
      "expression": "louça",
      "translation": "Geschirr",
      "isVocabulary": true,
      "example": "Depois do almoço, lavo a louça.",
      "exampleTranslation": "Nach dem Mittagessen spüle ich das Geschirr.",
      "explanation": "A louça; lavar a louça = das Geschirr spülen."
    },
    {
      "id": "karte-02",
      "topic": "Im Haushalt",
      "expression": "roupa",
      "translation": "Wäsche; Kleidung",
      "isVocabulary": true,
      "example": "Preciso lavar a roupa.",
      "exampleTranslation": "Ich muss die Wäsche waschen.",
      "explanation": "A roupa; lavar a roupa = die Wäsche waschen."
    },
    {
      "id": "karte-03",
      "topic": "Im Haushalt",
      "expression": "cama",
      "translation": "Bett",
      "isVocabulary": true,
      "example": "Vou arrumar a cama.",
      "exampleTranslation": "Ich werde das Bett machen.",
      "explanation": "A cama; arrumar a cama = das Bett machen."
    },
    {
      "id": "karte-04",
      "topic": "Im Haushalt",
      "expression": "fechar",
      "translation": "schließen",
      "isVocabulary": true,
      "example": "Pode fechar a janela?",
      "exampleTranslation": "Kannst du das Fenster schließen?",
      "explanation": "Fechar ist das Gegenteil von abrir."
    },
    {
      "id": "karte-05",
      "topic": "Im Haushalt",
      "expression": "abrir",
      "translation": "öffnen",
      "isVocabulary": true,
      "example": "Pode abrir a porta?",
      "exampleTranslation": "Kannst du die Tür öffnen?",
      "explanation": "Abrir ist das Gegenteil von fechar."
    },
    {
      "id": "karte-06",
      "topic": "Im Haushalt",
      "expression": "luz",
      "translation": "Licht",
      "isVocabulary": true,
      "example": "A luz está acesa.",
      "exampleTranslation": "Das Licht ist an.",
      "explanation": "A luz; acesa bedeutet eingeschaltet."
    },
    {
      "id": "karte-07",
      "topic": "Im Haushalt",
      "expression": "apagar",
      "translation": "ausschalten",
      "isVocabulary": true,
      "example": "Apague a luz, por favor.",
      "exampleTranslation": "Mach bitte das Licht aus.",
      "explanation": "Bei Licht: apagar a luz = das Licht ausschalten."
    },
    {
      "id": "karte-08",
      "topic": "Im Haushalt",
      "expression": "lixo",
      "translation": "Müll",
      "isVocabulary": true,
      "example": "O lixo fica lá fora.",
      "exampleTranslation": "Der Müll ist draußen.",
      "explanation": "O lixo; lá fora = draußen."
    }
  ]
