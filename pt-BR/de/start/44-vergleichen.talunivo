      "expression": "mais barato",
      "translation": "günstiger",
      "isVocabulary": true,
      "example": "Este hotel é mais barato, mas fica mais longe.",
      "exampleTranslation": "Dieses Hotel ist billiger, aber es liegt weiter weg.",
      "explanation": "Barato ist günstig; mais barato bildet den Vergleich."
    },
