    {
      "id": "karte-01",
      "topic": "Einfach vergleichen",
      "expression": "mais barato",
      "translation": "günstiger",
      "isVocabulary": true,
      "example": "Este hotel é mais barato.",
      "exampleTranslation": "Dieses Hotel ist günstiger.",
      "explanation": "Barato heißt günstig oder billig. Mais barato bildet den Vergleich günstiger; barato passt zur männlichen Form hotel. Welches andere Hotel oder Angebot verglichen wird, ergibt sich aus dem Gespräch."
    },
    {
      "id": "karte-02",
      "topic": "Einfach vergleichen",
      "expression": "mais caro",
      "translation": "teurer",
      "isVocabulary": true,
      "example": "Aquele hotel é mais caro.",
      "exampleTranslation": "Das Hotel dort ist teurer.",
      "explanation": "Caro heißt teuer; mais caro heißt teurer. Aquele hotel bezeichnet das Hotel dort und gibt dem Adjektiv einen klaren Bezug. Caro passt zum männlichen Nomen hotel; der Vergleichswert ist im Gespräch vorausgesetzt."
    },
    {
      "id": "karte-03",
      "topic": "Einfach vergleichen",
      "expression": "maior",
      "translation": "größer",
      "isVocabulary": true,
      "example": "Esta mala é maior que a minha.",
      "exampleTranslation": "Dieser Koffer ist größer als meiner.",
      "explanation": "Maior ist die unregelmäßige Steigerung von grande, groß; davor steht hier kein mais. Que bedeutet im Vergleich als. A minha bezieht sich auf die weibliche mala und meint meinen Koffer; maior selbst bleibt für beide Genera gleich."
    },
    {
      "id": "karte-04",
      "topic": "Einfach vergleichen",
      "expression": "menor",
      "translation": "kleiner",
      "isVocabulary": true,
      "example": "Este quarto é menor.",
      "exampleTranslation": "Dieses Zimmer ist kleiner.",
      "explanation": "Menor ist die unregelmäßige Steigerung von pequeno, klein; davor steht hier kein mais. Este quarto heißt dieses Zimmer. Menor hat für männliche und weibliche Nomen dieselbe Form; das Vergleichszimmer ergibt sich aus dem Gespräch."
    },
    {
      "id": "karte-05",
      "topic": "Einfach vergleichen",
      "expression": "mais longe",
      "translation": "weiter weg",
      "isVocabulary": true,
      "example": "A estação fica mais longe que o mercado.",
      "exampleTranslation": "Der Bahnhof ist weiter weg als der Markt.",
      "explanation": "Mais longe heißt weiter weg. Fica beschreibt hier die Lage; que verbindet den Vergleich mit dem Markt. Beide Entfernungen werden von demselben, im Gespräch gegebenen Ausgangspunkt betrachtet. Estação meint hier den Bahnhof."
    },
    {
      "id": "karte-06",
      "topic": "Einfach vergleichen",
      "expression": "menos",
      "translation": "weniger",
      "isVocabulary": true,
      "example": "Quero menos açúcar.",
      "exampleTranslation": "Ich möchte weniger Zucker.",
      "explanation": "Menos bedeutet weniger und bleibt vor Nomen unverändert. Quero menos açúcar wünscht eine geringere Zuckermenge als zuvor oder als angeboten. Der Satz nennt keine genaue Menge."
    },
    {
      "id": "karte-07",
      "topic": "Einfach vergleichen",
      "expression": "mais",
      "translation": "mehr",
      "isVocabulary": true,
      "example": "Preciso de mais tempo.",
      "exampleTranslation": "Ich brauche mehr Zeit.",
      "explanation": "Mais bedeutet hier mehr und bleibt unverändert. Preciso de steht vor der Nomengruppe mais tempo; tempo bedeutet in diesem Satz Zeit. Mais ist von mas zu unterscheiden, das aber bedeutet."
    },
    {
      "id": "karte-08",
      "topic": "Einfach vergleichen",
      "expression": "melhor",
      "translation": "besser",
      "isVocabulary": true,
      "example": "Este caminho é melhor.",
      "exampleTranslation": "Dieser Weg ist besser.",
      "explanation": "Melhor ist hier die unregelmäßige Steigerung von bom, gut; davor steht kein mais. Este caminho bedeutet dieser Weg. Nach welchem Kriterium er besser ist, etwa Länge oder Bequemlichkeit, bleibt im Satz offen."
    }
  ]
