  "title": "24 \u00B7 Orte in der Stadt",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Orte in der Stadt",
      "expression": "farm\u00E1cia",
      "translation": "Apotheke",
      "example": "Onde fica a farm\u00E1cia?",
      "exampleTranslation": "Wo ist die Apotheke?",
      "explanation": "A farm\u00E1cia, Plural farm\u00E1cias. Onde fica \u2026? fragt nach einem Ort. Der Akut in farm\u00E1cia geh\u00F6rt zur Schreibweise. Die Frage nennt noch keine \u00D6ffnungszeit und keine bestimmte Apotheke.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Orte in der Stadt",
      "expression": "banco",
      "translation": "Bank",
      "example": "O banco est\u00E1 aberto.",
      "exampleTranslation": "Die Bank ist ge\u00F6ffnet.",
      "explanation": "O banco bezeichnet in dieser \u00D6ffnungsaussage ein Geldinstitut. Est\u00E1 aberto hei\u00DFt ist ge\u00F6ffnet. Banco kann in anderen Situationen auch Sitzbank hei\u00DFen; der Zusammenhang entscheidet.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Orte in der Stadt",
      "expression": "padaria",
      "translation": "B\u00E4ckerei",
      "example": "A padaria fica na esquina.",
      "exampleTranslation": "Die B\u00E4ckerei ist an der Ecke.",
      "explanation": "A padaria, Plural padarias, ist eine B\u00E4ckerei. Na esquina bedeutet an der Ecke; na ist em \u002B a. Fica beschreibt hier die Lage des Gesch\u00E4fts.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Orte in der Stadt",
      "expression": "pra\u00E7a",
      "translation": "Platz",
      "example": "O mercado fica em frente \u00E0 pra\u00E7a.",
      "exampleTranslation": "Der Markt liegt gegen\u00FCber dem Platz.",
      "explanation": "A pra\u00E7a, Plural pra\u00E7as, ist hier ein \u00F6ffentlicher Platz. Em frente \u00E0 pra\u00E7a beschreibt eine Lage gegen\u00FCber dem Platz oder vor dem Platz, je nach Situation. Mercado bedeutet Markt; \u00E0 verbindet hier a \u002B a.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Orte in der Stadt",
      "expression": "esta\u00E7\u00E3o",
      "translation": "Bahnhof; Station",
      "example": "A esta\u00E7\u00E3o est\u00E1 perto.",
      "exampleTranslation": "Der Bahnhof ist in der N\u00E4he.",
      "explanation": "A esta\u00E7\u00E3o, Plural esta\u00E7\u00F5es. Im hier gemeinten Verkehrskontext ist ein Bahnhof oder eine Station gemeint. Est\u00E1 perto bedeutet ist in der N\u00E4he. Das Wort hat au\u00DFerhalb dieses Kontexts weitere Bedeutungen, etwa Jahreszeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Orte in der Stadt",
      "expression": "museu",
      "translation": "Museum",
      "example": "O museu est\u00E1 fechado hoje.",
      "exampleTranslation": "Das Museum ist heute geschlossen.",
      "explanation": "O museu, Plural museus. Fechado bedeutet geschlossen; hoje hei\u00DFt heute. Der Satz beschreibt einen erfundenen \u00D6ffnungszustand im Beispiel, keine tats\u00E4chliche \u00D6ffnungszeit eines Museums.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Orte in der Stadt",
      "expression": "praia",
      "translation": "Strand",
      "example": "A praia fica longe?",
      "exampleTranslation": "Ist der Strand weit weg?",
      "explanation": "A praia, Plural praias, ist ein Strand. Longe bedeutet weit weg; perto bedeutet in der N\u00E4he. Die Frage betrifft die Entfernung, nennt aber noch keine Strecke oder Reisezeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Orte in der Stadt",
      "expression": "parque",
      "translation": "Park",
      "example": "O parque fica perto.",
      "exampleTranslation": "Der Park ist in der N\u00E4he.",
      "explanation": "O parque, Plural parques. Fica perto bedeutet hier liegt in der N\u00E4he. Das bekannte Lagemuster verwendet nur den neuen Ortsnamen; eine bestimmte Richtung wird damit nicht genannt.",
      "isVocabulary": true
    }
  ],
