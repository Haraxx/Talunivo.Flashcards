  "packageId": "start-ptbr-14-gegenstaende",
  "packageVersion": 6,
  "title": "14 \u00B7 Dinge im Alltag",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Dinge im Alltag",
      "expression": "isto",
      "translation": "das hier",
      "example": "Isto \u00E9 uma caneta.",
      "exampleTranslation": "Das hier ist ein Stift.",
      "explanation": "Isto bedeutet das hier und steht selbstst\u00E4ndig: Isto \u00E9 uma caneta. Vor einem Nomen verwendet man ein anderes Muster, zum Beispiel este livro = dieses Buch oder esta bolsa = diese Tasche. Es hei\u00DFt nicht isto livro.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Dinge im Alltag",
      "expression": "livro",
      "translation": "Buch",
      "example": "Isto \u00E9 um livro.",
      "exampleTranslation": "Das hier ist ein Buch.",
      "explanation": "O livro, Plural livros. Isto \u00E9 um livro hei\u00DFt das hier ist ein Buch. Um passt zum m\u00E4nnlichen Wort livro; f\u00FCr mehrere B\u00FCcher lautet die Wortgruppe livros.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Dinge im Alltag",
      "expression": "caneta",
      "translation": "Stift",
      "example": "Preciso de uma caneta.",
      "exampleTranslation": "Ich brauche einen Stift.",
      "explanation": "A caneta, Plural canetas, bezeichnet einen Schreibstift, etwa einen Kugelschreiber. Ein Bleistift hei\u00DFt l\u00E1pis. Preciso de \u2026 hei\u00DFt ich brauche \u2026; die Pr\u00E4position de geh\u00F6rt hier vor das Nomen.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Dinge im Alltag",
      "expression": "celular",
      "translation": "Handy",
      "example": "Meu celular est\u00E1 na mesa.",
      "exampleTranslation": "Mein Handy liegt auf dem Tisch.",
      "explanation": "O celular, Plural celulares, ist die in Brasilien \u00FCbliche Bezeichnung f\u00FCr Handy. Na mesa bedeutet hier auf dem Tisch; na ist em \u002B a. Est\u00E1 beschreibt hier den Ort, nicht ausdr\u00FCcklich eine Liegeposition.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Dinge im Alltag",
      "expression": "chaves",
      "translation": "Schl\u00FCssel",
      "example": "Onde est\u00E3o minhas chaves?",
      "exampleTranslation": "Wo sind meine Schl\u00FCssel?",
      "explanation": "A chave ist ein Schl\u00FCssel; chaves ist die Mehrzahl. Onde est\u00E3o \u2026? bedeutet wo sind \u2026? Minhas steht passend zur weiblichen Mehrzahl chaves. Die Frage bezieht sich hier auf mehrere Schl\u00FCssel.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Dinge im Alltag",
      "expression": "bolsa",
      "translation": "Tasche",
      "example": "Esta bolsa \u00E9 sua?",
      "exampleTranslation": "Geh\u00F6rt diese Tasche dir?",
      "explanation": "A bolsa, Plural bolsas. Esta bolsa \u00E9 sua? hei\u00DFt geh\u00F6rt diese Tasche dir? Sua ist hier weiblich wegen bolsa, nicht wegen der angesprochenen Person. Andere Bez\u00FCge von sua m\u00FCssen aus dem Gespr\u00E4ch hervorgehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Dinge im Alltag",
      "expression": "copo",
      "translation": "Glas",
      "example": "O copo est\u00E1 vazio.",
      "exampleTranslation": "Das Glas ist leer.",
      "explanation": "O copo, Plural copos, ist hier ein Trinkglas. Das Material Glas hei\u00DFt vidro. Est\u00E1 vazio bedeutet ist leer; vazio steht hier in der m\u00E4nnlichen Form passend zu copo.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Dinge im Alltag",
      "expression": "cadeira",
      "translation": "Stuhl",
      "example": "A cadeira est\u00E1 ocupada.",
      "exampleTranslation": "Der Stuhl ist besetzt.",
      "explanation": "A cadeira, Plural cadeiras. Est\u00E1 ocupada bedeutet ist besetzt. Ocupada ist weiblich wegen des portugiesischen Wortes cadeira, obwohl Stuhl im Deutschen m\u00E4nnlich ist.",
      "isVocabulary": true
    }
  ],
