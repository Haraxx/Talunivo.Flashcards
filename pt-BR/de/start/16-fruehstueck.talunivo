  "cards": [
    {
      "id": "karte-01",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "p\u00E3o",
      "translation": "Brot",
      "example": "Como p\u00E3o.",
      "exampleTranslation": "Ich esse Brot.",
      "explanation": "O p\u00E3o bedeutet Brot; die Mehrzahl lautet p\u00E3es. Como hei\u00DFt hier ich esse. Bei einer Bestellung kann um p\u00E3o je nach Angebot auch ein Br\u00F6tchen meinen; der Zusammenhang entscheidet.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "queijo",
      "translation": "K\u00E4se",
      "example": "Tem queijo?",
      "exampleTranslation": "Gibt es K\u00E4se?",
      "explanation": "O queijo ist K\u00E4se. Tem queijo? fragt im brasilianischen Alltag, ob K\u00E4se da ist. Com queijo bedeutet mit K\u00E4se und l\u00E4sst sich mit einem Lebensmittel verbinden, etwa p\u00E3o com queijo.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "banana",
      "translation": "Banane",
      "example": "Eu como uma banana.",
      "exampleTranslation": "Ich esse eine Banane.",
      "explanation": "A banana, Plural bananas. Eu como hei\u00DFt ich esse; uma passt zum weiblichen Wort banana. Uma banana bezeichnet hier eine einzelne Banane.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "ovos",
      "translation": "Eier",
      "example": "Gosto de ovos.",
      "exampleTranslation": "Ich mag Eier.",
      "explanation": "O ovo ist ein Ei; ovos ist die Mehrzahl Eier. Gosto de \u2026 hei\u00DFt ich mag \u2026 Die Pr\u00E4position de geh\u00F6rt zu diesem Muster. Der Beispielsatz dr\u00FCckt eine m\u00F6gliche Vorliebe aus.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "leite",
      "translation": "Milch",
      "example": "Bebo leite de manh\u00E3.",
      "exampleTranslation": "Ich trinke morgens Milch.",
      "explanation": "O leite ist im Portugiesischen m\u00E4nnlich, obwohl Milch im Deutschen weiblich ist. Bebo hei\u00DFt ich trinke; de manh\u00E3 bedeutet morgens. Die Mengenangabe w\u00E4re zum Beispiel um litro de leite.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "caf\u00E9 da manh\u00E3",
      "translation": "Fr\u00FChst\u00FCck",
      "example": "O caf\u00E9 da manh\u00E3 est\u00E1 pronto.",
      "exampleTranslation": "Das Fr\u00FChst\u00FCck ist fertig.",
      "explanation": "O caf\u00E9 da manh\u00E3 ist in Brasilien das Fr\u00FChst\u00FCck als Mahlzeit. Die Wendung ist nicht gleichbedeutend mit einer Tasse Kaffee. Est\u00E1 pronto hei\u00DFt hier ist fertig.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "a\u00E7\u00FAcar",
      "translation": "Zucker",
      "example": "N\u00E3o quero a\u00E7\u00FAcar.",
      "exampleTranslation": "Ich m\u00F6chte keinen Zucker.",
      "explanation": "O a\u00E7\u00FAcar ist grammatisch m\u00E4nnlich. N\u00E3o quero \u2026 hei\u00DFt ich m\u00F6chte kein \u2026 oder keine \u2026 Sem a\u00E7\u00FAcar bedeutet ohne Zucker und ist eine kurze Erg\u00E4nzung bei einer Bestellung.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Fr\u00FChst\u00FCck",
      "expression": "fruta",
      "translation": "Frucht",
      "example": "Quero comer uma fruta.",
      "exampleTranslation": "Ich m\u00F6chte ein St\u00FCck Obst essen.",
      "explanation": "A fruta, Plural frutas. Uma fruta ist eine einzelne Frucht; im Deutschen passt hier nat\u00FCrlich ein St\u00FCck Obst. Quero comer hei\u00DFt ich m\u00F6chte essen. Die \u00DCbersetzungen Frucht und St\u00FCck Obst k\u00F6nnen beide passen.",
      "isVocabulary": true
    }
  ],
