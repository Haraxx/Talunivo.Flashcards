  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bananas",
      "translation": "Bananen",
      "isVocabulary": true,
      "example": "Bom dia! Quero meio quilo de bananas, por favor.",
      "exampleTranslation": "Guten Morgen! Ich möchte bitte ein halbes Kilo Bananen.",
      "explanation": "Plural von a banana."
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "maduras",
      "translation": "reif (weiblich, Mehrzahl)",
      "isVocabulary": true,
      "example": "Sim, estas estão bem maduras.",
      "exampleTranslation": "Ja, diese hier sind schön reif.",
      "explanation": "Weiblicher Plural von maduro; passend zu bananas."
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "quilo",
      "translation": "Kilo",
      "isVocabulary": true,
      "example": "Quanto custa o quilo?",
      "exampleTranslation": "Wie viel kostet das Kilo?",
      "explanation": "O quilo; meio quilo = ein halbes Kilo."
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "oito",
      "translation": "acht",
      "isVocabulary": true,
      "example": "O quilo custa oito reais.",
      "exampleTranslation": "Das Kilo kostet acht Reais.",
      "explanation": "Oito steht für 8; bei Preisen gefolgt von reais."
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "meio",
      "translation": "halb",
      "isVocabulary": true,
      "example": "Então quero meio quilo.",
      "exampleTranslation": "Dann möchte ich ein halbes Kilo.",
      "explanation": "Männliche Form; weiblich meia. Hier passend zu quilo."
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "alguma coisa",
      "translation": "etwas",
      "isVocabulary": true,
      "example": "Quer mais alguma coisa?",
      "exampleTranslation": "Möchten Sie sonst noch etwas?",
      "explanation": "Mais alguma coisa? = Sonst noch etwas?"
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "só",
      "translation": "nur",
      "isVocabulary": true,
      "example": "Só isso, obrigado.",
      "exampleTranslation": "Das ist alles, danke.",
      "explanation": "Só isso = nur das beziehungsweise das ist alles."
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bom dia",
      "translation": "guten Morgen",
      "isVocabulary": true,
      "example": "Bom dia! Quanto custa o quilo de bananas?",
      "exampleTranslation": "Guten Morgen! Wie viel kostet ein Kilo Bananen?",
      "explanation": "Bom dia! als Gruß: guten Morgen; um bom dia in einem Wunsch: einen schönen Tag."
    }
  ]
}
