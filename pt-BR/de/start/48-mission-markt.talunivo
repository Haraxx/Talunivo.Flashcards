  "title": "48 · Mini-Dialog: Auf dem Markt",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bananas",
      "translation": "Bananen",
      "example": "Quero meio quilo de bananas, por favor.",
      "exampleTranslation": "Ich möchte bitte ein halbes Kilo Bananen.",
      "explanation": "A banana heißt Banane, as bananas die Bananen. Meio quilo de bananas bezeichnet ein halbes Kilo Bananen. Quero …, por favor ist hier die höfliche Bestellung; die Begrüßung steht auf einer eigenen Karte.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "maduras",
      "translation": "reif (weiblich, Mehrzahl)",
      "example": "Estas bananas estão maduras.",
      "exampleTranslation": "Diese Bananen sind reif.",
      "explanation": "Maduras ist der weibliche Plural von maduro, reif, und passt zu bananas. Auch estas steht im weiblichen Plural; estão ist die Mehrzahlform von está. Die Aussage beschreibt die angebotenen Früchte in der erfundenen Situation.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "quilo",
      "translation": "Kilo",
      "example": "Quanto custa o quilo de bananas?",
      "exampleTranslation": "Wie viel kostet ein Kilo Bananen?",
      "explanation": "O quilo, Plural quilos, bedeutet Kilo. Quanto custa o quilo de …? fragt nach dem Preis für ein Kilo der genannten Ware. Der Gesamtpreis einer anderen Menge ist damit noch nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "oito",
      "translation": "acht",
      "example": "O quilo custa oito reais.",
      "exampleTranslation": "Das Kilo kostet acht Reais.",
      "explanation": "Oito ist die Zahl acht und bleibt unverändert. Reais ist der Plural von real. Die Antwort bezieht sich auf ein ganzes Kilo; sie nennt nicht den Gesamtpreis eines halben Kilos. Der Preis ist nur ein Lehrbeispiel.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "OI-tu",
        "ipa": "[ˈojtu]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "meio",
      "translation": "halb",
      "example": "Meio quilo, por favor.",
      "exampleTranslation": "Ein halbes Kilo, bitte.",
      "explanation": "Meio bedeutet hier halb und passt zur männlichen Form quilo. Bei einer weiblichen Mengenbezeichnung steht meia, etwa meia hora, eine halbe Stunde. Die kurze Bestellung setzt voraus, dass die Ware im Gespräch bereits feststeht.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "alguma coisa",
      "translation": "etwas",
      "example": "Quer mais alguma coisa?",
      "exampleTranslation": "Möchten Sie sonst noch etwas?",
      "explanation": "Alguma coisa bedeutet etwas. Mais alguma coisa? fragt in diesem Verkaufsgespräch nach einem zusätzlichen Wunsch. Quer bezieht sich hier auf die Kundschaft; die Frage legt keine bestimmte weitere Ware fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "só",
      "translation": "nur",
      "example": "Só isso, obrigado.",
      "exampleTranslation": "Das ist alles, danke.",
      "explanation": "Só bedeutet hier nur; só isso heißt nur das oder das ist alles. Obrigado ist die männliche Form des Dankes, obrigada die weibliche. Die Variante richtet sich in der gelehrten Standardform nach der dankenden Person.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bom dia",
      "translation": "guten Morgen",
      "example": "Bom dia! Tem bananas?",
      "exampleTranslation": "Guten Morgen! Gibt es Bananen?",
      "explanation": "Bom dia! ist hier die morgendliche Begrüßung. Tem bananas? fragt im brasilianischen Alltagsgebrauch, ob Bananen vorhanden sind. Der Gruß eröffnet die Marktsituation; einen schönen Tag wünschen kann man etwa mit Tenha um bom dia! ausdrücken.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "BÕ DSCHI-a",
        "ipa": "[bõ ˈdʒiɐ]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    }
  ],
