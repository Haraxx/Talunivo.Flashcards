  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bananas",
      "translation": "Bananen",
      "example": "Quero meio quilo de bananas, por favor.",
      "exampleTranslation": "Ich m\u00F6chte bitte ein halbes Kilo Bananen.",
      "explanation": "A banana hei\u00DFt Banane, as bananas die Bananen. Meio quilo de bananas bezeichnet ein halbes Kilo Bananen. Quero \u2026, por favor ist hier die h\u00F6fliche Bestellung; die Begr\u00FC\u00DFung steht auf einer eigenen Karte.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "maduras",
      "translation": "reif (weiblich, Mehrzahl)",
      "example": "Estas bananas est\u00E3o maduras.",
      "exampleTranslation": "Diese Bananen sind reif.",
      "explanation": "Maduras ist der weibliche Plural von maduro, reif, und passt zu bananas. Auch estas steht im weiblichen Plural; est\u00E3o ist die Mehrzahlform von est\u00E1. Die Aussage beschreibt die angebotenen Fr\u00FCchte in der erfundenen Situation.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "quilo",
      "translation": "Kilo",
      "example": "Quanto custa o quilo de bananas?",
      "exampleTranslation": "Wie viel kostet ein Kilo Bananen?",
      "explanation": "O quilo, Plural quilos, bedeutet Kilo. Quanto custa o quilo de \u2026? fragt nach dem Preis f\u00FCr ein Kilo der genannten Ware. Der Gesamtpreis einer anderen Menge ist damit noch nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "oito",
      "translation": "acht",
      "example": "O quilo custa oito reais.",
      "exampleTranslation": "Das Kilo kostet acht Reais.",
      "explanation": "Oito ist die Zahl acht und bleibt unver\u00E4ndert. Reais ist der Plural von real. Die Antwort bezieht sich auf ein ganzes Kilo; sie nennt nicht den Gesamtpreis eines halben Kilos. Der Preis ist nur ein Lehrbeispiel.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "meio",
      "translation": "halb",
      "example": "Meio quilo, por favor.",
      "exampleTranslation": "Ein halbes Kilo, bitte.",
      "explanation": "Meio bedeutet hier halb und passt zur m\u00E4nnlichen Form quilo. Bei einer weiblichen Mengenbezeichnung steht meia, etwa meia hora, eine halbe Stunde. Die kurze Bestellung setzt voraus, dass die Ware im Gespr\u00E4ch bereits feststeht.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "alguma coisa",
      "translation": "etwas",
      "example": "Quer mais alguma coisa?",
      "exampleTranslation": "M\u00F6chten Sie sonst noch etwas?",
      "explanation": "Alguma coisa bedeutet etwas. Mais alguma coisa? fragt in diesem Verkaufsgespr\u00E4ch nach einem zus\u00E4tzlichen Wunsch. Quer bezieht sich hier auf die Kundschaft; die Frage legt keine bestimmte weitere Ware fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "s\u00F3",
      "translation": "nur",
      "example": "S\u00F3 isso, obrigado.",
      "exampleTranslation": "Das ist alles, danke.",
      "explanation": "S\u00F3 bedeutet hier nur; s\u00F3 isso hei\u00DFt nur das oder das ist alles. Obrigado ist die m\u00E4nnliche Form des Dankes, obrigada die weibliche. Die Variante richtet sich in der gelehrten Standardform nach der dankenden Person.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Auf dem Markt",
      "expression": "bom dia",
      "translation": "guten Morgen",
      "example": "Bom dia! Tem bananas?",
      "exampleTranslation": "Guten Morgen! Gibt es Bananen?",
      "explanation": "Bom dia! ist hier die morgendliche Begr\u00FC\u00DFung. Tem bananas? fragt im brasilianischen Alltagsgebrauch, ob Bananen vorhanden sind. Der Gru\u00DF er\u00F6ffnet die Marktsituation; einen sch\u00F6nen Tag w\u00FCnschen kann man etwa mit Tenha um bom dia! ausdr\u00FCcken.",
      "isVocabulary": true
    }
  ],
