      "topic": "Alter und Beruf",
      "expression": "quantos",
      "translation": "wie viele (männlich)",
      "isVocabulary": true,
      "example": "Quantos anos você tem?",
      "exampleTranslation": "Wie alt bist du?",
      "explanation": "Männlicher Plural zu quanto; weiblich quantas."
    },
    {
      "id": "karte-02",
      "topic": "Alter und Beruf",
      "expression": "anos",
      "translation": "Jahre",
      "isVocabulary": true,
      "example": "Tenho vinte e cinco anos.",
      "exampleTranslation": "Ich bin fünfundzwanzig Jahre alt.",
      "explanation": "O ano, os anos; Alter wird mit ter ausgedrückt: tenho … anos."
    },
    {
      "id": "karte-03",
      "topic": "Alter und Beruf",
      "expression": "estudante",
      "translation": "Student; Studentin",
      "isVocabulary": true,
      "example": "Sou estudante.",
      "exampleTranslation": "Ich bin Student.",
      "explanation": "O estudante oder a estudante; je nach Kontext auch Schüler oder Schülerin."
    },
    {
      "id": "karte-04",
      "topic": "Alter und Beruf",
      "expression": "professora",
      "translation": "Lehrerin",
      "isVocabulary": true,
      "example": "Ela é professora.",
      "exampleTranslation": "Sie ist Lehrerin.",
      "explanation": "A professora; männlich o professor."
    },
    {
      "id": "karte-05",
      "topic": "Alter und Beruf",
      "expression": "médico",
      "translation": "Arzt",
      "isVocabulary": true,
      "example": "Ele é médico.",
      "exampleTranslation": "Er ist Arzt.",
      "explanation": "O médico; weiblich a médica."
    },
    {
      "id": "karte-06",
      "topic": "Alter und Beruf",
      "expression": "escritório",
      "translation": "Büro",
      "isVocabulary": true,
      "example": "Trabalho num escritório.",
      "exampleTranslation": "Ich arbeite in einem Büro.",
      "explanation": "O escritório; num = em um."
    },
    {
      "id": "karte-07",
      "topic": "Alter und Beruf",
      "expression": "trabalhar",
      "translation": "arbeiten",
      "isVocabulary": true,
      "example": "Onde você trabalha?",
      "exampleTranslation": "Wo arbeitest du?",
      "explanation": "Trabalho = ich arbeite; trabalha = du arbeitest bei você."
    },
    {
      "id": "karte-08",
      "topic": "Alter und Beruf",
      "expression": "ainda",
      "translation": "noch",
      "isVocabulary": true,
      "example": "Ainda não trabalho.",
      "exampleTranslation": "Ich arbeite noch nicht.",
      "explanation": "Ainda não bedeutet noch nicht."
    }
