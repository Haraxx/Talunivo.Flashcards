  "title": "12 \u00B7 Alter und Beruf",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Alter und Beruf",
      "expression": "quantos",
      "translation": "wie viele (m\u00E4nnlich)",
      "example": "Quantos anos voc\u00EA tem?",
      "exampleTranslation": "Wie alt bist du?",
      "explanation": "Quantos hei\u00DFt wie viele bei m\u00E4nnlichen Nomen in der Mehrzahl: quantos anos. Anos bedeutet Jahre. Die ganze Frage fragt nach dem Alter; die Form quantos richtet sich nach anos, nicht nach der angesprochenen Person.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Alter und Beruf",
      "expression": "anos",
      "translation": "Jahre",
      "example": "Tenho vinte e cinco anos.",
      "exampleTranslation": "Ich bin f\u00FCnfundzwanzig Jahre alt.",
      "explanation": "O ano, Plural anos. F\u00FCr das Alter verwendet man ter = haben: tenho \u2026 anos, auf Deutsch ich bin \u2026 Jahre alt. Vinte e cinco ist 25. Die Beispielzahl ist frei gew\u00E4hlt und keine Angabe \u00FCber dich.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Alter und Beruf",
      "expression": "estudante",
      "translation": "Student; Studentin",
      "example": "Sou estudante.",
      "exampleTranslation": "Ich bin Student.",
      "explanation": "O estudante oder a estudante; das Wort bleibt gleich. Sou estudante kann ich bin Student oder Studentin bedeuten. Je nach Bildungskontext kann auch Sch\u00FCler oder Sch\u00FClerin gemeint sein; der portugiesische Satz allein legt das nicht fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Alter und Beruf",
      "expression": "professora",
      "translation": "Lehrerin",
      "example": "Ela \u00E9 professora.",
      "exampleTranslation": "Sie ist Lehrerin.",
      "explanation": "A professora, Plural professoras; m\u00E4nnlich o professor. Ela hei\u00DFt sie. Ela \u00E9 professora nennt hier einen Beruf; nach \u00E9 steht in diesem einfachen Berufsmodell kein unbestimmter Artikel.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Alter und Beruf",
      "expression": "m\u00E9dico",
      "translation": "Arzt",
      "example": "Ele \u00E9 m\u00E9dico.",
      "exampleTranslation": "Er ist Arzt.",
      "explanation": "O m\u00E9dico, Plural m\u00E9dicos; weiblich a m\u00E9dica. Ele hei\u00DFt er. Ele \u00E9 m\u00E9dico nennt hier einen Beruf. Der Akut in m\u00E9dico geh\u00F6rt zur Schreibweise; aus dem Satz folgt kein bestimmter Arbeitsort.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Alter und Beruf",
      "expression": "escrit\u00F3rio",
      "translation": "B\u00FCro",
      "example": "Trabalho num escrit\u00F3rio.",
      "exampleTranslation": "Ich arbeite in einem B\u00FCro.",
      "explanation": "O escrit\u00F3rio, Plural escrit\u00F3rios. Num ist em um: in einem. Trabalho bedeutet hier ich arbeite. Der Satz nennt ein B\u00FCro als Arbeitsort, aber keinen bestimmten Beruf.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Alter und Beruf",
      "expression": "trabalhar",
      "translation": "arbeiten",
      "example": "Onde voc\u00EA trabalha?",
      "exampleTranslation": "Wo arbeitest du?",
      "explanation": "Trabalhar bedeutet arbeiten. Trabalho = ich arbeite; bei voc\u00EA hei\u00DFt es trabalha. Onde voc\u00EA trabalha? fragt nach dem Arbeitsort. Eine Antwort ist zum Beispiel Trabalho num escrit\u00F3rio.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Alter und Beruf",
      "expression": "ainda",
      "translation": "noch",
      "example": "Ainda n\u00E3o trabalho.",
      "exampleTranslation": "Ich arbeite noch nicht.",
      "explanation": "Ainda bedeutet hier noch. Zusammen mit n\u00E3o entsteht noch nicht: Ainda n\u00E3o trabalho. Das ist eine Zeitangabe zum Arbeiten; sie sagt nichts \u00FCber den Grund oder die Lebenssituation aus.",
      "isVocabulary": true
    }
  ],
