{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-12-alter-beruf",
  "packageVersion": 4,
  "title": "12 · Alter und Beruf",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Alter und Beruf",
      "expression": "quantos",
      "translation": "wie viele (männlich)",
      "isVocabulary": true,
      "example": "Quantos anos você tem?",
      "exampleTranslation": "Wie alt bist du?",
      "explanation": "Quantos heißt wie viele bei männlichen Nomen in der Mehrzahl: quantos anos. Anos bedeutet Jahre. Die ganze Frage fragt nach dem Alter; die Form quantos richtet sich nach anos, nicht nach der angesprochenen Person."
    },
    {
      "id": "karte-02",
      "topic": "Alter und Beruf",
      "expression": "anos",
      "translation": "Jahre",
      "isVocabulary": true,
      "example": "Tenho vinte e cinco anos.",
      "exampleTranslation": "Ich bin fünfundzwanzig Jahre alt.",
      "explanation": "O ano, Plural anos. Für das Alter verwendet man ter = haben: tenho … anos, auf Deutsch ich bin … Jahre alt. Vinte e cinco ist 25. Die Beispielzahl ist frei gewählt und keine Angabe über dich."
    },
    {
      "id": "karte-03",
      "topic": "Alter und Beruf",
      "expression": "estudante",
      "translation": "Student; Studentin",
      "isVocabulary": true,
      "example": "Sou estudante.",
      "exampleTranslation": "Ich bin Student.",
      "explanation": "O estudante oder a estudante; das Wort bleibt gleich. Sou estudante kann ich bin Student oder Studentin bedeuten. Je nach Bildungskontext kann auch Schüler oder Schülerin gemeint sein; der portugiesische Satz allein legt das nicht fest."
    },
    {
      "id": "karte-04",
      "topic": "Alter und Beruf",
      "expression": "professora",
      "translation": "Lehrerin",
      "isVocabulary": true,
      "example": "Ela é professora.",
      "exampleTranslation": "Sie ist Lehrerin.",
      "explanation": "A professora, Plural professoras; männlich o professor. Ela heißt sie. Ela é professora nennt hier einen Beruf; nach é steht in diesem einfachen Berufsmodell kein unbestimmter Artikel."
    },
    {
      "id": "karte-05",
      "topic": "Alter und Beruf",
      "expression": "médico",
      "translation": "Arzt",
      "isVocabulary": true,
      "example": "Ele é médico.",
      "exampleTranslation": "Er ist Arzt.",
      "explanation": "O médico, Plural médicos; weiblich a médica. Ele heißt er. Ele é médico nennt hier einen Beruf. Der Akut in médico gehört zur Schreibweise; aus dem Satz folgt kein bestimmter Arbeitsort."
    },
    {
      "id": "karte-06",
      "topic": "Alter und Beruf",
      "expression": "escritório",
      "translation": "Büro",
      "isVocabulary": true,
      "example": "Trabalho num escritório.",
      "exampleTranslation": "Ich arbeite in einem Büro.",
      "explanation": "O escritório, Plural escritórios. Num ist em um: in einem. Trabalho bedeutet hier ich arbeite. Der Satz nennt ein Büro als Arbeitsort, aber keinen bestimmten Beruf."
    },
    {
      "id": "karte-07",
      "topic": "Alter und Beruf",
      "expression": "trabalhar",
      "translation": "arbeiten",
      "isVocabulary": true,
      "example": "Onde você trabalha?",
      "exampleTranslation": "Wo arbeitest du?",
      "explanation": "Trabalhar bedeutet arbeiten. Trabalho = ich arbeite; bei você heißt es trabalha. Onde você trabalha? fragt nach dem Arbeitsort. Eine Antwort ist zum Beispiel Trabalho num escritório."
    },
    {
      "id": "karte-08",
      "topic": "Alter und Beruf",
      "expression": "ainda",
      "translation": "noch",
      "isVocabulary": true,
      "example": "Ainda não trabalho.",
      "exampleTranslation": "Ich arbeite noch nicht.",
      "explanation": "Ainda bedeutet hier noch. Zusammen mit não entsteht noch nicht: Ainda não trabalho. Das ist eine Zeitangabe zum Arbeiten; sie sagt nichts über den Grund oder die Lebenssituation aus."
    }
  ]
}
