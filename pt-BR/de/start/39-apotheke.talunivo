  "title": "39 \u00B7 In der Apotheke",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "In der Apotheke",
      "expression": "farmac\u00EAutico",
      "translation": "Apotheker",
      "example": "Quero falar com o farmac\u00EAutico.",
      "exampleTranslation": "Ich m\u00F6chte mit dem Apotheker sprechen.",
      "explanation": "O farmac\u00EAutico hei\u00DFt Apotheker; die weibliche Form lautet a farmac\u00EAutica. Falar com hei\u00DFt mit jemandem sprechen. Quero falar com \u2026 nennt hier den Wunsch nach einer Ansprechperson.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "In der Apotheke",
      "expression": "farm\u00E1cia",
      "translation": "Apotheke",
      "example": "Estou procurando uma farm\u00E1cia aberta.",
      "exampleTranslation": "Ich suche eine ge\u00F6ffnete Apotheke.",
      "explanation": "A farm\u00E1cia, Plural farm\u00E1cias, bedeutet Apotheke. Estou procurando hei\u00DFt ich suche gerade. Aberta ist die weibliche Form von aberto und passt zu farm\u00E1cia; die Suche best\u00E4tigt keine tats\u00E4chlichen \u00D6ffnungszeiten.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "In der Apotheke",
      "expression": "alergia",
      "translation": "Allergie",
      "example": "Tenho alergia a amendoim.",
      "exampleTranslation": "Ich bin gegen Erdn\u00FCsse allergisch.",
      "explanation": "A alergia, Plural alergias, bedeutet Allergie. Tenho alergia a \u2026 hei\u00DFt ich bin gegen \u2026 allergisch. Amendoim bezeichnet hier Erdn\u00FCsse als Lebensmittel; die Aussage ist ein erfundenes Gespr\u00E4chsbeispiel.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "In der Apotheke",
      "expression": "receita m\u00E9dica",
      "translation": "\u00E4rztliches Rezept",
      "example": "Tenho uma receita m\u00E9dica.",
      "exampleTranslation": "Ich habe ein \u00E4rztliches Rezept.",
      "explanation": "A receita m\u00E9dica, Plural receitas m\u00E9dicas, ist das \u00E4rztliche Rezept. M\u00E9dica beschreibt hier das weibliche Nomen receita und bezeichnet nicht eine \u00C4rztin. Receita allein kann in anderem Kontext auch Kochrezept hei\u00DFen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "In der Apotheke",
      "expression": "rem\u00E9dio",
      "translation": "Medikament",
      "example": "Este rem\u00E9dio precisa de receita?",
      "exampleTranslation": "Ist dieses Medikament rezeptpflichtig?",
      "explanation": "O rem\u00E9dio, Plural rem\u00E9dios, hei\u00DFt hier Medikament. Este rem\u00E9dio bedeutet dieses Medikament. Precisa de receita? fragt, ob ein Rezept n\u00F6tig ist; die Karte gibt darauf keine Antwort und nennt kein Pr\u00E4parat.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "In der Apotheke",
      "expression": "usar",
      "translation": "anwenden; benutzen",
      "example": "Pode explicar como usar, por favor?",
      "exampleTranslation": "K\u00F6nnen Sie bitte erkl\u00E4ren, wie man es anwendet?",
      "explanation": "Usar bedeutet anwenden oder benutzen. Pode explicar \u2026? bittet hier um eine Erkl\u00E4rung, como usar hei\u00DFt wie man etwas anwendet. Das Objekt ergibt sich aus dem Gespr\u00E4ch; die Karte enth\u00E4lt selbst keine Anwendungsschritte.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "In der Apotheke",
      "expression": "instru\u00E7\u00F5es",
      "translation": "Anweisungen",
      "example": "Pode escrever as instru\u00E7\u00F5es, por favor?",
      "exampleTranslation": "K\u00F6nnen Sie die Anweisungen bitte aufschreiben?",
      "explanation": "A instru\u00E7\u00E3o hei\u00DFt Anweisung, as instru\u00E7\u00F5es hei\u00DFt die Anweisungen. Pode escrever \u2026? bittet um das Aufschreiben. Die Karte lehrt das Erfragen schriftlicher Angaben, nicht deren medizinischen Inhalt.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "In der Apotheke",
      "expression": "orienta\u00E7\u00E3o",
      "translation": "Auskunft; Anleitung",
      "example": "N\u00E3o entendi a orienta\u00E7\u00E3o.",
      "exampleTranslation": "Ich habe die Auskunft nicht verstanden.",
      "explanation": "A orienta\u00E7\u00E3o, Plural orienta\u00E7\u00F5es, bedeutet hier Auskunft, Erkl\u00E4rung oder Anleitung. N\u00E3o entendi ist die verneinte Ich-Form von entender in der Vergangenheit: ich habe nicht verstanden. Der Satz macht Kl\u00E4rungsbedarf deutlich.",
      "isVocabulary": true
    }
  ],
