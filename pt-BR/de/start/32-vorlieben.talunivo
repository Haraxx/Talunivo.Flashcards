  "cards": [
    {
      "id": "karte-01",
      "topic": "Was ich mag",
      "expression": "música",
      "translation": "Musik",
      "example": "Gosto de música brasileira.",
      "exampleTranslation": "Ich mag brasilianische Musik.",
      "explanation": "A música bedeutet Musik; Plural músicas kann einzelne Musikstücke bezeichnen. Gosto de heißt ich mag. Brasileira passt grammatisch zu música und bedeutet brasilianisch; das Beispiel nennt nur eine Vorliebe.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Was ich mag",
      "expression": "ler",
      "translation": "lesen",
      "example": "Gosto muito de ler.",
      "exampleTranslation": "Ich lese sehr gern.",
      "explanation": "Ler heißt lesen. Gosto de + Infinitiv drückt aus, was ich gern tue; muito verstärkt hier zu sehr gern. Die Ich-Form von ler lautet leio und wird in Paket 33 im Alltagssatz verwendet.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "LER",
        "ipa": "[leɾ]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-03",
      "topic": "Was ich mag",
      "expression": "cedo",
      "translation": "früh",
      "example": "Não gosto de acordar cedo.",
      "exampleTranslation": "Ich wache nicht gern früh auf.",
      "explanation": "Cedo bedeutet früh; das Gegenteil ist tarde im Sinn von spät. Não gosto de verneint die Vorliebe. Acordar heißt aufwachen und ist nicht dasselbe wie levantar, aufstehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Was ich mag",
      "expression": "preferir",
      "translation": "bevorzugen",
      "example": "Prefiro chá a café.",
      "exampleTranslation": "Ich mag Tee lieber als Kaffee.",
      "explanation": "Preferir heißt bevorzugen; prefiro ist die unregelmäßige Ich-Form. Im Muster prefiro X a Y wird X bevorzugt: hier Tee gegenüber Kaffee. Das a verbindet die beiden Vergleichsgrößen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Was ich mag",
      "expression": "comida",
      "translation": "Essen",
      "example": "Qual é a sua comida favorita?",
      "exampleTranslation": "Was ist dein Lieblingsessen?",
      "explanation": "A comida bedeutet Essen oder Speise. Comida favorita heißt Lieblingsessen; favorita passt zur weiblichen Form comida. Qual é a sua …? fragt hier nach einer persönlichen Vorliebe.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Was ich mag",
      "expression": "futebol",
      "translation": "Fußball",
      "example": "Meu esporte favorito é futebol.",
      "exampleTranslation": "Mein Lieblingssport ist Fußball.",
      "explanation": "O futebol bedeutet Fußball. Meu esporte favorito heißt mein Lieblingssport; favorito passt zum männlichen Nomen esporte. Die Aussage ist ein erfundenes Beispiel und lässt sich mit anderen Sportarten variieren.",
      "isVocabulary": true,
      "pronunciation": {
        "germanHint": "fu-tschi-BOU",
        "ipa": "[futʃiˈbɔw]",
        "hintLanguage": "de-DE",
        "variant": "pt-BR",
        "note": "Wortweise Lernfassung; flüssige Rede verbindet Laute. Tilde = nasal, ss = stimmloses s, zh = stimmhaftes sch wie in Journal. EU = e→u in einer Silbe, kein deutsches eu. R kurz anschlagen; r und tschi/dschi variieren regional."
      }
    },
    {
      "id": "karte-07",
      "topic": "Was ich mag",
      "expression": "cozinhar",
      "translation": "kochen",
      "example": "Também gosto de cozinhar.",
      "exampleTranslation": "Ich koche auch gern.",
      "explanation": "Cozinhar heißt kochen, also Essen zubereiten. Também bedeutet auch. Nach gosto de steht der Infinitiv cozinhar; zusammen heißt das ich koche gern. Für das Kochen von Wasser verwendet man andere Formulierungen wie ferver água.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Was ich mag",
      "expression": "dançar",
      "translation": "tanzen",
      "example": "Você gosta de dançar?",
      "exampleTranslation": "Tanzt du gern?",
      "explanation": "Dançar heißt tanzen. Você gosta de + Infinitiv fragt, ob die angesprochene Person etwas gern tut. Gosta gehört hier zu você, während gosto zur Ich-Form gehört.",
      "isVocabulary": true
    }
  ],
