  "title": "32 \u00B7 Was ich mag",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Was ich mag",
      "expression": "m\u00FAsica",
      "translation": "Musik",
      "example": "Gosto de m\u00FAsica brasileira.",
      "exampleTranslation": "Ich mag brasilianische Musik.",
      "explanation": "A m\u00FAsica bedeutet Musik; Plural m\u00FAsicas kann einzelne Musikst\u00FCcke bezeichnen. Gosto de hei\u00DFt ich mag. Brasileira passt grammatisch zu m\u00FAsica und bedeutet brasilianisch; das Beispiel nennt nur eine Vorliebe.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Was ich mag",
      "expression": "ler",
      "translation": "lesen",
      "example": "Gosto muito de ler.",
      "exampleTranslation": "Ich lese sehr gern.",
      "explanation": "Ler hei\u00DFt lesen. Gosto de \u002B Infinitiv dr\u00FCckt aus, was ich gern tue; muito verst\u00E4rkt hier zu sehr gern. Die Ich-Form von ler lautet leio und wird in Paket 33 im Alltagssatz verwendet.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Was ich mag",
      "expression": "cedo",
      "translation": "fr\u00FCh",
      "example": "N\u00E3o gosto de acordar cedo.",
      "exampleTranslation": "Ich wache nicht gern fr\u00FCh auf.",
      "explanation": "Cedo bedeutet fr\u00FCh; das Gegenteil ist tarde im Sinn von sp\u00E4t. N\u00E3o gosto de verneint die Vorliebe. Acordar hei\u00DFt aufwachen und ist nicht dasselbe wie levantar, aufstehen.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Was ich mag",
      "expression": "preferir",
      "translation": "bevorzugen",
      "example": "Prefiro ch\u00E1 a caf\u00E9.",
      "exampleTranslation": "Ich mag Tee lieber als Kaffee.",
      "explanation": "Preferir hei\u00DFt bevorzugen; prefiro ist die unregelm\u00E4\u00DFige Ich-Form. Im Muster prefiro X a Y wird X bevorzugt: hier Tee gegen\u00FCber Kaffee. Das a verbindet die beiden Vergleichsgr\u00F6\u00DFen.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Was ich mag",
      "expression": "comida",
      "translation": "Essen",
      "example": "Qual \u00E9 a sua comida favorita?",
      "exampleTranslation": "Was ist dein Lieblingsessen?",
      "explanation": "A comida bedeutet Essen oder Speise. Comida favorita hei\u00DFt Lieblingsessen; favorita passt zur weiblichen Form comida. Qual \u00E9 a sua \u2026? fragt hier nach einer pers\u00F6nlichen Vorliebe.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Was ich mag",
      "expression": "futebol",
      "translation": "Fu\u00DFball",
      "example": "Meu esporte favorito \u00E9 futebol.",
      "exampleTranslation": "Mein Lieblingssport ist Fu\u00DFball.",
      "explanation": "O futebol bedeutet Fu\u00DFball. Meu esporte favorito hei\u00DFt mein Lieblingssport; favorito passt zum m\u00E4nnlichen Nomen esporte. Die Aussage ist ein erfundenes Beispiel und l\u00E4sst sich mit anderen Sportarten variieren.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Was ich mag",
      "expression": "cozinhar",
      "translation": "kochen",
      "example": "Tamb\u00E9m gosto de cozinhar.",
      "exampleTranslation": "Ich koche auch gern.",
      "explanation": "Cozinhar hei\u00DFt kochen, also Essen zubereiten. Tamb\u00E9m bedeutet auch. Nach gosto de steht der Infinitiv cozinhar; zusammen hei\u00DFt das ich koche gern. F\u00FCr das Kochen von Wasser verwendet man andere Formulierungen wie ferver \u00E1gua.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Was ich mag",
      "expression": "dan\u00E7ar",
      "translation": "tanzen",
      "example": "Voc\u00EA gosta de dan\u00E7ar?",
      "exampleTranslation": "Tanzt du gern?",
      "explanation": "Dan\u00E7ar hei\u00DFt tanzen. Voc\u00EA gosta de \u002B Infinitiv fragt, ob die angesprochene Person etwas gern tut. Gosta geh\u00F6rt hier zu voc\u00EA, w\u00E4hrend gosto zur Ich-Form geh\u00F6rt.",
      "isVocabulary": true
    }
  ],
