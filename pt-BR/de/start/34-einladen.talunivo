      "expression": "cinema",
      "translation": "Kino",
      "isVocabulary": true,
      "example": "Quer ir ao cinema comigo?",
      "exampleTranslation": "Möchtest du mit mir ins Kino gehen?",
      "explanation": "O cinema; ir ao cinema = ins Kino gehen."
    },
    {
      "id": "karte-03",
