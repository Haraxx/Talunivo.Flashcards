    {
      "id": "karte-01",
      "topic": "Einladen und Verabreden",
      "expression": "tomar caf\u00E9",
      "translation": "Kaffee trinken",
      "example": "Vamos tomar um caf\u00E9 no s\u00E1bado?",
      "exampleTranslation": "Wollen wir am Samstag einen Kaffee trinken?",
      "explanation": "Tomar caf\u00E9 hei\u00DFt Kaffee trinken. Vamos \u002B Infinitiv mit Fragezeichen ist hier ein gemeinsamer Vorschlag. Um caf\u00E9 bezeichnet einen Kaffee; no s\u00E1bado hei\u00DFt am Samstag. Ort und Uhrzeit sind noch offen.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Einladen und Verabreden",
      "expression": "cinema",
      "translation": "Kino",
      "example": "Quer ir ao cinema comigo?",
      "exampleTranslation": "M\u00F6chtest du mit mir ins Kino gehen?",
      "explanation": "O cinema, Plural cinemas, bedeutet Kino. Ir ao cinema hei\u00DFt ins Kino gehen; ao verbindet a \u002B o. Quer fragt hier nach dem Wunsch der angesprochenen Person, comigo bedeutet mit mir.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Einladen und Verabreden",
      "expression": "tempo",
      "translation": "Zeit",
      "example": "Voc\u00EA tem tempo amanh\u00E3?",
      "exampleTranslation": "Hast du morgen Zeit?",
      "explanation": "O tempo bedeutet hier verf\u00FCgbare Zeit. Ter tempo hei\u00DFt Zeit haben; tem geh\u00F6rt im Satz zu voc\u00EA. Amanh\u00E3 hei\u00DFt morgen. In der Wetterfrage Como est\u00E1 o tempo? hat dasselbe Wort eine andere Bedeutung.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Einladen und Verabreden",
      "expression": "passeio",
      "translation": "Ausflug",
      "example": "Que tal um passeio?",
      "exampleTranslation": "Wie w\u00E4re es mit einem Ausflug?",
      "explanation": "O passeio, Plural passeios, kann Ausflug oder Spaziergang bedeuten. Que tal \u2026? schl\u00E4gt etwas vor: Wie w\u00E4re es mit \u2026? Ohne Ziel oder Strecke legt der Satz die Art des Ausflugs nicht genauer fest.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Einladen und Verabreden",
      "expression": "boa ideia",
      "translation": "gute Idee",
      "example": "Boa ideia!",
      "exampleTranslation": "Gute Idee!",
      "explanation": "A ideia, Plural ideias, ist die Idee. Boa ist die weibliche Form von bom und passt zu ideia. Boa ideia! bewertet einen Vorschlag positiv; konkrete Uhrzeit und Ort sind damit noch nicht vereinbart. Ideia wird ohne Akut geschrieben.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Einladen und Verabreden",
      "expression": "poder",
      "translation": "k\u00F6nnen; d\u00FCrfen",
      "example": "Hoje n\u00E3o posso.",
      "exampleTranslation": "Heute kann ich nicht.",
      "explanation": "Poder hei\u00DFt k\u00F6nnen oder d\u00FCrfen; posso ist die Ich-Form. Hoje n\u00E3o posso lehnt hier wegen fehlender M\u00F6glichkeit f\u00FCr heute ab. Der Satz nennt keinen Grund; ein Verbot folgt daraus nicht automatisch.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Einladen und Verabreden",
      "expression": "s\u00E1bado",
      "translation": "Samstag",
      "example": "Pode ser no s\u00E1bado?",
      "exampleTranslation": "Geht es am Samstag?",
      "explanation": "O s\u00E1bado ist der Samstag; Wochentage schreibt man portugiesisch klein. No s\u00E1bado nennt hier einen bestimmten Samstag. Pode ser \u2026? fragt, ob ein Vorschlag passt; aos s\u00E1bados hei\u00DFt dagegen regelm\u00E4\u00DFig samstags.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Einladen und Verabreden",
      "expression": "combinado",
      "translation": "abgemacht",
      "example": "Combinado, at\u00E9 s\u00E1bado!",
      "exampleTranslation": "Abgemacht, bis Samstag!",
      "explanation": "Combinado! ist hier eine feste Best\u00E4tigung im Sinn von abgemacht oder vereinbart. At\u00E9 s\u00E1bado! hei\u00DFt bis Samstag. Die Best\u00E4tigung bezieht sich auf eine vorherige Absprache; der Satz selbst nennt keine Uhrzeit.",
      "isVocabulary": true
    }
  ],
