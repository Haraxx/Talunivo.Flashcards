      "expression": "tempo",
      "translation": "Zeit",
      "isVocabulary": true,
      "example": "Você tem tempo amanhã?",
      "exampleTranslation": "Hast du morgen Zeit?",
      "explanation": "O tempo bezeichnet hier verfügbare Zeit; auch Wetter möglich."
    },
