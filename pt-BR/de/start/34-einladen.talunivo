      "isVocabulary": true,
      "example": "Boa ideia, vamos!",
      "exampleTranslation": "Gute Idee, gehen wir!",
      "explanation": "Ideia wird ohne Akut geschrieben."
    },
    {
      "id": "karte-06",
      "topic": "Einladen und Verabreden",
      "expression": "poder",
      "translation": "können; dürfen",
      "isVocabulary": true,
      "example": "Hoje não posso.",
      "exampleTranslation": "Heute kann ich nicht.",
      "explanation": "Posso = ich kann oder darf; não posso = ich kann oder darf nicht."
