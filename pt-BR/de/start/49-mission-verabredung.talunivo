  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "livre",
      "translation": "frei",
      "isVocabulary": true,
      "example": "Você está livre amanhã?",
      "exampleTranslation": "Hast du morgen Zeit?",
      "explanation": "Livre bedeutet hier zeitlich frei."
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "de manhã",
      "translation": "vormittags",
      "isVocabulary": true,
      "example": "Sim, estou livre de manhã.",
      "exampleTranslation": "Ja, vormittags habe ich Zeit.",
      "explanation": "De manhã kann morgens oder vormittags heißen."
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "visitar",
      "translation": "besuchen",
      "isVocabulary": true,
      "example": "Vamos visitar o parque novo?",
      "exampleTranslation": "Wollen wir den neuen Park besuchen?",
      "explanation": "Visitar um parque = einen Park besuchen."
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "sair",
      "translation": "losgehen",
      "isVocabulary": true,
      "example": "Claro! A que horas vamos sair?",
      "exampleTranslation": "Klar! Um wie viel Uhr gehen wir los?",
      "explanation": "Hier losgehen; je nach Kontext auch weggehen oder ausgehen."
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "nove",
      "translation": "neun",
      "isVocabulary": true,
      "example": "Podemos sair às nove.",
      "exampleTranslation": "Wir können um neun losgehen.",
      "explanation": "Nove steht für 9; às nove = um neun Uhr."
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "encontrar-se",
      "translation": "sich treffen",
      "isVocabulary": true,
      "example": "Onde vamos nos encontrar?",
      "exampleTranslation": "Wo werden wir uns treffen?",
      "explanation": "Nos encontrar = uns treffen; die Grundform ist encontrar-se."
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "esquina",
      "translation": "Ecke",
      "isVocabulary": true,
      "example": "Na frente da padaria da esquina.",
      "exampleTranslation": "Vor der Bäckerei an der Ecke.",
      "explanation": "A esquina ist eine Straßenecke."
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "levar",
      "translation": "mitnehmen",
      "isVocabulary": true,
      "example": "Ótimo, vou levar água para nós.",
      "exampleTranslation": "Prima, ich werde Wasser für uns mitnehmen.",
      "explanation": "Levar água = Wasser mitnehmen."
    }
  ]
