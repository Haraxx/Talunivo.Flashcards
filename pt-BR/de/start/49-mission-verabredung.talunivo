  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "livre",
      "translation": "frei",
      "example": "Voc\u00EA est\u00E1 livre amanh\u00E3?",
      "exampleTranslation": "Hast du morgen Zeit?",
      "explanation": "Livre hei\u00DFt hier zeitlich frei oder verf\u00FCgbar. Die Form bleibt f\u00FCr m\u00E4nnlichen und weiblichen Bezug gleich; im Plural hei\u00DFt sie livres. Amanh\u00E3 fragt nach morgen, noch ohne eine genaue Uhrzeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "de manh\u00E3",
      "translation": "vormittags",
      "example": "Sim, estou livre amanh\u00E3 de manh\u00E3.",
      "exampleTranslation": "Ja, morgen Vormittag habe ich Zeit.",
      "explanation": "De manh\u00E3 bedeutet morgens oder vormittags. Amanh\u00E3 de manh\u00E3 hei\u00DFt morgen fr\u00FCh oder morgen am Vormittag; die Antwort greift den Tag der vorherigen Frage auf. Sim best\u00E4tigt die verf\u00FCgbare Zeit.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "visitar",
      "translation": "besuchen",
      "example": "Vamos visitar o parque novo?",
      "exampleTranslation": "Wollen wir den neuen Park besuchen?",
      "explanation": "Visitar hei\u00DFt besuchen. Vamos \u002B Infinitiv mit Frageintonation schl\u00E4gt hier eine gemeinsame Handlung vor. Novo passt zum m\u00E4nnlichen parque; der Park ist ein erfundener Gespr\u00E4chsbezug, kein benannter realer Ort.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "sair",
      "translation": "losgehen",
      "example": "A que horas vamos sair?",
      "exampleTranslation": "Um wie viel Uhr gehen wir los?",
      "explanation": "Sair bedeutet hier losgehen oder aufbrechen. A que horas \u2026? fragt nach einer Uhrzeit. Vamos sair bezieht sich auf die gemeinsame Handlung; weggehen oder ausgehen sind in anderen Situationen m\u00F6gliche Bedeutungen von sair.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "nove",
      "translation": "neun",
      "example": "Podemos sair \u00E0s nove.",
      "exampleTranslation": "Wir k\u00F6nnen um neun losgehen.",
      "explanation": "Nove ist die Zahl neun; \u00E0s nove bedeutet um neun Uhr. Podemos ist die Wir-Form von poder. Im Zusammenhang mit amanh\u00E3 de manh\u00E3 ist hier neun Uhr am Morgen gemeint; der einzelne Satz allein nennt keinen Tagesabschnitt.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "encontrar-se",
      "translation": "sich treffen",
      "example": "Onde vamos nos encontrar?",
      "exampleTranslation": "Wo werden wir uns treffen?",
      "explanation": "Encontrar-se hei\u00DFt hier sich treffen. Nos encontrar bedeutet im Satz uns treffen; nos bezieht sich auf wir. Onde fragt nach dem Ort. Encontrar ohne diesen gegenseitigen Bezug kann auch finden bedeuten, wie bei der Suche nach einem Gegenstand.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "esquina",
      "translation": "Ecke",
      "example": "Vamos nos encontrar na esquina da padaria.",
      "exampleTranslation": "Wir werden uns an der Ecke bei der B\u00E4ckerei treffen.",
      "explanation": "A esquina, Plural esquinas, ist eine Stra\u00DFenecke. Na verbindet em \u002B a, da verbindet de \u002B a. Na esquina da padaria nennt hier die Ecke bei der im Gespr\u00E4ch bekannten B\u00E4ckerei. Welche Ecke genau gemeint ist, muss aus der Situation klar sein.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "levar",
      "translation": "mitnehmen",
      "example": "Vou levar \u00E1gua para n\u00F3s.",
      "exampleTranslation": "Ich werde Wasser f\u00FCr uns mitnehmen.",
      "explanation": "Levar hei\u00DFt hier mitnehmen. Vou levar k\u00FCndigt meine Handlung an; para n\u00F3s bedeutet f\u00FCr uns und umfasst die sprechende Person. Der Satz nennt keine genaue Wassermenge.",
      "isVocabulary": true
    }
  ],
