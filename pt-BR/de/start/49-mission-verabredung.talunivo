{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-49-mission-verabredung",
  "packageVersion": 4,
  "title": "49 · Mini-Dialog: Einen Ausflug planen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "livre",
      "translation": "frei",
      "isVocabulary": true,
      "example": "Você está livre amanhã?",
      "exampleTranslation": "Hast du morgen Zeit?",
      "explanation": "Livre heißt hier zeitlich frei oder verfügbar. Die Form bleibt für männlichen und weiblichen Bezug gleich; im Plural heißt sie livres. Amanhã fragt nach morgen, noch ohne eine genaue Uhrzeit."
    },
    {
      "id": "karte-02",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "de manhã",
      "translation": "vormittags",
      "isVocabulary": true,
      "example": "Sim, estou livre amanhã de manhã.",
      "exampleTranslation": "Ja, morgen Vormittag habe ich Zeit.",
      "explanation": "De manhã bedeutet morgens oder vormittags. Amanhã de manhã heißt morgen früh oder morgen am Vormittag; die Antwort greift den Tag der vorherigen Frage auf. Sim bestätigt die verfügbare Zeit."
    },
    {
      "id": "karte-03",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "visitar",
      "translation": "besuchen",
      "isVocabulary": true,
      "example": "Vamos visitar o parque novo?",
      "exampleTranslation": "Wollen wir den neuen Park besuchen?",
      "explanation": "Visitar heißt besuchen. Vamos + Infinitiv mit Frageintonation schlägt hier eine gemeinsame Handlung vor. Novo passt zum männlichen parque; der Park ist ein erfundener Gesprächsbezug, kein benannter realer Ort."
    },
    {
      "id": "karte-04",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "sair",
      "translation": "losgehen",
      "isVocabulary": true,
      "example": "A que horas vamos sair?",
      "exampleTranslation": "Um wie viel Uhr gehen wir los?",
      "explanation": "Sair bedeutet hier losgehen oder aufbrechen. A que horas …? fragt nach einer Uhrzeit. Vamos sair bezieht sich auf die gemeinsame Handlung; weggehen oder ausgehen sind in anderen Situationen mögliche Bedeutungen von sair."
    },
    {
      "id": "karte-05",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "nove",
      "translation": "neun",
      "isVocabulary": true,
      "example": "Podemos sair às nove.",
      "exampleTranslation": "Wir können um neun losgehen.",
      "explanation": "Nove ist die Zahl neun; às nove bedeutet um neun Uhr. Podemos ist die Wir-Form von poder. Im Zusammenhang mit amanhã de manhã ist hier neun Uhr am Morgen gemeint; der einzelne Satz allein nennt keinen Tagesabschnitt."
    },
    {
      "id": "karte-06",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "encontrar-se",
      "translation": "sich treffen",
      "isVocabulary": true,
      "example": "Onde vamos nos encontrar?",
      "exampleTranslation": "Wo werden wir uns treffen?",
      "explanation": "Encontrar-se heißt hier sich treffen. Nos encontrar bedeutet im Satz uns treffen; nos bezieht sich auf wir. Onde fragt nach dem Ort. Encontrar ohne diesen gegenseitigen Bezug kann auch finden bedeuten, wie bei der Suche nach einem Gegenstand."
    },
    {
      "id": "karte-07",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "esquina",
      "translation": "Ecke",
      "isVocabulary": true,
      "example": "Vamos nos encontrar na esquina da padaria.",
      "exampleTranslation": "Wir werden uns an der Ecke bei der Bäckerei treffen.",
      "explanation": "A esquina, Plural esquinas, ist eine Straßenecke. Na verbindet em + a, da verbindet de + a. Na esquina da padaria nennt hier die Ecke bei der im Gespräch bekannten Bäckerei. Welche Ecke genau gemeint ist, muss aus der Situation klar sein."
    },
    {
      "id": "karte-08",
      "topic": "Mini-Dialog: Einen Ausflug planen",
      "expression": "levar",
      "translation": "mitnehmen",
      "isVocabulary": true,
      "example": "Vou levar água para nós.",
      "exampleTranslation": "Ich werde Wasser für uns mitnehmen.",
      "explanation": "Levar heißt hier mitnehmen. Vou levar kündigt meine Handlung an; para nós bedeutet für uns und umfasst die sprechende Person. Der Satz nennt keine genaue Wassermenge."
    }
  ]
}
