  "title": "25 \u00B7 Nach dem Weg fragen",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Nach dem Weg fragen",
      "expression": "centro",
      "translation": "Zentrum",
      "example": "Como chego ao centro?",
      "exampleTranslation": "Wie komme ich ins Zentrum?",
      "explanation": "O centro ist hier das Stadtzentrum. Como chego \u2026? bedeutet wie komme ich \u2026? Ao ist a \u002B o; ao centro nennt das Ziel ins beziehungsweise zum Zentrum.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Nach dem Weg fragen",
      "expression": "em frente",
      "translation": "geradeaus",
      "example": "Siga em frente.",
      "exampleTranslation": "Gehen Sie geradeaus.",
      "explanation": "Siga ist hier eine h\u00F6fliche Weganweisung. Em frente bedeutet in diesem Satz geradeaus. Das ist ein anderes Muster als em frente a einem Bezugspunkt, das eine Lage vor oder gegen\u00FCber etwas beschreibt.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Nach dem Weg fragen",
      "expression": "\u00E0 direita",
      "translation": "nach rechts",
      "example": "Vire \u00E0 direita.",
      "exampleTranslation": "Biegen Sie rechts ab.",
      "explanation": "Vire bedeutet hier biegen Sie ab. \u00C0 direita gibt in dieser Anweisung die Richtung nach rechts an; das \u00E0 geh\u00F6rt zur Wendung. Bei einer Lagebeschreibung kann \u00E0 direita rechts gelegen bedeuten.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Nach dem Weg fragen",
      "expression": "\u00E0 esquerda",
      "translation": "nach links",
      "example": "Vire \u00E0 esquerda.",
      "exampleTranslation": "Biegen Sie links ab.",
      "explanation": "\u00C0 esquerda bedeutet in dieser Weganweisung nach links. Vire hei\u00DFt hier biegen Sie ab. Vergleiche \u00E0 esquerda mit \u00E0 direita = nach rechts; die Perspektive ist die der Person, die dem Weg folgt.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Nach dem Weg fragen",
      "expression": "rua",
      "translation": "Stra\u00DFe",
      "example": "Atravesse a rua.",
      "exampleTranslation": "\u00DCberqueren Sie die Stra\u00DFe.",
      "explanation": "A rua, Plural ruas. Atravesse ist hier die Anweisung \u00FCberqueren Sie. Gemeint ist ein Wechsel auf die andere Stra\u00DFenseite, nicht das Weitergehen entlang der Stra\u00DFe.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Nach dem Weg fragen",
      "expression": "sem\u00E1foro",
      "translation": "Ampel",
      "example": "Vire \u00E0 direita depois do sem\u00E1foro.",
      "exampleTranslation": "Biegen Sie nach der Ampel rechts ab.",
      "explanation": "O sem\u00E1foro, Plural sem\u00E1foros, ist eine Ampel. Depois do bedeutet hier nach dem Passieren des Bezugspunkts; do ist de \u002B o. Die Anweisung verbindet die bekannte Rechtsabbiegung mit der Ampel.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Nach dem Weg fragen",
      "expression": "ao lado",
      "translation": "daneben",
      "example": "Fica ao lado do banco.",
      "exampleTranslation": "Es liegt neben der Bank.",
      "explanation": "Ao lado bedeutet daneben. Mit einem genannten Bezugspunkt verwendet man ao lado de: ao lado do banco = neben der Bank. Do ist de \u002B o. Die Angabe allein legt nicht fest, ob links oder rechts daneben gemeint ist.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Nach dem Weg fragen",
      "expression": "mapa",
      "translation": "Karte; Stadtplan",
      "example": "Pode me mostrar no mapa?",
      "exampleTranslation": "K\u00F6nnen Sie es mir auf der Karte zeigen?",
      "explanation": "O mapa, Plural mapas, ist trotz -a m\u00E4nnlich und bezeichnet hier eine geografische Karte oder einen Stadtplan. No mapa ist em \u002B o mapa: auf der Karte. Mostrar bedeutet zeigen; gemeint ist keine Zahlungs- oder Speisekarte.",
      "isVocabulary": true
    }
  ],
