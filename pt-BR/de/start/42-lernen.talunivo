      "id": "karte-08",
      "topic": "Lernen und Üben",
      "expression": "entender",
      "translation": "verstehen",
      "isVocabulary": true,
      "example": "Agora eu entendi.",
      "exampleTranslation": "Jetzt habe ich es verstanden.",
      "explanation": "Entendi = ich habe verstanden; entende = du verstehst bei você."
