{
  "format": "talunivo",
  "schemaVersion": 2,
  "packageId": "start-ptbr-42-lernen",
  "packageVersion": 4,
  "title": "42 · Lernen und Üben",
  "sourceLanguage": "pt-BR",
  "translationLanguage": "de",
  "cards": [
    {
      "id": "karte-01",
      "topic": "Lernen und Üben",
      "expression": "estudar",
      "translation": "lernen; studieren",
      "isVocabulary": true,
      "example": "Estudo português todos os dias.",
      "exampleTranslation": "Ich lerne jeden Tag Portugiesisch.",
      "explanation": "Estudar heißt gezielt lernen oder studieren, auch in der Schule und außerhalb einer Hochschule. Estudo ist die Ich-Form im Präsens. Todos os dias bedeutet jeden Tag."
    },
    {
      "id": "karte-02",
      "topic": "Lernen und Üben",
      "expression": "pergunta",
      "translation": "Frage",
      "isVocabulary": true,
      "example": "Tenho uma pergunta.",
      "exampleTranslation": "Ich habe eine Frage.",
      "explanation": "A pergunta, Plural perguntas, heißt Frage. Tenho ist die Ich-Form von ter, haben. Tenho uma pergunta kündigt an, dass eine Frage folgt; es ist noch nicht die eigentliche Frage."
    },
    {
      "id": "karte-03",
      "topic": "Lernen und Üben",
      "expression": "exemplo",
      "translation": "Beispiel",
      "isVocabulary": true,
      "example": "Pode dar um exemplo, por favor?",
      "exampleTranslation": "Kannst du bitte ein Beispiel geben?",
      "explanation": "O exemplo, Plural exemplos, ist das Beispiel. Dar um exemplo bedeutet ein Beispiel geben. Pode dar …? bittet hier um eine Handlung; por favor macht die Bitte ausdrücklich."
    },
    {
      "id": "karte-04",
      "topic": "Lernen und Üben",
      "expression": "palavra",
      "translation": "Wort",
      "isVocabulary": true,
      "example": "Esta palavra é nova para mim.",
      "exampleTranslation": "Dieses Wort ist neu für mich.",
      "explanation": "A palavra, Plural palavras, bedeutet Wort. Esta und nova passen zur weiblichen Form palavra. Para mim heißt für mich: Die Aussage betrifft den eigenen Kenntnisstand, nicht das Alter des Wortes."
    },
    {
      "id": "karte-05",
      "topic": "Lernen und Üben",
      "expression": "pronunciar",
      "translation": "aussprechen",
      "isVocabulary": true,
      "example": "Como se pronuncia esta palavra?",
      "exampleTranslation": "Wie spricht man dieses Wort aus?",
      "explanation": "Pronunciar heißt aussprechen. Como se pronuncia …? ist hier das Muster Wie spricht man … aus? Esta palavra bezeichnet dieses Wort. Die Frage nennt noch keine konkrete Aussprache oder Bewertung."
    },
    {
      "id": "karte-06",
      "topic": "Lernen und Üben",
      "expression": "praticar",
      "translation": "üben",
      "isVocabulary": true,
      "example": "Preciso praticar mais.",
      "exampleTranslation": "Ich muss mehr üben.",
      "explanation": "Praticar heißt hier üben. Nach preciso steht der Infinitiv ohne de; mais bedeutet in diesem Satz mehr. Praticar beschreibt das aktive Üben, während estudar gezieltes Lernen oder Studieren bezeichnet; beide Tätigkeiten können sich überschneiden."
    },
    {
      "id": "karte-07",
      "topic": "Lernen und Üben",
      "expression": "de novo",
      "translation": "noch einmal",
      "isVocabulary": true,
      "example": "Vou tentar de novo.",
      "exampleTranslation": "Ich werde es noch einmal versuchen.",
      "explanation": "De novo ist die feste Wendung noch einmal oder erneut. Vou tentar kündigt einen Versuch an; tentar heißt versuchen. Das deutsche es ergibt sich aus dem Gespräch und braucht hier im Portugiesischen kein eigenes Objektwort."
    },
    {
      "id": "karte-08",
      "topic": "Lernen und Üben",
      "expression": "entender",
      "translation": "verstehen",
      "isVocabulary": true,
      "example": "Agora eu entendi.",
      "exampleTranslation": "Jetzt habe ich es verstanden.",
      "explanation": "Entender heißt verstehen; entendi ist die Ich-Form in der abgeschlossenen Vergangenheit. Agora bedeutet jetzt. Eu ist das ausdrücklich genannte Subjekt ich; daraus allein folgt keine besondere Betonung. Im Gegensatz zu não entendi bestätigt der Satz das Verständnis."
    }
  ]
}
