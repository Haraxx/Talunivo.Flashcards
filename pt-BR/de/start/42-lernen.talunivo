  "cards": [
    {
      "id": "karte-01",
      "topic": "Lernen und \u00DCben",
      "expression": "estudar",
      "translation": "lernen; studieren",
      "example": "Estudo portugu\u00EAs todos os dias.",
      "exampleTranslation": "Ich lerne jeden Tag Portugiesisch.",
      "explanation": "Estudar hei\u00DFt gezielt lernen oder studieren, auch in der Schule und au\u00DFerhalb einer Hochschule. Estudo ist die Ich-Form im Pr\u00E4sens. Todos os dias bedeutet jeden Tag.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Lernen und \u00DCben",
      "expression": "pergunta",
      "translation": "Frage",
      "example": "Tenho uma pergunta.",
      "exampleTranslation": "Ich habe eine Frage.",
      "explanation": "A pergunta, Plural perguntas, hei\u00DFt Frage. Tenho ist die Ich-Form von ter, haben. Tenho uma pergunta k\u00FCndigt an, dass eine Frage folgt; es ist noch nicht die eigentliche Frage.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Lernen und \u00DCben",
      "expression": "exemplo",
      "translation": "Beispiel",
      "example": "Pode dar um exemplo, por favor?",
      "exampleTranslation": "Kannst du bitte ein Beispiel geben?",
      "explanation": "O exemplo, Plural exemplos, ist das Beispiel. Dar um exemplo bedeutet ein Beispiel geben. Pode dar \u2026? bittet hier um eine Handlung; por favor macht die Bitte ausdr\u00FCcklich.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Lernen und \u00DCben",
      "expression": "palavra",
      "translation": "Wort",
      "example": "Esta palavra \u00E9 nova para mim.",
      "exampleTranslation": "Dieses Wort ist neu f\u00FCr mich.",
      "explanation": "A palavra, Plural palavras, bedeutet Wort. Esta und nova passen zur weiblichen Form palavra. Para mim hei\u00DFt f\u00FCr mich: Die Aussage betrifft den eigenen Kenntnisstand, nicht das Alter des Wortes.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Lernen und \u00DCben",
      "expression": "pronunciar",
      "translation": "aussprechen",
      "example": "Como se pronuncia esta palavra?",
      "exampleTranslation": "Wie spricht man dieses Wort aus?",
      "explanation": "Pronunciar hei\u00DFt aussprechen. Como se pronuncia \u2026? ist hier das Muster Wie spricht man \u2026 aus? Esta palavra bezeichnet dieses Wort. Die Frage nennt noch keine konkrete Aussprache oder Bewertung.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Lernen und \u00DCben",
      "expression": "praticar",
      "translation": "\u00FCben",
      "example": "Preciso praticar mais.",
      "exampleTranslation": "Ich muss mehr \u00FCben.",
      "explanation": "Praticar hei\u00DFt hier \u00FCben. Nach preciso steht der Infinitiv ohne de; mais bedeutet in diesem Satz mehr. Praticar beschreibt das aktive \u00DCben, w\u00E4hrend estudar gezieltes Lernen oder Studieren bezeichnet; beide T\u00E4tigkeiten k\u00F6nnen sich \u00FCberschneiden.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Lernen und \u00DCben",
      "expression": "de novo",
      "translation": "noch einmal",
      "example": "Vou tentar de novo.",
      "exampleTranslation": "Ich werde es noch einmal versuchen.",
      "explanation": "De novo ist die feste Wendung noch einmal oder erneut. Vou tentar k\u00FCndigt einen Versuch an; tentar hei\u00DFt versuchen. Das deutsche es ergibt sich aus dem Gespr\u00E4ch und braucht hier im Portugiesischen kein eigenes Objektwort.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Lernen und \u00DCben",
      "expression": "entender",
      "translation": "verstehen",
      "example": "Agora eu entendi.",
      "exampleTranslation": "Jetzt habe ich es verstanden.",
      "explanation": "Entender hei\u00DFt verstehen; entendi ist die Ich-Form in der abgeschlossenen Vergangenheit. Agora bedeutet jetzt. Eu ist das ausdr\u00FCcklich genannte Subjekt ich; daraus allein folgt keine besondere Betonung. Im Gegensatz zu n\u00E3o entendi best\u00E4tigt der Satz das Verst\u00E4ndnis.",
      "isVocabulary": true
    }
  ],
