      "translation": "lernen (Studium)",
      "isVocabulary": true,
      "example": "Estudo português todos os dias.",
      "exampleTranslation": "Ich lerne jeden Tag Portugiesisch.",
      "explanation": "Estudar bezeichnet gezieltes Lernen oder Studieren, auch außerhalb einer Hochschule."
    },
    {
      "id": "karte-02",
      "topic": "Lernen und Üben",
      "expression": "pergunta",
      "translation": "Frage",
      "isVocabulary": true,
      "example": "Tenho uma pergunta.",
      "exampleTranslation": "Ich habe eine Frage.",
      "explanation": "A pergunta; ter uma pergunta = eine Frage haben."
    },
    {
      "id": "karte-03",
      "topic": "Lernen und Üben",
      "expression": "exemplo",
      "translation": "Beispiel",
      "isVocabulary": true,
      "example": "Pode dar um exemplo?",
      "exampleTranslation": "Kannst du ein Beispiel geben?",
      "explanation": "O exemplo; dar um exemplo = ein Beispiel geben."
    },
    {
      "id": "karte-04",
      "topic": "Lernen und Üben",
      "expression": "palavra",
      "translation": "Wort",
      "isVocabulary": true,
      "example": "Esta palavra é nova para mim.",
      "exampleTranslation": "Dieses Wort ist neu für mich.",
      "explanation": "A palavra; Plural palavras."
    },
    {
      "id": "karte-05",
      "topic": "Lernen und Üben",
      "expression": "pronunciar",
      "translation": "aussprechen",
      "isVocabulary": true,
      "example": "Como se pronuncia esta palavra?",
      "exampleTranslation": "Wie spricht man dieses Wort aus?",
      "explanation": "Como se pronuncia …? = Wie spricht man … aus?"
    },
    {
      "id": "karte-06",
      "topic": "Lernen und Üben",
      "expression": "praticar",
      "translation": "üben",
      "isVocabulary": true,
      "example": "Preciso praticar mais.",
      "exampleTranslation": "Ich muss mehr üben.",
      "explanation": "Praticar bedeutet üben; mais bedeutet hier mehr."
    },
    {
      "id": "karte-07",
      "topic": "Lernen und Üben",
      "expression": "de novo",
      "translation": "noch einmal",
      "isVocabulary": true,
      "example": "Vou tentar de novo.",
      "exampleTranslation": "Ich werde es noch einmal versuchen.",
      "explanation": "Feste Wendung für noch einmal oder erneut."
