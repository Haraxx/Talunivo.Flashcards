  "cards": [
    {
      "id": "karte-01",
      "topic": "Im Supermarkt",
      "expression": "supermercado",
      "translation": "Supermarkt",
      "example": "Onde fica o supermercado?",
      "exampleTranslation": "Wo ist der Supermarkt?",
      "explanation": "O supermercado, Plural supermercados. Onde fica \u2026? fragt nach dem Ort und greift das bekannte Muster f\u00FCr R\u00E4ume auf. Es wird hier der Supermarkt gesucht, nicht schon ein einzelnes Produkt.",
      "isVocabulary": true
    },
    {
      "id": "karte-02",
      "topic": "Im Supermarkt",
      "expression": "litro",
      "translation": "Liter",
      "example": "Preciso de um litro de leite.",
      "exampleTranslation": "Ich brauche einen Liter Milch.",
      "explanation": "O litro, Plural litros. Um litro de leite bedeutet ein Liter Milch; de verbindet die Menge mit dem Lebensmittel. Preciso de \u2026 hei\u00DFt ich brauche \u2026 Die Menge im Beispiel ist ein Liter.",
      "isVocabulary": true
    },
    {
      "id": "karte-03",
      "topic": "Im Supermarkt",
      "expression": "meio quilo",
      "translation": "halbes Kilo",
      "example": "Quero meio quilo de arroz.",
      "exampleTranslation": "Ich m\u00F6chte ein halbes Kilo Reis.",
      "explanation": "O quilo ist m\u00E4nnlich, deshalb meio quilo: ein halbes Kilo, also 500 Gramm. Meio richtet sich nach quilo, nicht nach arroz. Bei der Uhrzeit e meia aus Paket 09 ist dagegen die weibliche hora der Bezug.",
      "isVocabulary": true
    },
    {
      "id": "karte-04",
      "topic": "Im Supermarkt",
      "expression": "ma\u00E7\u00E3s",
      "translation": "\u00C4pfel",
      "example": "As ma\u00E7\u00E3s est\u00E3o frescas?",
      "exampleTranslation": "Sind die \u00C4pfel frisch?",
      "explanation": "A ma\u00E7\u00E3 ist ein Apfel; ma\u00E7\u00E3s ist die Mehrzahl \u00C4pfel. As, est\u00E3o und frescas stehen hier passend zur weiblichen Mehrzahl. Die Frage betrifft die Frische, nicht den Preis oder die Anzahl der \u00C4pfel.",
      "isVocabulary": true
    },
    {
      "id": "karte-05",
      "topic": "Im Supermarkt",
      "expression": "pacote",
      "translation": "Packung",
      "example": "Quanto custa este pacote?",
      "exampleTranslation": "Wie viel kostet diese Packung?",
      "explanation": "O pacote, Plural pacotes. Quanto custa \u2026? fragt nach einem Preis. Este richtet sich nach dem m\u00E4nnlichen portugiesischen pacote. Der Satz bezieht sich auf die gezeigte Packung; ihr Inhalt oder Gewicht wird nicht genannt.",
      "isVocabulary": true
    },
    {
      "id": "karte-06",
      "topic": "Im Supermarkt",
      "expression": "sacola",
      "translation": "T\u00FCte",
      "example": "Tem uma sacola?",
      "exampleTranslation": "Gibt es eine T\u00FCte?",
      "explanation": "A sacola, Plural sacolas, bezeichnet hier eine Einkaufst\u00FCte. Tem uma sacola? fragt nach einer T\u00FCte. Anders als bolsa aus Paket 14 steht sacola hier ausdr\u00FCcklich im Einkaufskontext.",
      "isVocabulary": true
    },
    {
      "id": "karte-07",
      "topic": "Im Supermarkt",
      "expression": "precisar",
      "translation": "brauchen",
      "example": "N\u00E3o preciso de sacola.",
      "exampleTranslation": "Ich brauche keine T\u00FCte.",
      "explanation": "Precisar bedeutet brauchen. Vor einem Nomen steht hier de: preciso de sacola. N\u00E3o verneint die Aussage. Vor einer Handlung lautet ein anderes Muster preciso comprar leite = ich muss Milch kaufen, ohne de vor comprar.",
      "isVocabulary": true
    },
    {
      "id": "karte-08",
      "topic": "Im Supermarkt",
      "expression": "caixa",
      "translation": "Kasse",
      "example": "Onde fica o caixa?",
      "exampleTranslation": "Wo ist die Kasse?",
      "explanation": "O caixa bezeichnet hier die Kasse beziehungsweise den Kassenbereich. Trotz des deutschen Artikels die steht im Beispiel o. A caixa kann eine Schachtel oder eine Kassiererin bezeichnen; Artikel und Situation helfen, die Bedeutung zu erkennen.",
      "isVocabulary": true
    }
  ],
